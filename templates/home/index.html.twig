{% extends 'base.html.twig' %}

{% block title %}Dashboard | Rebus Game Show{% endblock %}

{% block stylesheets %}
<style>
    .hero-banner {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.15), rgba(245, 158, 11, 0.05));
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .hero-content h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #fff, #f59e0b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-content p {
        color: var(--text-sub);
        font-size: 1.1rem;
        max-width: 650px;
        line-height: 1.5;
    }

    .stats-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .stat-icon {
        font-size: 2.5rem;
        background: rgba(249, 115, 22, 0.1);
        padding: 0.75rem;
        border-radius: 12px;
        line-height: 1;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
    }

    .stat-label {
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .shows-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .show-card {
        background: var(--bg-card);
        border: 1.5px solid var(--border-color);
        border-radius: 18px;
        padding: 1.4rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.75rem;
        transition: all 0.22s ease;
        position: relative;
    }

    .show-card:hover {
        border-color: var(--primary);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    }

    .show-card-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .show-card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .show-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
    }

    .show-subtitle {
        color: var(--accent);
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }

    .show-meta-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .meta-tag {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.84rem;
        color: var(--text-sub);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .show-card-controls {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.65rem;
        flex-shrink: 0;
    }

    .show-primary-actions {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .show-utility-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-util-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.38rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.18s ease;
        border: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-sub);
    }

    .btn-util-pill:hover {
        transform: translateY(-1px);
    }

    .btn-util-pill.edit {
        color: #60a5fa;
        border-color: rgba(96, 165, 250, 0.35);
        background: rgba(96, 165, 250, 0.1);
    }
    .btn-util-pill.edit:hover {
        background: rgba(96, 165, 250, 0.22);
        border-color: #60a5fa;
    }

    .btn-util-pill.reset-show {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.35);
        background: rgba(245, 158, 11, 0.1);
    }
    .btn-util-pill.reset-show:hover {
        background: rgba(245, 158, 11, 0.22);
        border-color: #f59e0b;
    }

    .btn-util-pill.reset-q {
        color: #c084fc;
        border-color: rgba(168, 85, 247, 0.35);
        background: rgba(168, 85, 247, 0.1);
    }
    .btn-util-pill.reset-q:hover {
        background: rgba(168, 85, 247, 0.22);
        border-color: #c084fc;
    }

    .btn-util-pill.delete {
        color: #ef4444;
        border-color: rgba(239, 68, 68, 0.3);
        background: rgba(239, 68, 68, 0.1);
    }
    .btn-util-pill.delete:hover {
        background: rgba(239, 68, 68, 0.22);
        border-color: #ef4444;
    }

    @media (max-width: 960px) {
        .show-card {
            flex-direction: column;
            align-items: stretch;
            gap: 1.25rem;
        }
        .show-card-controls {
            align-items: stretch;
        }
        .show-primary-actions,
        .show-utility-actions {
            justify-content: flex-start;
        }
    }

    /* Modal Styling */
    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        color: var(--text-sub);
    }

    .form-input {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #fff;
        font-size: 1rem;
    }

    .form-input:focus {
        outline: none;
        border-color: var(--primary);
    }
</style>
{% endblock %}

{% block body %}
<div class="hero-banner">
    <div class="hero-content">
        <h1>Fall Party Rebus Arena</h1>
        <p>Host visual rebus game shows with live timers, non-repeating questions, and elimination rounds for up to 12 teams!</p>
    </div>
    <button type="button" class="btn btn-primary btn-lg" onclick="document.getElementById('new-show-modal').showModal()">
        ✨ Create New Game Show
    </button>
</div>

<div class="stats-strip">
    <div class="stat-card">
        <div class="stat-icon">🧩</div>
        <div>
            <div class="stat-value">{{ stats.total_questions }}</div>
            <div class="stat-label">Multimodal Puzzles in Bank</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📁</div>
        <div>
            <div class="stat-value">{{ stats.total_categories }}</div>
            <div class="stat-label">Configured Categories</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">⭐</div>
        <div>
            <div class="stat-value">{{ stats.total_favorites }}</div>
            <div class="stat-label">Starred / Curated Favorites</div>
        </div>
    </div>
</div>

<div class="section-header">
    <h2 class="section-title"><span>🎬</span> Your Game Shows</h2>
</div>

<div class="shows-grid">
    {% for show in shows %}
        <div class="show-card">
            <div class="show-card-main">
                <div>
                    <div class="show-card-header">
                        <h3 class="show-title">{{ show.name }}</h3>
                        {% if show.starred_only|default(0) %}
                            <span class="meta-tag" style="border-color: rgba(251, 191, 36, 0.45); color: #fbbf24; background: rgba(251, 191, 36, 0.12); padding: 0.2rem 0.65rem; font-size: 0.78rem;">⭐ <strong>Starred Only</strong></span>
                        {% else %}
                            <span class="meta-tag" style="padding: 0.2rem 0.65rem; font-size: 0.78rem;">👍 <strong>All Included</strong></span>
                        {% endif %}
                    </div>
                    {% if show.subtitle %}
                        <p class="show-subtitle" style="margin-top: 0.25rem;">{{ show.subtitle }}</p>
                    {% endif %}
                </div>

                <div class="show-meta-strip">
                    <span class="meta-tag">👥 <strong>{{ show.team_count }}</strong> Teams</span>
                    <span class="meta-tag">🔄 <strong>{{ show.round_count }}</strong> Rounds</span>
                    <span class="meta-tag">⏱️ <strong>{{ show.default_timer_seconds }}s</strong> Timer</span>
                    <span class="meta-tag">🚫 <strong>{{ show.used_q_count }}</strong> Asked (No repeats)</span>
                </div>
            </div>

            <div class="show-card-controls">
                <div class="show-primary-actions">
                    <a href="{{ path('app_show_play', {'id': show.id}) }}" class="btn btn-primary">
                        🚀 Launch Arena
                    </a>
                    <a href="{{ path('app_show_display', {'id': show.id}) }}" target="_blank" class="btn btn-secondary">
                        📺 TV View
                    </a>
                    <a href="{{ path('app_show_manage', {'id': show.id}) }}" class="btn btn-secondary">
                        ⚙️ Teams &amp; Rounds
                    </a>
                    <button type="button" class="btn btn-secondary" onclick="openHomeHostQrModal({{ show.id }}, '{{ show.name|e('js') }}', '{{ show.mobile_host_url|e('js') }}')" title="Show Host Remote QR Code for iPhone" style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-weight: 700;">
                        📱 iPhone QR
                    </button>
                </div>

                <div class="show-utility-actions">
                    <button type="button" class="btn-util-pill edit" onclick="openEditShowModal({{ show|json_encode }})" title="Edit Game Show Name &amp; Settings" aria-label="Edit Game Show">
                        ✏️ Edit Settings
                    </button>
                    <form method="POST" action="{{ path('app_show_reset', {'id': show.id}) }}" onsubmit="return confirm('Reset Game Show &quot;{{ show.name|e('js') }}&quot;? This resets team scores to 0 and restarts the show state from the Splash Screen / Round 1 (keeping your selected round questions &amp; order intact).');" style="margin: 0;">
                        <button type="submit" class="btn-util-pill reset-show" title="Reset Game Show (Reset scores &amp; show state — keeps round questions)" aria-label="Reset Game Show">
                            🔄 Reset Game Show
                        </button>
                    </form>
                    <form method="POST" action="{{ path('app_show_reset_questions', {'id': show.id}) }}" onsubmit="return confirm('Reset Questions for &quot;{{ show.name|e('js') }}&quot;? This chooses a new random set of questions across all rounds without resetting round settings or team scores.');" style="margin: 0;">
                        <button type="submit" class="btn-util-pill reset-q" title="Reset Questions (Choose new random questions without resetting round settings or scores)" aria-label="Reset Questions">
                            🎲 Reset Questions
                        </button>
                    </form>
                    <form method="POST" action="{{ path('app_show_delete', {'id': show.id}) }}" onsubmit="return confirm('Permanently delete &quot;{{ show.name|e('js') }}&quot; and all its rounds/teams?');" style="margin: 0;">
                        <button type="submit" class="btn-util-pill delete" title="Delete Game Show" aria-label="Delete Game Show">
                            🗑️ Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    {% else %}
        <div class="show-card" style="justify-content: center; text-align: center; padding: 4rem;">
            <div>
                <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: 1.5rem;">No game shows created yet.</p>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('new-show-modal').showModal()">
                    Create Your First Game Show
                </button>
            </div>
        </div>
    {% endfor %}
</div>

<!-- Modern Dialog: Create Show Modal -->
<dialog id="new-show-modal" aria-labelledby="modal-title">
    <h2 id="modal-title" style="margin-bottom: 1.5rem; font-size: 1.5rem; font-weight: 800;">Create A New Game Show</h2>
    <form method="POST" action="{{ path('app_show_create') }}">
        <div class="form-group">
            <label class="form-label" for="show-name">Game Show Name</label>
            <input type="text" id="show-name" name="name" class="form-input" placeholder="e.g. Fall Party Rebus Night 2026" required autofocus>
        </div>
        <div class="form-group">
            <label class="form-label" for="show-subtitle">Subtitle / Theme</label>
            <input type="text" id="show-subtitle" name="subtitle" class="form-input" placeholder="e.g. 10 Couples • Fall Party Championship">
        </div>
        <div class="form-group">
            <label class="form-label" for="show-timer">Default Question Timer (seconds)</label>
            <input type="number" id="show-timer" name="default_timer" class="form-input" value="25" min="10" max="120">
        </div>
        <div class="form-group">
            <label style="display: flex; align-items: flex-start; gap: 0.65rem; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.35); padding: 0.85rem 1rem; border-radius: 10px; cursor: pointer;">
                <input type="checkbox" name="starred_only" value="1" style="width: 18px; height: 18px; margin-top: 2px; accent-color: #fbbf24; cursor: pointer;">
                <div>
                    <div style="font-weight: 800; color: #fbbf24; font-size: 0.95rem;">⭐ Select Only Starred Puzzles</div>
                    <div style="font-size: 0.8rem; color: var(--text-sub); margin-top: 0.2rem;">If checked, this game show will only draw from Starred ({{ stats.total_favorites }}) puzzles. If unchecked, it will draw from all Included puzzles.</div>
                </div>
            </label>
        </div>
        <div class="form-group">
            <label style="display: flex; align-items: flex-start; gap: 0.65rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.35); padding: 0.85rem 1rem; border-radius: 10px; cursor: pointer;">
                <input type="checkbox" name="include_rapid_fire" value="1" style="width: 18px; height: 18px; margin-top: 2px; accent-color: #38bdf8; cursor: pointer;">
                <div>
                    <div style="font-weight: 800; color: #38bdf8; font-size: 0.95rem;">⚡ Add Rapid Fire Round (All Remaining Starred Puzzles)</div>
                    <div style="font-size: 0.8rem; color: var(--text-sub); margin-top: 0.2rem;">Automatically adds a Rapid Fire round containing all Starred &amp; Included puzzles not yet taken into other rounds, randomized (order &amp; selection locked).</div>
                </div>
            </label>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('new-show-modal').close()">Cancel</button>
            <button type="submit" class="btn btn-primary">Create Show & Setup Rounds</button>
        </div>
    </form>
</dialog>

<!-- Modern Dialog: Edit Show Modal -->
<dialog id="edit-show-modal" aria-labelledby="edit-modal-title" style="max-width: 550px;">
    <h2 id="edit-modal-title" style="margin-bottom: 1.5rem; font-size: 1.5rem; font-weight: 800;">Edit Game Show Details</h2>
    <form id="edit-show-form" method="POST" action="">
        <div class="form-group">
            <label class="form-label" for="edit-show-name">Game Show Name</label>
            <input type="text" id="edit-show-name" name="name" class="form-input" required autofocus>
        </div>
        <div class="form-group">
            <label class="form-label" for="edit-show-subtitle">Subtitle / Theme</label>
            <input type="text" id="edit-show-subtitle" name="subtitle" class="form-input" placeholder="e.g. 10 Couples • Fall Party Championship">
        </div>
        <div class="form-group">
            <label class="form-label" for="edit-show-timer">Default Question Timer (seconds)</label>
            <input type="number" id="edit-show-timer" name="default_timer_seconds" class="form-input" value="25" min="5" max="300" required>
        </div>
        <div class="form-group">
            <label style="display: flex; align-items: flex-start; gap: 0.65rem; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.35); padding: 0.85rem 1rem; border-radius: 10px; cursor: pointer;">
                <input type="checkbox" id="edit-show-starred-only" name="starred_only" value="1" style="width: 18px; height: 18px; margin-top: 2px; accent-color: #fbbf24; cursor: pointer;">
                <div>
                    <div style="font-weight: 800; color: #fbbf24; font-size: 0.95rem;">⭐ Select Only Starred Puzzles</div>
                    <div style="font-size: 0.8rem; color: var(--text-sub); margin-top: 0.2rem;">If checked, this game show will only draw from Starred ({{ stats.total_favorites }}) puzzles. If unchecked, it will draw from all Included puzzles.</div>
                </div>
            </label>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-show-modal').close()">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</dialog>

<!-- Modal: Host Arena Mobile QR Code for Home Dashboard -->
<dialog id="home-host-qr-modal" aria-labelledby="home-host-qr-title" style="max-width: 480px; text-align: center; border-color: rgba(56, 189, 248, 0.4);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 id="home-host-qr-title" style="margin: 0; font-size: 1.35rem; font-weight: 800; color: #38bdf8;">📱 Host on iPhone / Mobile</h2>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('home-host-qr-modal').close()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0;">✕</button>
    </div>
    <div id="home-qr-showname" style="font-weight: 700; color: #f1f5f9; font-size: 1.05rem; margin-bottom: 0.5rem;"></div>
    <p style="color: var(--text-sub); font-size: 0.92rem; margin-bottom: 1.25rem;">
        Scan this QR code with your iPhone Camera to wirelessly control this game show (advance questions, reveal answers, start timer, and score teams).
    </p>

    <div style="background: #ffffff; padding: 1.25rem; border-radius: 16px; display: inline-flex; justify-content: center; align-items: center; box-shadow: 0 10px 25px rgba(0,0,0,0.5); margin-bottom: 1.25rem;">
        <div id="home-qrcode"></div>
    </div>

    <div style="margin-bottom: 1rem; word-break: break-all;">
        <a id="home-qr-link" href="#" target="_blank" style="color: #38bdf8; font-weight: 600; font-size: 0.9rem; text-decoration: underline;">
            URL
        </a>
    </div>

    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1.5rem; line-height: 1.5;">
        📶 <strong>Local Wi-Fi:</strong> Phone must be connected to the same Wi-Fi network as this computer (Host IP: <code style="color: #fff; background: rgba(255,255,255,0.1); padding: 0.15rem 0.4rem; border-radius: 4px;">{{ lan_ip }}</code>).
    </p>

    <button type="button" class="btn btn-secondary" onclick="document.getElementById('home-host-qr-modal').close()" style="width: 100%;">Close</button>
</dialog>
{% endblock %}

{% block javascripts %}
<script src="/js/qrcode.min.js"></script>
<script>
    let homeQrInstance = null;

    function openEditShowModal(show) {
        const form = document.getElementById('edit-show-form');
        form.action = `/shows/${show.id}/update`;
        document.getElementById('edit-show-name').value = show.name || '';
        document.getElementById('edit-show-subtitle').value = show.subtitle || '';
        document.getElementById('edit-show-timer').value = show.default_timer_seconds || 25;
        const starredCb = document.getElementById('edit-show-starred-only');
        if (starredCb) {
            starredCb.checked = (parseInt(show.starred_only || 0, 10) === 1);
        }
        document.getElementById('edit-show-modal').showModal();
    }

    function openHomeHostQrModal(showId, showName, hostUrl) {
        document.getElementById('home-qr-showname').innerText = showName;
        const link = document.getElementById('home-qr-link');
        link.href = hostUrl;
        link.innerText = hostUrl;

        const qrContainer = document.getElementById('home-qrcode');
        qrContainer.innerHTML = '';
        new QRCode(qrContainer, {
            text: hostUrl,
            width: 200,
            height: 200,
            colorDark: '#0b0f19',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
        });

        document.getElementById('home-host-qr-modal').showModal();
    }
</script>
{% endblock %}

