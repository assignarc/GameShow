{% extends 'base.html.twig' %}

{% block title %}Master Common Rules | Rebus Game Show{% endblock %}

{% block stylesheets %}
<style>
    .rules-header {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .rules-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .rule-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
        transition: all 0.2s ease;
    }

    .rule-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .rule-left {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .rule-icon-box {
        font-size: 2.5rem;
        width: 64px;
        height: 64px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .rule-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.35rem;
    }

    .rule-desc {
        color: var(--text-sub);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .rule-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-shrink: 0;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }
    .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-sub);
        margin-bottom: 0.4rem;
    }
    .form-input, .form-textarea {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        color: #fff;
        font-family: inherit;
    }
</style>
{% endblock %}

{% block body %}
<div class="rules-header">
    <div>
        <h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 0.4rem 0;">📜 Master Common Rules Template</h1>
        <p style="color: var(--text-muted); margin: 0; max-width: 700px;">
            These base rules define the tournament format and conduct. When a new Game Show is created, it automatically inherits this template, and can then be modified independently per show.
        </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center;">
        <button type="button" class="btn btn-primary" onclick="openAddRuleModal()">
            + Add Common Rule
        </button>
    </div>
</div>

<div class="rules-grid">
    {% for r in rules %}
        <div class="rule-card">
            <div class="rule-left">
                <div class="rule-icon-box">{{ r.icon }}</div>
                <div>
                    <div style="font-size: 0.8rem; font-weight: 800; color: var(--accent); text-transform: uppercase; margin-bottom: 0.2rem;">
                        Rule #{{ loop.index }}
                    </div>
                    <div class="rule-title">{{ r.title }}</div>
                    <div class="rule-desc">{{ r.description }}</div>
                </div>
            </div>
            <div class="rule-actions">
                <button type="button" class="btn btn-secondary btn-sm" onclick="openEditRuleModal({{ r|json_encode }})">
                    ✏️ Edit
                </button>
                <form method="POST" action="{{ path('app_common_rules_delete', {'id': r.id}) }}" onsubmit="return confirm('Delete this common rule?');" style="margin: 0;">
                    <button type="submit" class="btn btn-danger btn-sm">
                        ✕
                    </button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="rule-card" style="justify-content: center; text-align: center; padding: 3rem;">
            <p style="color: var(--text-muted); margin: 0;">No common rules found. Click "Add Common Rule" to create one.</p>
        </div>
    {% endfor %}
</div>

<!-- Modal: Add / Edit Common Rule -->
<dialog id="rule-modal" style="max-width: 550px;">
    <h2 id="rule-modal-title" style="margin-bottom: 1.5rem; font-size: 1.35rem; font-weight: 800;">Configure Common Rule</h2>
    <form method="POST" action="{{ path('app_common_rules_save') }}">
        <input type="hidden" name="id" id="edit-rule-id" value="0">
        
        <div style="display: grid; grid-template-columns: 80px 1fr; gap: 1rem; align-items: start;">
            <div class="form-group">
                <label class="form-label" for="rule-icon">Icon</label>
                <input type="text" id="rule-icon" name="icon" class="form-input" value="📜" style="text-align: center; font-size: 1.5rem;">
            </div>
            <div class="form-group">
                <label class="form-label" for="rule-title">Rule Title</label>
                <input type="text" id="rule-title" name="title" class="form-input" placeholder="e.g. Say What You See" required autofocus>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="rule-desc">Rule Explanation & Guidelines</label>
            <textarea id="rule-desc" name="description" class="form-textarea" rows="4" placeholder="Explain the rule in simple, engaging terms for players..."></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('rule-modal').close()">Cancel</button>
            <button type="submit" class="btn btn-primary" id="rule-modal-submit">Save Common Rule</button>
        </div>
    </form>
</dialog>
{% endblock %}

{% block javascripts %}
<script>
    function openAddRuleModal() {
        document.getElementById('edit-rule-id').value = '0';
        document.getElementById('rule-modal-title').textContent = 'Add New Common Rule';
        document.getElementById('rule-modal-submit').textContent = 'Add Common Rule';
        document.getElementById('rule-icon').value = '📜';
        document.getElementById('rule-title').value = '';
        document.getElementById('rule-desc').value = '';
        document.getElementById('rule-modal').showModal();
    }

    function openEditRuleModal(rule) {
        document.getElementById('edit-rule-id').value = rule.id;
        document.getElementById('rule-modal-title').textContent = 'Edit Common Rule: ' + rule.title;
        document.getElementById('rule-modal-submit').textContent = 'Save Changes';
        document.getElementById('rule-icon').value = rule.icon || '📜';
        document.getElementById('rule-title').value = rule.title || '';
        document.getElementById('rule-desc').value = rule.description || '';
        document.getElementById('rule-modal').showModal();
    }
</script>
{% endblock %}

