            </div>
        </div>

    </div>
</dialog>
{% endblock %}

{% block javascripts %}
<script src="/js/sounds.js"></script>
<script>
    const PUZZLES = {{ questions|json_encode|raw }};
    const CURRENT_FILTER_STATUS = "{{ status|e('js') }}";
    let curIndex = 0;
    let answerRevealed = false;

    // AI Generation State
    let currentAiImageUrl = null;
    let isGeneratingAi = false;
    let aiModal = null;
    let editAnsModal = null;
    let enlargedModal = null;
    let upgradeModal = null;

    document.addEventListener('DOMContentLoaded', () => {
        aiModal = document.getElementById('ai-studio-modal');
        editAnsModal = document.getElementById('edit-answer-modal');
        enlargedModal = document.getElementById('enlarged-image-modal');
        upgradeModal = document.getElementById('upgrade-resolution-modal');
    });

    // Auto-advance preference
    const autoAdvanceToggle = document.getElementById('auto-advance-toggle');
    if (localStorage.getItem('review_auto_advance') !== null) {
        autoAdvanceToggle.checked = (localStorage.getItem('review_auto_advance') === 'true');
    }
    autoAdvanceToggle.addEventListener('change', () => {
        localStorage.setItem('review_auto_advance', autoAdvanceToggle.checked);
    });

    function renderSlide() {
        if (!PUZZLES.length) {
            let emptyContent = '';
            if (CURRENT_FILTER_STATUS === 'unrated' || CURRENT_FILTER_STATUS === 'avoid_selected' || CURRENT_FILTER_STATUS === 'unreviewed' || !CURRENT_FILTER_STATUS) {
                const incCount = document.getElementById('stat-included') ? document.getElementById('stat-included').innerText : '{{ stats.included }}';
                const skipCount = document.getElementById('stat-skipped') ? document.getElementById('stat-skipped').innerText : '{{ stats.skipped }}';
                emptyContent = `
                    <div style="font-size: 3.5rem; margin-bottom: 0.75rem;">🎉</div>
                    <h2 style="font-size: 1.5rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem;">All Unrated Questions Reviewed!</h2>
                    <p style="color: var(--text-muted); font-size: 0.95rem; max-width: 520px; margin: 0 auto 1.5rem auto;">
                        No unrated questions remain in this review queue. All matching questions have been reviewed, included, excluded, or skipped.
                    </p>
                    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
                        <a href="{{ path('app_moderation_review', { status: 'included' }) }}" class="btn btn-primary" style="padding: 0.6rem 1.25rem;">
                            👍 View Selected Questions (${incCount})
                        </a>
                        <a href="{{ path('app_moderation_review', { status: 'skipped' }) }}" class="btn btn-secondary" style="padding: 0.6rem 1.25rem;">
                            ⏭️ View Skipped Questions (${skipCount})
                        </a>
                        <a href="{{ path('app_moderation_review', { status: 'all' }) }}" class="btn btn-secondary" style="padding: 0.6rem 1.25rem;">
                            📚 View All Questions
                        </a>
                    </div>
                `;
            } else {
                emptyContent = `
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
                    <h3 style="font-size: 1.3rem; color: #fff; margin-bottom: 0.5rem;">No questions match this filter</h3>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Try changing the status, category, or search filter.</p>
                    <div style="display: flex; gap: 0.75rem; justify-content: center;">
                        <a href="{{ path('app_moderation_review') }}" class="btn btn-primary">Reset to Review Queue</a>
                        <a href="{{ path('app_moderation_review', { status: 'all' }) }}" class="btn btn-secondary">All Questions</a>
                    </div>
                `;
            }

            document.getElementById('review-workspace').innerHTML = `
                <div style="grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-color); padding: 2rem;">
                    ${emptyContent}
                </div>
            `;
            if (document.getElementById('btn-prev')) document.getElementById('btn-prev').disabled = true;
            if (document.getElementById('btn-next')) document.getElementById('btn-next').disabled = true;
            if (document.getElementById('current-idx-display')) document.getElementById('current-idx-display').innerText = '0';
            if (document.getElementById('total-count-display')) document.getElementById('total-count-display').innerText = '0';
            return;
        }

        if (curIndex < 0) curIndex = 0;
        if (curIndex >= PUZZLES.length) curIndex = PUZZLES.length - 1;

        const p = PUZZLES[curIndex];
        const visualPane = document.getElementById('puzzle-visual-pane');

        // Meta tags
        const catBadge = document.getElementById('card-cat-badge');
        catBadge.innerText = (p.category_icon || '🧩') + ' ' + (p.category_name || 'Category');
        catBadge.style.background = p.category_color || 'var(--primary)';

        document.getElementById('card-diff-badge').innerText = p.difficulty || 'Medium';
        document.getElementById('card-id-tag').innerText = '#' + p.id;

        // Badges: skipped or excluded returning from back of queue
        const skippedBadge = document.getElementById('skipped-badge');
        if (skippedBadge) {
            skippedBadge.style.display = p._was_skipped ? 'inline-block' : 'none';
        }
        const excludedBadge = document.getElementById('excluded-queue-badge');
        if (excludedBadge) {
            excludedBadge.style.display = (p._was_excluded || p.review_status === 'excluded') ? 'inline-block' : 'none';
        }

        // Media & hints
        const img = document.getElementById('card-img');
        img.src = p.media_path || '';
        img.alt = p.title || p.answer;
        img.onload = () => {
            const dimBadge = document.getElementById('img-dim-badge');
            if (dimBadge && img.naturalWidth && img.naturalHeight) {
                const isSmall = (img.naturalWidth < 600 || img.naturalHeight < 400);
                dimBadge.innerHTML = isSmall 
                    ? `⚠️ Small: ${img.naturalWidth}×${img.naturalHeight}`
                    : `📐 ${img.naturalWidth}×${img.naturalHeight}`;
                dimBadge.style.color = isSmall ? 'var(--accent)' : '#e2e8f0';
                dimBadge.style.borderColor = isSmall ? 'var(--accent)' : 'rgba(255,255,255,0.15)';
            }
        };

        // AI / Upscaled indicators & Restore button
        const isAiImage = (p.media_path && p.media_path.startsWith('/uploads/ai/'));
        const isUpscaled = (p.media_path && p.media_path.startsWith('/uploads/upscaled/'));
        const hasOriginal = (p.original_media_path && p.original_media_path !== p.media_path);
        
        const aiBadge = document.getElementById('ai-active-badge');
        const upscaledBadge = document.getElementById('upscaled-active-badge');
        const restoreBtn = document.getElementById('btn-restore-img');
        if (aiBadge) aiBadge.style.display = isAiImage ? 'inline-block' : 'none';
        if (upscaledBadge) upscaledBadge.style.display = isUpscaled ? 'inline-block' : 'none';
        if (restoreBtn) restoreBtn.style.display = hasOriginal ? 'inline-block' : 'none';

        document.getElementById('card-prompt').innerText = p.prompt_text || 'Say what you see!';
        document.getElementById('card-hint').innerText = p.hint ? ('💡 Hint: ' + p.hint) : '';

        // Answer
        document.getElementById('card-answer-text').innerText = p.answer;
        const alts = document.getElementById('card-alts-text');
        alts.innerText = p.alternate_answers ? ('Also accepted: ' + p.alternate_answers) : '';

        // Decision status: thumbs up / thumbs down / pending
        const statusBadge = document.getElementById('card-status-badge');
        const btnUp = document.getElementById('btn-thumbs-up');
        const btnDown = document.getElementById('btn-thumbs-down');

        if (p.review_status === 'included') {
            statusBadge.innerText = '👍 Included';
            statusBadge.className = 'status-badge status-included';
            statusBadge.style.background = '';
            statusBadge.style.color = '';
            statusBadge.style.border = '';
            if (visualPane) {
                visualPane.classList.add('card-included');
                visualPane.classList.remove('card-excluded');
            }
            btnUp.classList.add('active');
            btnDown.classList.remove('active');
        } else if (p.review_status === 'excluded') {
            statusBadge.innerText = '👎 Excluded';
            statusBadge.className = 'status-badge status-excluded';
            statusBadge.style.background = '';
            statusBadge.style.color = '';
            statusBadge.style.border = '';
            if (visualPane) {
                visualPane.classList.add('card-excluded');
                visualPane.classList.remove('card-included');
            }
            btnDown.classList.add('active');
            btnUp.classList.remove('active');
        } else if (p.review_status === 'skipped') {
            statusBadge.innerText = '⏭️ Skipped';
            statusBadge.className = 'status-badge';
            statusBadge.style.background = 'rgba(245, 158, 11, 0.2)';
            statusBadge.style.color = '#f59e0b';
            statusBadge.style.border = '1px solid #f59e0b';
            if (visualPane) {
                visualPane.classList.remove('card-included');
                visualPane.classList.remove('card-excluded');
            }
            btnUp.classList.remove('active');
            btnDown.classList.remove('active');
        } else {
            // Unrated Question
            statusBadge.innerText = '⏳ Unrated';
            statusBadge.className = 'status-badge status-pending';
            statusBadge.style.background = '';
            statusBadge.style.color = '';
            statusBadge.style.border = '';
            if (visualPane) {
                visualPane.classList.remove('card-included');
                visualPane.classList.remove('card-excluded');
            }
            btnUp.classList.remove('active');
            btnDown.classList.remove('active');
        }

        // Favorite button
        const favBtn = document.getElementById('card-fav-btn');
        if (parseInt(p.is_favorite) === 1) {
            favBtn.innerText = '⭐ Starred';
            favBtn.classList.add('btn-primary');
            favBtn.classList.remove('btn-secondary');
        } else {
            favBtn.innerText = '☆ Star';
            favBtn.classList.add('btn-secondary');
            favBtn.classList.remove('btn-primary');
        }

        // Nav and Progress
        document.getElementById('current-idx-display').innerText = (curIndex + 1);
        document.getElementById('total-count-display').innerText = PUZZLES.length;
        document.getElementById('jump-input').value = (curIndex + 1);
        document.getElementById('jump-input').max = PUZZLES.length;

        const progressPercent = ((curIndex + 1) / PUZZLES.length) * 100;
        document.getElementById('progress-bar').style.width = progressPercent + '%';

        document.getElementById('btn-prev').disabled = (curIndex === 0);
        document.getElementById('btn-next').disabled = (curIndex === PUZZLES.length - 1);

        // Answer is ALWAYS visible on review screen
        answerRevealed = true;
        document.getElementById('card-answer-box').style.display = 'block';
        const revealBtn = document.getElementById('reveal-btn');
        if (revealBtn) {
            revealBtn.innerHTML = '🙈 Hide <span style="font-size:0.72rem; opacity:0.75;">(Space)</span>';
        }
    }

    function toggleAnswer() {
        if (!PUZZLES.length) return;
        answerRevealed = !answerRevealed;
        const ans = document.getElementById('card-answer-box');
        const btn = document.getElementById('reveal-btn');
        if (answerRevealed) {
            ans.style.display = 'block';
            if (btn) btn.innerHTML = '🙈 Hide <span style="font-size:0.72rem; opacity:0.75;">(Space)</span>';
            if (window.soundFX && window.soundFX.playDingCorrect) {
                window.soundFX.playDingCorrect();
            }
        } else {
            ans.style.display = 'none';
            if (btn) btn.innerHTML = '💡 Show <span style="font-size:0.72rem; opacity:0.75;">(Space)</span>';
        }
    }

    function updateHeaderCounts(counts) {
        if (!counts) return;
        if (document.getElementById('stat-total')) document.getElementById('stat-total').innerText = counts.total;
        if (document.getElementById('stat-unrated')) document.getElementById('stat-unrated').innerText = counts.unrated ?? counts.to_review;
        if (document.getElementById('stat-to-review')) document.getElementById('stat-to-review').innerText = counts.unrated ?? counts.to_review;
        if (document.getElementById('stat-included')) document.getElementById('stat-included').innerText = counts.included;
        if (document.getElementById('stat-excluded')) document.getElementById('stat-excluded').innerText = counts.excluded;
        if (document.getElementById('stat-skipped')) document.getElementById('stat-skipped').innerText = counts.skipped ?? 0;
        if (document.getElementById('stat-fav') && counts.favorites !== undefined) {
            document.getElementById('stat-fav').innerText = counts.favorites;
        }
    }

    function voteCurrent(decision) {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const targetActive = parseInt(decision);
        const actionType = (targetActive === 1) ? 'up' : 'down';

        fetch(`/moderation/question/${p.id}/review-vote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_active: targetActive, vote: actionType })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                p.is_active = data.is_active;
                p.review_status = data.review_status;

                if (data.counts) {
                    updateHeaderCounts(data.counts);
                }

                if (targetActive === 1) {
                    // Thumbs Up / Included
                    if (window.soundFX && window.soundFX.playDingCorrect) {
                        window.soundFX.playDingCorrect();
                    }

                    // In Only Unrated mode, once included, it is removed from this queue!
                    if (CURRENT_FILTER_STATUS === 'unrated' || CURRENT_FILTER_STATUS === 'avoid_selected' || CURRENT_FILTER_STATUS === 'unreviewed' || !CURRENT_FILTER_STATUS) {
                        PUZZLES.splice(curIndex, 1);
                        if (curIndex >= PUZZLES.length) {
                            curIndex = Math.max(0, PUZZLES.length - 1);
                        }
                        renderSlide();
                        return;
                    }
                } else {
                    // Thumbs Down / Excluded / Rejected
                    if (window.soundFX && window.soundFX.playTick) {
                        window.soundFX.playTick();
                    }

                    // In Only Unrated mode, rejected questions are strictly avoided and removed from this queue!
                    if (CURRENT_FILTER_STATUS === 'unrated' || CURRENT_FILTER_STATUS === 'avoid_selected' || CURRENT_FILTER_STATUS === 'unreviewed' || !CURRENT_FILTER_STATUS) {
                        PUZZLES.splice(curIndex, 1);
                        if (curIndex >= PUZZLES.length) {
                            curIndex = Math.max(0, PUZZLES.length - 1);
                        }
                        renderSlide();
                        return;
                    }

                    p._was_excluded = true;
                    p.review_status = 'excluded';
                }

                // In other modes (e.g. All Questions), render updated slide and auto-advance
                renderSlide();

                if (autoAdvanceToggle.checked && curIndex < PUZZLES.length - 1) {
                    setTimeout(() => {
                        nextSlide();
                    }, 220);
                }
            }
        });
    }

    /* SKIP FEATURE: Move current question out of unrated queue, persist as skipped */
    function skipCurrent() {
        if (!PUZZLES.length) return;
        const skipped = PUZZLES.splice(curIndex, 1)[0];
        skipped._was_skipped = true;
        skipped.review_status = 'skipped';

        if (window.soundFX && window.soundFX.playWarningTick) {
            window.soundFX.playWarningTick();
        }

        // Persist skip status in database
        fetch(`/moderation/question/${skipped.id}/review-vote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ vote: 'skip', status: 'skipped' })
        })
        .then(res => res.json())
        .then(data => {
            if (data.counts) {
                updateHeaderCounts(data.counts);
            }
        }).catch(() => {});

        // In Only Unrated mode: strictly avoid skipped questions and remove from this queue!
        if (CURRENT_FILTER_STATUS === 'unrated' || CURRENT_FILTER_STATUS === 'avoid_selected' || CURRENT_FILTER_STATUS === 'unreviewed' || !CURRENT_FILTER_STATUS) {
            if (curIndex >= PUZZLES.length) {
                curIndex = Math.max(0, PUZZLES.length - 1);
            }
            renderSlide();
            return;
        } else {
            // In All Questions mode, move to back of queue
            PUZZLES.push(skipped);
            if (curIndex >= PUZZLES.length) {
                curIndex = Math.max(0, PUZZLES.length - 1);
            }
            renderSlide();
        }
    }

    function toggleCurrentFav() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        fetch(`/moderation/question/${p.id}/toggle-fav`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    p.is_favorite = data.is_favorite;
                    const favEl = document.getElementById('stat-fav');
                    if (favEl) {
                        let cur = parseInt(favEl.innerText) || 0;
                        favEl.innerText = p.is_favorite == 1 ? cur + 1 : Math.max(0, cur - 1);
                    }
                    renderSlide();
                }
            });
    }

    function nextSlide() {
        if (curIndex < PUZZLES.length - 1) {
            curIndex++;
            renderSlide();
        }
    }

    function prevSlide() {
        if (curIndex > 0) {
            curIndex--;
            renderSlide();
        }
    }

    function jumpToSlide() {
        const val = parseInt(document.getElementById('jump-input').value);
        if (!isNaN(val) && val >= 1 && val <= PUZZLES.length) {
            curIndex = val - 1;
            renderSlide();
        }
    }

    /* -------------------------------------------------------------------------
       EDIT ANSWER & CLUES
       ------------------------------------------------------------------------- */
    function openEditAnswerModal() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        document.getElementById('edit-ans-subtitle').innerText = `Question #${p.id} • Category: ${p.category_name || ''}`;
        document.getElementById('edit-ans-input').value = p.answer || '';
        document.getElementById('edit-ans-alts').value = p.alternate_answers || '';
        document.getElementById('edit-ans-hint').value = p.hint || '';
        document.getElementById('edit-ans-explanation').value = p.explanation || '';
        editAnsModal.showModal();
    }

    function closeEditAnswerModal() {
        if (editAnsModal) editAnsModal.close();
    }

    function saveAnswerForm(e) {
        e.preventDefault();
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const newAns = document.getElementById('edit-ans-input').value.trim();
        const newAlts = document.getElementById('edit-ans-alts').value.trim();
        const newHint = document.getElementById('edit-ans-hint').value.trim();
        const newExpl = document.getElementById('edit-ans-explanation').value.trim();

        if (!newAns) return alert('Answer cannot be empty');

        fetch(`/moderation/question/${p.id}/update-answer`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                answer: newAns,
                alternate_answers: newAlts,
                hint: newHint,
                explanation: newExpl
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                p.answer = data.answer;
                p.alternate_answers = data.alternate_answers;
                p.hint = data.hint;
                p.explanation = data.explanation;
                closeEditAnswerModal();
                renderSlide();
                if (window.soundFX && window.soundFX.playDingCorrect) {
                    window.soundFX.playDingCorrect();
                }
            } else {
                alert(data.error || 'Failed to update answer');
            }
        })
        .catch(err => alert('Network error while saving answer'));
    }

    /* -------------------------------------------------------------------------
       AI IMAGE STUDIO (BESPOKE REBUS PUZZLE GENERATION)
       ------------------------------------------------------------------------- */
    function openAiStudioModal() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];

        document.getElementById('ai-modal-subtitle').innerText = `Question #${p.id} • Answer: "${p.answer}"`;
        document.getElementById('ai-existing-img').src = p.media_path;

        document.getElementById('ai-generated-img').style.display = 'none';
        document.getElementById('ai-loading-state').style.display = 'flex';
        document.getElementById('btn-ai-regen').disabled = true;
        document.getElementById('btn-ai-select').disabled = true;
        currentAiImageUrl = null;

        aiModal.showModal();

        fetch(`/moderation/question/${p.id}/ai-prompt`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('ai-prompt-input').value = data.default_prompt;
                    document.getElementById('ai-rebus-concept-text').innerText = data.concept || `Visual rebus puzzle clue for "${p.answer}"`;
                    triggerAiGenerate();
                }
            })
            .catch(() => {
                document.getElementById('ai-prompt-input').value = `TV Game Show Catchphrase Rebus Puzzle Card: Say What You See visual riddle for '${p.answer}'. Cartoon puzzle art on dark game show background.`;
                document.getElementById('ai-rebus-concept-text').innerText = `Rebus visual riddle for "${p.answer}"`;
                triggerAiGenerate();
            });
    }

    function closeAiStudioModal() {
        if (aiModal) aiModal.close();
    }

    function applyPromptFormula(formula) {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const ans = p.answer.toUpperCase();
        let prompt = '';

        if (formula === 'scramble') {
            prompt = `TV Game Show Catchphrase Rebus Card: The alphabet letters ${ans.split('').join(', ')} are scrambled, tilted, and jumbled inside a frying pan on a clean stage board. Say What You See visual word riddle, no realistic food, only cartoon letter tiles.`;
        } else if (formula === 'stacked') {
            const parts = ans.split(' ');
            const top = parts[0] || 'TOP';
            const bot = parts.slice(1).join(' ') || 'BOTTOM';
            prompt = `Dingbat Rebus Puzzle Card: The bold capital word '${top}' floating directly above a bright divider line, with the word '${bot}' beneath it on a dark game show board. Say What You See spatial wordplay riddle.`;
        } else if (formula === 'inside') {
            prompt = `Dingbat Rebus Card: The word '${ans}' placed directly inside the letters of a word or frame. Spatial typography game show riddle on dark background.`;
        } else if (formula === 'phonetic') {
            prompt = `TV Game Show Catchphrase Rebus Card: A phonetic rebus equation with 2 or 3 distinct cartoon icons lined up side by side representing '${p.answer}'. Sound-it-out visual riddle.`;
        } else if (formula === 'color') {
            prompt = `Dingbat Rebus Wordplay Card: The word '${ans}' in huge bold 3D block letters glowing in neon radioactive slime green on a dark game show board. Say What You See visual idiom puzzle.`;
        } else if (formula === 'split') {
            prompt = `Dingbat Rebus Puzzle Card: The word '${ans}' cleanly split in half with a jagged lightning crack separating the two halves. Spatial wordplay puzzle on dark background.`;
        }

        document.getElementById('ai-prompt-input').value = prompt;
        document.getElementById('ai-style-select').value = 'rebus';
        triggerAiGenerate();
    }

    function updateDefaultPromptForStyle() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const style = document.getElementById('ai-style-select').value;
        const ans = p.answer;

        let prompt = '';
        if (style === 'cartoon') {
            prompt = `Catchphrase TV game show visual rebus riddle for '${ans}'. 1980s retro cartoon illustration, colorful comic line art, dark stage background, say what you see puzzle card.`;
        } else if (style === '3d') {
            prompt = `3D neon game show stage rebus puzzle for '${ans}'. Dramatic studio lighting, glowing neon letters and icons on glossy dark floor, visual riddle.`;
        } else if (style === 'vector_rebus') {
            prompt = `Crisp vector dingbat rebus puzzle card for '${ans}'. Bold typography, clean spatial wordplay, high contrast on dark slate background.`;
        } else {
            prompt = `TV Game Show Catchphrase Rebus Puzzle Card: Say What You See visual riddle for '${ans}'. Cartoon puzzle art on dark game show background.`;
        }

        document.getElementById('ai-prompt-input').value = prompt;
    }

    function triggerAiGenerate(seed = null) {
        if (!PUZZLES.length || isGeneratingAi) return;
        const p = PUZZLES[curIndex];
        const prompt = document.getElementById('ai-prompt-input').value;
        const style = document.getElementById('ai-style-select').value;
        const resolution = document.getElementById('ai-res-select') ? document.getElementById('ai-res-select').value : '1280x800';

        isGeneratingAi = true;
        document.getElementById('btn-trigger-generate').disabled = true;
        document.getElementById('btn-ai-regen').disabled = true;
        document.getElementById('btn-ai-select').disabled = true;

        document.getElementById('ai-generated-img').style.display = 'none';
        document.getElementById('ai-loading-state').style.display = 'flex';
        document.getElementById('ai-loading-text').innerText = `Creating high-resolution (${resolution}) rebus puzzle...`;

        fetch(`/moderation/question/${p.id}/ai-generate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: prompt, style: style, resolution: resolution, seed: seed })
        })
        .then(res => res.json())
        .then(data => {
            isGeneratingAi = false;
            document.getElementById('btn-trigger-generate').disabled = false;

            if (data.success && data.image_url) {
                currentAiImageUrl = data.image_url;
                const genImg = document.getElementById('ai-generated-img');
                genImg.src = data.image_url;
                genImg.onload = () => {
                    document.getElementById('ai-loading-state').style.display = 'none';
                    genImg.style.display = 'block';
                    document.getElementById('btn-ai-regen').disabled = false;
                    document.getElementById('btn-ai-select').disabled = false;
                    const dimLabel = data.dimensions ? `${data.dimensions} ` : '';
                    const formatLabel = data.format ? data.format.toUpperCase() : 'HD';
                    document.getElementById('ai-format-badge').innerText = `✨ ${dimLabel}${formatLabel}`;
                };
            } else {
                document.getElementById('ai-loading-text').innerText = 'Generation failed. Click Regenerate to retry.';
                document.getElementById('btn-ai-regen').disabled = false;
            }
        })
        .catch(err => {
            isGeneratingAi = false;
            document.getElementById('btn-trigger-generate').disabled = false;
            document.getElementById('btn-ai-regen').disabled = false;
            document.getElementById('ai-loading-text').innerText = 'Network error. Click Regenerate to retry.';
        });
    }

    function regenerateAiImage() {
        const randomSeed = Math.floor(Math.random() * 900000) + 100000;
        triggerAiGenerate(randomSeed);
    }

    function selectAiImage() {
        if (!currentAiImageUrl || !PUZZLES.length) return;
        const p = PUZZLES[curIndex];

        fetch(`/moderation/question/${p.id}/ai-apply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'apply_ai', image_url: currentAiImageUrl })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                p.media_path = data.media_path;
                if (data.original_media_path) {
                    p.original_media_path = data.original_media_path;
                }
                renderSlide();
                closeAiStudioModal();
                if (window.soundFX && window.soundFX.playDingCorrect) {
                    window.soundFX.playDingCorrect();
                }
            }
        });
    }

    function selectExistingImage() {
        closeAiStudioModal();
    }

    function restoreOriginalImage() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];

        fetch(`/moderation/question/${p.id}/ai-apply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'restore_original' })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                p.media_path = data.media_path;
                renderSlide();
                if (window.soundFX && window.soundFX.playDingCorrect) {
                    window.soundFX.playDingCorrect();
                }
            }
        });
    }

    /* -------------------------------------------------------------------------
       ENLARGED FULL-SIZE IMAGE VIEWER
       ------------------------------------------------------------------------- */
    function openEnlargedImageModal() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const modal = document.getElementById('enlarged-image-modal');
        const img = document.getElementById('enlarged-img-src');
        const title = document.getElementById('enlarged-title');
        const dimBadge = document.getElementById('enlarged-dim-badge');

        img.src = p.media_path || '';
        title.innerText = '#' + p.id + ' • ' + (p.prompt_text || p.title || 'Rebus Puzzle');
        img.onload = () => {
            if (dimBadge && img.naturalWidth && img.naturalHeight) {
                dimBadge.innerText = img.naturalWidth + ' × ' + img.naturalHeight + ' px';
            }
        };
        if (modal) modal.showModal();
    }

    function closeEnlargedImageModal() {
        const modal = document.getElementById('enlarged-image-modal');
        if (modal) modal.close();
    }

    /* -------------------------------------------------------------------------
       UPGRADE IMAGE RESOLUTION (SCALING & REGENERATION WITH REJECT OPTION)
       ------------------------------------------------------------------------- */
    let currentUpgradedImageUrl = null;

    function openUpgradeResolutionModal() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const modal = document.getElementById('upgrade-resolution-modal');
        const dimText = document.getElementById('upgrade-cur-dim-text');
        const existingImg = document.getElementById('upgrade-existing-img');
        const existingBadge = document.getElementById('upgrade-existing-badge');
        const img = document.getElementById('card-img');

        currentUpgradedImageUrl = null;
        existingImg.src = p.media_path || '';
        
        if (img && img.naturalWidth && img.naturalHeight) {
            const isSmall = (img.naturalWidth < 600 || img.naturalHeight < 400);
            dimText.innerText = `${img.naturalWidth} × ${img.naturalHeight} px ${isSmall ? '(Low-Res File)' : '(High-Res)'}`;
            existingBadge.innerText = `${img.naturalWidth} × ${img.naturalHeight}`;
        } else {
            dimText.innerText = 'Current image file';
            existingBadge.innerText = 'Current';
        }

        // Reset preview card
        const idleState = document.getElementById('upgrade-idle-state');
        const loadingState = document.getElementById('upgrade-loading-state');
        const resImg = document.getElementById('upgrade-result-img');
        if (resImg) {
            resImg.style.display = 'none';
            resImg.src = '';
        }
        if (loadingState) loadingState.style.display = 'none';
        if (idleState) idleState.style.display = 'flex';
        document.getElementById('upgrade-result-heading').innerText = '⚡ Upgraded Preview';
        document.getElementById('upgrade-result-badge').innerText = 'Preview';
        document.getElementById('btn-apply-upgrade').disabled = true;

        if (modal) modal.showModal();
    }

    function closeUpgradeResolutionModal() {
        const modal = document.getElementById('upgrade-resolution-modal');
        if (modal) modal.close();
    }

    function rejectUpgradeAndKeepExisting() {
        currentUpgradedImageUrl = null;
        closeUpgradeResolutionModal();
        if (window.soundFX && window.soundFX.playTick) {
            window.soundFX.playTick();
        }
    }

    function runUpscalePreview() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const idleState = document.getElementById('upgrade-idle-state');
        const loadingState = document.getElementById('upgrade-loading-state');
        const loadingText = document.getElementById('upgrade-loading-text');
        const resImg = document.getElementById('upgrade-result-img');
        const btnUpscale = document.getElementById('btn-modal-upscale');
        const btnRegen = document.getElementById('btn-modal-regen');
        const btnApply = document.getElementById('btn-apply-upgrade');

        resImg.style.display = 'none';
        if (idleState) idleState.style.display = 'none';
        loadingState.style.display = 'flex';
        loadingText.innerText = '🔬 Physically scaling graphic with bicubic super-sampling & edge sharpening...';
        btnUpscale.disabled = true;
        btnRegen.disabled = true;
        btnApply.disabled = true;

        fetch(`/moderation/question/${p.id}/upscale-image`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ target_width: 1280 })
        })
        .then(res => res.json())
        .then(data => {
            btnUpscale.disabled = false;
            btnRegen.disabled = false;

            if (data.success && data.image_url) {
                currentUpgradedImageUrl = data.image_url;
                let loaded = false;
                resImg.onload = () => {
                    if (loaded) return;
                    loaded = true;
                    loadingState.style.display = 'none';
                    if (idleState) idleState.style.display = 'none';
                    resImg.style.display = 'block';
                    btnApply.disabled = false;
                    document.getElementById('upgrade-result-heading').innerText = `🔬 Scaled (${data.dimensions})`;
                    document.getElementById('upgrade-result-badge').innerText = `${data.scale_factor || 'HD'}`;
                };
                resImg.onerror = () => {
                    loadingText.innerText = 'Failed to load upscaled image preview.';
                    btnUpscale.disabled = false;
                    btnRegen.disabled = false;
                };
                resImg.src = data.image_url;
                if (resImg.complete && resImg.naturalWidth > 0) {
                    resImg.onload();
                }
            } else {
                loadingText.innerText = 'Upscaling error: ' + (data.error || 'Failed to upscale image file.');
            }
        })
        .catch(() => {
            btnUpscale.disabled = false;
            btnRegen.disabled = false;
            loadingText.innerText = 'Network error while attempting upscale.';
        });
    }

    function runRegenPreview() {
        if (!PUZZLES.length) return;
        const p = PUZZLES[curIndex];
        const styleSelect = document.getElementById('upgrade-regen-style');
        const styleSelectVal = styleSelect ? styleSelect.value : 'vector_rebus|1280x800';
        const parts = styleSelectVal.split('|');
        const style = parts[0] || 'vector_rebus';
        const resolution = parts[1] || '1280x800';

        const idleState = document.getElementById('upgrade-idle-state');
        const loadingState = document.getElementById('upgrade-loading-state');
        const loadingText = document.getElementById('upgrade-loading-text');
        const resImg = document.getElementById('upgrade-result-img');
        const btnUpscale = document.getElementById('btn-modal-upscale');
        const btnRegen = document.getElementById('btn-modal-regen');
        const btnApply = document.getElementById('btn-apply-upgrade');

        resImg.style.display = 'none';
        if (idleState) idleState.style.display = 'none';
        loadingState.style.display = 'flex';
        loadingText.innerText = (style === 'vector_rebus')
            ? '🧩 Generating instant crisp vector rebus card...'
            : `🎨 Generating bespoke high-resolution (${resolution}) rebus puzzle...`;
        btnUpscale.disabled = true;
        btnRegen.disabled = true;
        btnApply.disabled = true;

        fetch(`/moderation/question/${p.id}/ai-generate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ resolution: resolution, style: style, seed: Math.floor(Math.random() * 900000) + 100000 })
        })
        .then(res => res.json())
        .then(data => {
            btnUpscale.disabled = false;
            btnRegen.disabled = false;

            if (data.success && data.image_url) {
                currentUpgradedImageUrl = data.image_url;
                let loaded = false;
                resImg.onload = () => {
                    if (loaded) return;
                    loaded = true;
                    loadingState.style.display = 'none';
                    if (idleState) idleState.style.display = 'none';
                    resImg.style.display = 'block';
                    btnApply.disabled = false;
                    document.getElementById('upgrade-result-heading').innerText = `🎨 Regenerated (${data.dimensions || resolution})`;
                    document.getElementById('upgrade-result-badge').innerText = `${data.format ? data.format.toUpperCase() : 'HD'}`;
                };
                resImg.onerror = () => {
                    loadingText.innerText = 'Failed to load regenerated image preview.';
                    btnUpscale.disabled = false;
                    btnRegen.disabled = false;
                };
                resImg.src = data.image_url;
                if (resImg.complete && resImg.naturalWidth > 0) {
                    resImg.onload();
                }
            } else {
                loadingText.innerText = 'Regeneration error: ' + (data.error || 'Failed to generate image.');
            }
        })
        .catch(() => {
            btnUpscale.disabled = false;
            btnRegen.disabled = false;
            loadingText.innerText = 'Network error while generating image.';
        });
    }

    function applyUpgradedResult() {
        if (!currentUpgradedImageUrl || !PUZZLES.length) return;
        const p = PUZZLES[curIndex];

        fetch(`/moderation/question/${p.id}/ai-apply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'apply_ai', image_url: currentUpgradedImageUrl })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                p.media_path = data.media_path;
                if (data.original_media_path) {
                    p.original_media_path = data.original_media_path;
                }
                closeUpgradeResolutionModal();
                renderSlide();
                if (window.soundFX && window.soundFX.playDingCorrect) {
                    window.soundFX.playDingCorrect();
                }
            }
        });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA') return;
        if (aiModal && aiModal.open) return;
        if (editAnsModal && editAnsModal.open) return;
        if (upgradeModal && upgradeModal.open) {
            if (e.key === 'Escape') rejectUpgradeAndKeepExisting();
            return;
        }

        if (e.key === 'z' || e.key === 'Z') {
            e.preventDefault();
            if (enlargedModal && enlargedModal.open) {
                closeEnlargedImageModal();
            } else {
                openEnlargedImageModal();
            }
            return;
        }

        if (enlargedModal && enlargedModal.open) {
            if (e.key === 'Escape') closeEnlargedImageModal();
            return;
        }

        if (e.key === 'ArrowRight' || e.key === 'n' || e.key === 'N') {
            nextSlide();
        } else if (e.key === 'ArrowLeft' || e.key === 'p' || e.key === 'P') {
            prevSlide();
        } else if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            toggleAnswer();
        } else if (e.key === 'ArrowUp' || e.key === 'u' || e.key === 'U' || e.key === '1') {
            e.preventDefault();
            voteCurrent(1);
        } else if (e.key === 'ArrowDown' || e.key === 'd' || e.key === 'D' || e.key === '0') {
            e.preventDefault();
            voteCurrent(0);
        } else if (e.key === 's' || e.key === 'S' || e.key === 'k' || e.key === 'K') {
            e.preventDefault();
            skipCurrent();
        } else if (e.key === 'e' || e.key === 'E') {
            e.preventDefault();
            openEditAnswerModal();
        } else if (e.key === 'f' || e.key === 'F') {
            e.preventDefault();
            toggleCurrentFav();
        }
    });

    renderSlide();
</script>
{% endblock %}
