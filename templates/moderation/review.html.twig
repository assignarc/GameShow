{% extends 'base.html.twig' %}

{% block title %}Question Review & Curation | Rebus Game Show{% endblock %}

{% block stylesheets %}
<style>
    /* ZERO-SCROLL SINGLE-VIEWPORT LAYOUT */
    html, body {
        height: 100vh;
        overflow: hidden;
        margin: 0;
        padding: 0;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    /* Suppress site footer on the review deck to maximize vertical screen space */
    footer.site-footer {
        display: none !important;
    }

    main.container {
        flex: 1;
        max-width: 100% !important;
        width: 100% !important;
        padding: 0.5rem 1.25rem !important;
        margin: 0 !important;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 58px);
        box-sizing: border-box;
        overflow: hidden;
    }

    .review-viewport {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        height: 100%;
        min-height: 0;
    }

    /* TOP SLIM FILTER & STATS BAR */
    .top-slim-bar {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.45rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
    }

    .stat-pills-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color);
        padding: 0.2rem 0.55rem;
        border-radius: 14px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-sub);
    }

    .stat-pill.pill-included {
        background: rgba(16, 185, 129, 0.15);
        border-color: rgba(16, 185, 129, 0.4);
        color: var(--success);
    }

    .stat-pill.pill-excluded {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.4);
        color: var(--danger);
    }

    .stat-pill.pill-fav {
        background: rgba(245, 158, 11, 0.15);
        border-color: rgba(245, 158, 11, 0.4);
        color: var(--accent);
    }

    .filter-items-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: nowrap;
    }

    .form-select-xs, .form-input-xs {
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 0.3rem 0.55rem;
        color: #fff;
        font-size: 0.8rem;
    }

    /* 2-COLUMN WORKSPACE: NO VERTICAL SCROLLING */
    .review-workspace {
        flex: 1;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 0.85rem;
        min-height: 0;
        height: 100%;
        overflow: hidden;
    }

    @media (max-width: 1024px) {
        .review-workspace {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* LEFT PANE: PUZZLE VISUAL & AI STUDIO */
    .puzzle-visual-pane {
        background: var(--bg-card);
        border: 2px solid var(--border-color);
        border-radius: 16px;
        padding: 0.85rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 0;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        box-sizing: border-box;
    }

    .puzzle-visual-pane.card-included {
        border-color: rgba(16, 185, 129, 0.55);
    }

    .puzzle-visual-pane.card-excluded {
        border-color: rgba(239, 68, 68, 0.55);
    }

    .visual-top-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        flex-shrink: 0;
    }

    .media-box-container {
        flex: 1;
        min-height: 0;
        width: 100%;
        background: rgba(0, 0, 0, 0.45);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        position: relative;
    }

    .puzzle-media-image {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 8px;
        cursor: zoom-in;
        image-rendering: -webkit-optimize-contrast;
        transition: transform 0.15s ease;
    }

    .image-overlay-controls {
        position: absolute;
        bottom: 8px;
        right: 8px;
        display: flex;
        gap: 0.35rem;
        align-items: center;
        z-index: 5;
    }

    /* PROMINENT AI ACTION BAR RIGHT UNDER IMAGE */
    .ai-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding-top: 0.65rem;
        margin-top: 0.4rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        flex-shrink: 0;
    }

    .btn-ai-studio {
        background: linear-gradient(135deg, #7c3aed, #d946ef) !important;
        color: #ffffff !important;
        font-weight: 800 !important;
        font-size: 0.88rem !important;
        padding: 0.5rem 1.1rem !important;
        border-radius: 8px !important;
        border: none !important;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4) !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.4rem !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
    }

    .btn-ai-studio:hover {
        transform: translateY(-1px) scale(1.02) !important;
        box-shadow: 0 6px 20px rgba(217, 70, 239, 0.5) !important;
    }

    .btn-upgrade-res {
        background: linear-gradient(135deg, #0284c7, #06b6d4) !important;
        color: #ffffff !important;
        font-weight: 800 !important;
        font-size: 0.88rem !important;
        padding: 0.5rem 1.05rem !important;
        border-radius: 8px !important;
        border: none !important;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4) !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.4rem !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
    }

    .btn-upgrade-res:hover {
        transform: translateY(-1px) scale(1.02) !important;
        box-shadow: 0 6px 20px rgba(6, 182, 212, 0.5) !important;
    }

    /* RIGHT PANE: CONTROLS, ANSWERS, VOTING & NAVIGATION */
    .controls-pane {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 0.85rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 0;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        box-sizing: border-box;
    }

    .status-badge {
        font-size: 0.82rem;
        font-weight: 800;
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .status-badge.status-included {
        background: rgba(16, 185, 129, 0.2);
        border: 1px solid var(--success);
        color: var(--success);
    }

    .status-badge.status-excluded {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid var(--danger);
        color: var(--danger);
    }

    .status-badge.status-pending {
        background: rgba(148, 163, 184, 0.15);
        border: 1px solid rgba(148, 163, 184, 0.35);
        color: #94a3b8;
    }

    /* Answer Card (Always visible on review screen) */
    .answer-card {
        background: rgba(16, 185, 129, 0.12);
        border: 2px solid var(--success);
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        margin: 0.5rem 0;
        display: block;
        animation: answerPop 0.2s ease-out;
    }

    @keyframes answerPop {
        from { transform: scale(0.97); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .answer-text {
        font-size: 1.65rem;
        font-weight: 900;
        color: var(--success);
        line-height: 1.2;
    }

    /* DECISION BAR: 3 BUTTONS (Thumbs Up, Skip, Thumbs Down) */
    .decision-bar {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.65rem;
        margin: 0.5rem 0;
        flex-shrink: 0;
    }

    .btn-vote {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        padding: 0.75rem 0.5rem;
        border-radius: 12px;
        font-size: 0.92rem;
        font-weight: 800;
        cursor: pointer;
        border: 2px solid var(--border-color);
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-sub);
        transition: all 0.18s ease;
        user-select: none;
    }

    .btn-vote .key-hint {
        font-size: 0.72rem;
        font-weight: 600;
        opacity: 0.75;
    }

    .btn-vote:hover {
        transform: translateY(-2px);
    }

    .btn-vote-up:hover {
        border-color: var(--success);
        color: #34d399;
        background: rgba(16, 185, 129, 0.1);
    }

    .btn-vote-skip:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(245, 158, 11, 0.1);
    }

    .btn-vote-down:hover {
        border-color: var(--danger);
        color: #f87171;
        background: rgba(239, 68, 68, 0.1);
    }

    .btn-vote-up.active {
        background: linear-gradient(135deg, #059669, #10b981);
        border-color: #34d399;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .btn-vote-down.active {
        background: linear-gradient(135deg, #b91c1c, #ef4444);
        border-color: #f87171;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
    }

    /* Navigation & Hotkey Controls */
    .nav-controls-row {
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.45rem 0.85rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .progress-bar-wrapper {
        flex: 1;
        height: 5px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
        margin: 0 0.5rem;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        width: 0%;
        transition: width 0.2s ease;
    }

    .hotkey-bar {
        display: flex;
        justify-content: center;
        gap: 0.85rem;
        font-size: 0.74rem;
        color: var(--text-muted);
        text-align: center;
        padding-top: 0.35rem;
        flex-shrink: 0;
    }

    .kbd {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 3px;
        padding: 0.1rem 0.3rem;
        color: #fff;
        font-family: monospace;
        font-weight: bold;
    }

    /* Modal Dialogs */
    dialog.ai-studio-modal {
        background: var(--bg-card);
        border: 2px solid var(--border-color);
        border-radius: 18px;
        padding: 1.5rem;
        max-width: 940px;
        width: 92%;
        max-height: 90vh;
        color: var(--text-main);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
        margin: auto;
        overflow-y: auto;
    }

    dialog.ai-studio-modal::backdrop {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
    }

    .ai-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 1rem;
    }

    .ai-prompt-box {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.85rem;
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .ai-comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1rem;
    }

    .ai-card {
        background: rgba(0, 0, 0, 0.35);
        border: 2px solid var(--border-color);
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
    }

    .ai-preview-img {
        width: 100%;
        height: 290px;
        object-fit: contain;
        border-radius: 8px;
        background: #000;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
    }

    .ai-loading-box {
        width: 100%;
        height: 290px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        border: 1px dashed var(--border-color);
    }

    .spinner {
        width: 38px;
        height: 38px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-top-color: #a855f7;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
{% endblock %}

{% block body %}
<div class="review-viewport">
    <!-- SLIM TOP BAR: LIVE STATS & QUICK FILTERS -->
    <div class="top-slim-bar">
        <div class="stat-pills-row">
            <h1 style="font-size: 0.95rem; font-weight: 800; color: #fff; margin: 0; display: inline-flex; align-items: center; gap: 0.35rem;">
                👍 Question Review & Curation
            </h1>
            <span class="stat-pill" title="Total questions">📊 <span id="stat-total">{{ stats.total }}</span></span>
            <span class="stat-pill" title="Only Unrated (avoids skipped & rejected)" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.4); color: #60a5fa;">🎯 Unrated: <span id="stat-unrated">{{ stats.unrated }}</span></span>
            <span class="stat-pill pill-included" title="Included in Game Show">👍 <span id="stat-included">{{ stats.included }}</span></span>
            <span class="stat-pill pill-excluded" title="Rejected / Excluded">👎 <span id="stat-excluded">{{ stats.excluded }}</span></span>
            <span class="stat-pill" title="Skipped for later" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #f59e0b;">⏭️ Skipped: <span id="stat-skipped">{{ stats.skipped }}</span></span>
            <span class="stat-pill pill-fav" title="Starred Favorites">⭐ <span id="stat-fav">{{ stats.favorites }}</span></span>
        </div>

        <!-- Compact Filters -->
        <form method="GET" action="{{ path('app_moderation_review') }}" class="filter-items-group" id="review-filter-form">
            <select name="status" class="form-select-xs" onchange="this.form.submit()" id="status-filter-select">
                <option value="unrated" {% if status == 'unrated' or status == 'avoid_selected' or not status %}selected{% endif %}>🎯 Only Unrated ({{ stats.unrated }})</option>
                <option value="skipped" {% if status == 'skipped' %}selected{% endif %}>⏭️ Skipped ({{ stats.skipped }})</option>
                <option value="included" {% if status == 'included' %}selected{% endif %}>👍 Selected (Included) ({{ stats.included }})</option>
                <option value="excluded" {% if status == 'excluded' %}selected{% endif %}>👎 Rejected (Excluded) ({{ stats.excluded }})</option>
                <option value="all" {% if status == 'all' %}selected{% endif %}>📚 All Questions ({{ stats.total }})</option>
            </select>

            <select name="category_id" class="form-select-xs" onchange="this.form.submit()">
                <option value="0">All Categories</option>
                {% for c in categories %}
                    <option value="{{ c.id }}" {% if selected_cat == c.id %}selected{% endif %}>{{ c.icon }} {{ c.name }}</option>
                {% endfor %}
            </select>

            <select name="difficulty" class="form-select-xs" onchange="this.form.submit()">
                <option value="all">All Difficulties</option>
                <option value="Simple" {% if difficulty == 'Simple' %}selected{% endif %}>Simple</option>
                <option value="Medium" {% if difficulty == 'Medium' %}selected{% endif %}>Medium</option>
                <option value="Hard" {% if difficulty == 'Hard' %}selected{% endif %}>Hard</option>
            </select>

            <input type="text" name="q" value="{{ search }}" class="form-input-xs" placeholder="Search..." style="width: 110px;">
            <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.25rem 0.5rem; font-size: 0.78rem;">Go</button>
            <a href="{{ path('app_moderation_duplicates') }}" class="btn btn-secondary btn-sm" style="padding: 0.25rem 0.6rem; font-size: 0.78rem; border-color: rgba(245, 158, 11, 0.4); color: #f59e0b;" title="Manage Duplicates">🔍 Duplicates</a>

            <label style="font-size: 0.78rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; color: var(--text-sub);" title="Automatically advance to next question after voting">
                <input type="checkbox" id="auto-advance-toggle" checked>
                ⚡ Auto
            </label>

            {% if (status and status != 'unrated' and status != 'avoid_selected') or selected_cat != 0 or (difficulty and difficulty != 'all') or search %}
                <a href="{{ path('app_moderation_review') }}" class="btn btn-danger btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Reset</a>
            {% endif %}
        </form>
    </div>

    <!-- 2-COLUMN SINGLE-SCREEN WORKSPACE -->
    <div class="review-workspace" id="review-workspace">
        
        <!-- LEFT COLUMN: PUZZLE VISUAL & AI STUDIO BUTTON -->
        <div class="puzzle-visual-pane" id="puzzle-visual-pane">
            <!-- Meta Bar -->
            <div class="visual-top-meta">
                <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <span class="badge" id="card-cat-badge" style="background: var(--primary); color: #000; font-weight: 800;">Category</span>
                    <span class="badge" id="card-diff-badge" style="background: rgba(255,255,255,0.1); color: #fff;">Medium</span>
                    <span id="skipped-badge" class="badge" style="display: none; background: rgba(245, 158, 11, 0.2); border: 1px solid var(--accent); color: var(--accent); font-weight: 800;">
                        ⏭️ Postponed
                    </span>
                    <span id="excluded-queue-badge" class="badge" style="display: none; background: rgba(239, 68, 68, 0.2); border: 1px solid var(--danger); color: var(--danger); font-weight: 800;">
                        👎 Excluded (End of Queue)
                    </span>
                </div>

                <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <span id="card-status-badge" class="status-badge status-included">👍 Included</span>
                    <button type="button" class="btn btn-secondary btn-sm" id="card-fav-btn" onclick="toggleCurrentFav()" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">
                        ⭐ Star
                    </button>
                </div>
            </div>

            <!-- Puzzle Image Container (Fills available height) -->
            <div class="media-box-container">
                <img src="" alt="Rebus Puzzle Image" class="puzzle-media-image" id="card-img" onclick="openEnlargedImageModal()" title="Click to view full size (Hotkey: Z)">
                <div class="image-overlay-controls">
                    <span id="img-dim-badge" class="badge" style="background: rgba(0,0,0,0.7); color: #e2e8f0; font-size: 0.72rem; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(4px);"></span>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="openEnlargedImageModal()" title="View full size (Hotkey: Z)" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);">
                        🔍 Zoom
                    </button>
                </div>
            </div>

            <!-- AI Action Bar (Prominently Placed Directly Under Image) -->
            <div class="ai-action-bar">
                <div style="display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap;">
                    <button type="button" class="btn-ai-studio" onclick="openAiStudioModal()" id="btn-open-ai-studio" title="Generate bespoke Rebus puzzle graphics using AI">
                        <span>✨</span> AI Rebus Image Studio
                    </button>
                    <button type="button" class="btn-upgrade-res" onclick="openUpgradeResolutionModal()" id="btn-upgrade-res" title="Upgrade image resolution via scaling or regeneration">
                        <span>⚡</span> Upgrade Resolution
                    </button>
                </div>

                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="restoreOriginalImage()" id="btn-restore-img" style="display: none; padding: 0.35rem 0.65rem; font-size: 0.78rem;">
                        ↩️ Restore Original
                    </button>
                    <span id="ai-active-badge" class="badge" style="display: none; background: rgba(147, 51, 234, 0.25); border: 1px solid #a855f7; color: #c084fc;">
                        ✨ AI Rebus
                    </span>
                    <span id="upscaled-active-badge" class="badge" style="display: none; background: rgba(14, 165, 233, 0.25); border: 1px solid #38bdf8; color: #38bdf8;">
                        ⚡ HD Scaled
                    </span>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: CONTROLS, ANSWER, VOTING & NAVIGATION -->
        <div class="controls-pane" id="controls-pane">
            <!-- Top: Question Prompt & Clues -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                    <div id="card-prompt" style="font-size: 1.15rem; font-weight: 800; color: #fff;">
                        Say what you see!
                    </div>
                    <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;" id="card-id-tag">#0</span>
                </div>
                <div id="card-hint" style="color: var(--text-muted); font-size: 0.9rem; font-style: italic; min-height: 1.2rem;"></div>
            </div>

            <!-- Middle: Answer Box & Reveal Controls -->
            <div>
                <!-- Answer Reveal Card -->
                <div class="answer-card" id="card-answer-box">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                        <div>
                            <div style="font-size: 0.75rem; font-weight: 700; color: var(--success); text-transform: uppercase;">Correct Solution:</div>
                            <div class="answer-text" id="card-answer-text">ANSWER</div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="openEditAnswerModal()" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;" title="Edit solution and clues">
                            ✏️ Edit
                        </button>
                    </div>
                    <div id="card-alts-text" style="font-size: 0.82rem; color: var(--text-sub); margin-top: 0.25rem;"></div>
                </div>

                <!-- Answer Edit & Toggle Controls -->
                <div style="display: flex; gap: 0.5rem; width: 100%;">
                    <button type="button" class="btn btn-primary" onclick="openEditAnswerModal()" style="flex: 2; padding: 0.65rem 1rem; font-size: 0.95rem; font-weight: 700;" title="Edit question, answer, and clues">
                        ✏️ Edit Solution &amp; Clues
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="reveal-btn" onclick="toggleAnswer()" style="flex: 1; padding: 0.65rem 0.75rem; font-size: 0.82rem;" title="Toggle answer visibility (Spacebar)">
                        🙈 Hide <span style="font-size: 0.72rem; opacity: 0.75;">(Space)</span>
                    </button>
                </div>
            </div>

            <!-- DECISION VOTING BAR (Thumbs Up, Skip, Thumbs Down) -->
            <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.35rem;">Game Show Decision:</div>
                <div class="decision-bar">
                    <button type="button" class="btn-vote btn-vote-up" id="btn-thumbs-up" onclick="voteCurrent(1)">
                        <span>👍 Include</span>
                        <span class="key-hint">[U] or [↑]</span>
                    </button>

                    <button type="button" class="btn-vote btn-vote-skip" id="btn-skip-question" onclick="skipCurrent()">
                        <span>⏭️ Skip</span>
                        <span class="key-hint">[S] Postpone</span>
                    </button>

                    <button type="button" class="btn-vote btn-vote-down" id="btn-thumbs-down" onclick="voteCurrent(0)">
                        <span>👎 Exclude</span>
                        <span class="key-hint">[D] or [↓]</span>
                    </button>
                </div>
            </div>

            <!-- Bottom: Navigation & Progress -->
            <div>
                <div class="nav-controls-row">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-prev" onclick="prevSlide()" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">
                        ← Prev
                    </button>

                    <div style="display: flex; align-items: center; flex: 1; justify-content: center;">
                        <span style="font-size: 0.85rem; font-weight: 800; color: #fff; white-space: nowrap;">
                            <span id="current-idx-display">1</span> / <span id="total-count-display">{{ questions|length }}</span>
                        </span>
                        <div class="progress-bar-wrapper">
                            <div class="progress-bar-fill" id="progress-bar"></div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 0.35rem; align-items: center;">
                        <input type="number" id="jump-input" class="form-input-xs" min="1" max="{{ questions|length }}" style="width: 50px; text-align: center; padding: 0.25rem;">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="jumpToSlide()" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">Go</button>
                        <button type="button" class="btn btn-secondary btn-sm" id="btn-next" onclick="nextSlide()" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">
                            Next →
                        </button>
                    </div>
                </div>

                <!-- Hotkey cheat sheet -->
                <div class="hotkey-bar">
                    <span><span class="kbd">↑</span>/U Include</span>
                    <span><span class="kbd">S</span> Skip</span>
                    <span><span class="kbd">↓</span>/D Exclude</span>
                    <span><span class="kbd">Z</span> Zoom</span>
                    <span><span class="kbd">Space</span> Reveal</span>
                    <span><span class="kbd">E</span> Edit</span>
                    <span><span class="kbd">←</span>/→ Nav</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EDIT ANSWER MODAL DIALOG -->
<dialog id="edit-answer-modal" class="ai-studio-modal" style="max-width: 550px;">
    <div class="ai-modal-header">
        <div>
