<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ show.name }} | TV Display</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800;900&family=Bungee&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0a0807;
            --bg-panel: #16120e;
            --bg-card: #201a15;
            --border-color: #382e25;
            --primary: #f97316;
            --accent: #f59e0b;
            --danger: #ef4444;
            --success: #10b981;
            --gold: #fbbf24;
            --silver: #cbd5e1;
            --bronze: #d97706;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: #fff;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        header.tv-header {
            padding: 0.9rem 2rem;
            background: linear-gradient(180deg, rgba(28, 24, 21, 0.98) 0%, rgba(16, 13, 11, 0.9) 100%);
            border-bottom: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            z-index: 10;
        }

        .show-title-group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.45rem;
            min-width: 0;
            flex: 1;
        }

        .show-title {
            font-family: 'Bungee', cursive, sans-serif;
            font-size: clamp(1.4rem, 2.2vw, 2.1rem);
            color: var(--primary);
            letter-spacing: 1.5px;
            text-shadow: 0 4px 20px rgba(249, 115, 22, 0.5);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.15;
        }

        .tv-round-bubble {
            display: inline-flex;
            flex-direction: row;
            align-items: center;
            gap: 0.65rem;
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(249, 115, 22, 0.1) 100%);
            border: 1.5px solid rgba(245, 158, 11, 0.45);
            border-radius: 20px;
            padding: 0.35rem 1.15rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
            max-width: 100%;
            white-space: nowrap;
        }

        .tv-round-title {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 1.05rem;
            font-weight: 800;
            color: #fbbf24;
            letter-spacing: 0.4px;
            line-height: 1;
            text-shadow: 0 2px 10px rgba(245, 158, 11, 0.3);
            white-space: nowrap;
        }

        .tv-round-divider {
            color: rgba(251, 191, 36, 0.45);
            font-size: 0.95rem;
            font-weight: 900;
        }

        .tv-round-cat {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            color: #ffedd5;
            letter-spacing: 0.3px;
            line-height: 1;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            opacity: 0.95;
            white-space: nowrap;
        }

        .timer-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tv-sound-btn {
            background: rgba(255, 255, 255, 0.07);
            border: 1.5px solid rgba(245, 158, 11, 0.4);
            color: #fbbf24;
            padding: 0.45rem 0.9rem;
            border-radius: 12px;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 0.9rem;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
        }

        .tv-sound-btn:hover {
            background: rgba(245, 158, 11, 0.18);
            border-color: var(--accent);
        }

        .tv-sound-btn.muted {
            border-color: rgba(148, 163, 184, 0.3);
            color: #94a3b8;
        }

        .timer-label {
            font-size: 0.95rem;
            font-weight: 800;
            color: #94a3b8;
            letter-spacing: 1px;
        }

        .timer-box {
            font-family: 'Bungee', monospace;
            font-size: 3.2rem;
            color: var(--accent);
            line-height: 1;
            min-width: 90px;
            text-align: right;
            transition: color 0.2s;
        }

        .timer-box.danger {
            color: var(--danger);
            animation: pulse 0.5s infinite alternate;
        }

        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.12); }
        }

        /* 2-COLUMN LAYOUT: MAIN PUZZLE STAGE (LEFT) + LIVE SCOREBOARD (RIGHT) */
        .tv-content {
            display: grid;
            grid-template-columns: 1fr 380px;
            flex: 1;
            overflow: hidden;
            position: relative;
        }

        .tv-content.splash-fullscreen {
            grid-template-columns: 1fr !important;
        }

        @media (min-width: 1800px) {
            .tv-content {
                grid-template-columns: 1fr 430px;
            }
        }

        main.tv-stage {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 2rem;
            background: radial-gradient(circle at center, #241c15 0%, #0a0807 100%);
            overflow: hidden;
        }

        .puzzle-viewport {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .puzzle-img-card {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            max-width: 95%;
            max-height: 78vh;
        }

        .puzzle-img {
            width: 100%;
            height: auto;
            max-width: 100%;
            max-height: 76vh;
            border-radius: 20px;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.92), 0 0 0 1px rgba(255, 255, 255, 0.08);
            object-fit: contain;
            background: #120e0b;
        }

        .answer-overlay {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            padding: 1.15rem 3.5rem;
            border-radius: 24px;
            font-size: clamp(2.2rem, 3.6vw, 3.5rem);
            font-weight: 900;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85), 0 0 45px rgba(16, 185, 129, 0.65), 0 0 0 3px rgba(255, 255, 255, 0.35);
            text-align: center;
            display: none;
            width: max-content;
            max-width: 90%;
            min-width: min(420px, 90%);
            box-sizing: border-box;
            white-space: normal;
            word-break: normal;
            overflow-wrap: break-word;
            animation: popAnswer 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 50;
            line-height: 1.25;
        }

        @keyframes popAnswer {
            0% { transform: translateX(-50%) scale(0.65) translateY(20px); opacity: 0; }
            100% { transform: translateX(-50%) scale(1) translateY(0); opacity: 1; }
        }

        .splash-card {
            text-align: center;
            color: var(--accent);
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* RIGHT SCOREBOARD SIDEBAR */
        aside.tv-scoreboard {
            background: var(--bg-panel);
            border-left: 2px solid var(--border-color);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.55);
            z-index: 5;
        }

        .scoreboard-header {
            padding: 1.1rem 1.4rem;
            background: linear-gradient(180deg, #261d17 0%, #1c1510 100%);
            border-bottom: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .scoreboard-title {
            font-size: 1.2rem;
            font-weight: 900;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: 0.5px;
        }

        .matchup-callout {
            background: rgba(249, 115, 22, 0.15);
            border-bottom: 1px solid rgba(249, 115, 22, 0.3);
            padding: 0.6rem 1rem;
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--accent);
            text-align: center;
            display: none;
            flex-shrink: 0;
        }

        .teams-list {
            padding: 0.85rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            overflow-y: auto;
            flex: 1;
        }

        .teams-list::-webkit-scrollbar {
            width: 6px;
        }
        .teams-list::-webkit-scrollbar-thumb {
            background: #3d3228;
            border-radius: 3px;
        }

        .team-card-row {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            transition: all 0.25s ease;
            position: relative;
        }

        .team-card-row.rank-1 {
            border-color: rgba(251, 191, 36, 0.55);
            background: linear-gradient(90deg, rgba(251, 191, 36, 0.15) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.rank-2 {
            border-color: rgba(203, 213, 225, 0.45);
            background: linear-gradient(90deg, rgba(203, 213, 225, 0.1) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.rank-3 {
            border-color: rgba(217, 119, 6, 0.45);
            background: linear-gradient(90deg, rgba(217, 119, 6, 0.1) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.eliminated {
            opacity: 0.38;
            filter: grayscale(0.85);
            border-color: rgba(255, 255, 255, 0.06);
            background: #14100d;
        }

        .team-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
            flex: 1;
        }

        .rank-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.92rem;
            font-weight: 800;
            color: #94a3b8;
            width: 26px;
            text-align: center;
            flex-shrink: 0;
        }

        .rank-1 .rank-badge { color: var(--gold); font-size: 1.25rem; }
        .rank-2 .rank-badge { color: var(--silver); font-size: 1.25rem; }
        .rank-3 .rank-badge { color: var(--bronze); font-size: 1.25rem; }

        .team-avatar {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: #120e0b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .team-name-group {
            min-width: 0;
            overflow: hidden;
        }

        .team-name {
            font-weight: 800;
            font-size: 1.05rem;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .team-sub {
            font-size: 0.78rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .team-score-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.3rem;
            font-weight: 900;
            color: var(--accent);
            background: #100d0a;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.3rem 0.7rem;
            flex-shrink: 0;
            text-align: right;
            min-width: 62px;
        }

        .rank-1 .team-score-badge {
            color: #fbbf24;
            border-color: rgba(251, 191, 36, 0.45);
            box-shadow: 0 0 14px rgba(251, 191, 36, 0.25);
        }

        .eliminated-tag {
            font-size: 0.65rem;
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.4);
            border-radius: 6px;
            padding: 0.1rem 0.4rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* TV RULES PRESENTATION CARD */
        .tv-rules-card {
            background: linear-gradient(145deg, rgba(32, 26, 21, 0.96) 0%, rgba(18, 14, 11, 0.99) 100%);
            border: 2px solid rgba(245, 158, 11, 0.45);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 50px rgba(245, 158, 11, 0.18);
            border-radius: 28px;
            padding: 3rem 3.5rem;
            max-width: 900px;
            width: 92%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            animation: zoomInRule 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes zoomInRule {
            0% { transform: scale(0.92); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .tv-rules-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tv-rules-badge {
            font-size: 0.95rem;
            font-weight: 900;
            letter-spacing: 1.5px;
            color: var(--primary);
            text-transform: uppercase;
        }

        .tv-rules-step {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1rem;
            font-weight: 800;
            background: rgba(245, 158, 11, 0.2);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: var(--accent);
            padding: 0.35rem 1rem;
            border-radius: 20px;
            letter-spacing: 1px;
        }

        .tv-rules-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            margin: 0.5rem 0 1.5rem 0;
        }

        .tv-rules-icon-glow {
            font-size: 4.8rem;
            width: 105px;
            height: 105px;
            border-radius: 28px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(249, 115, 22, 0.08) 70%);
            border: 2px solid rgba(245, 158, 11, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 35px rgba(245, 158, 11, 0.3);
            animation: pulseIcon 2.5s infinite ease-in-out;
        }

        @keyframes pulseIcon {
            0%, 100% { transform: scale(1); box-shadow: 0 0 30px rgba(245, 158, 11, 0.25); }
            50% { transform: scale(1.06); box-shadow: 0 0 45px rgba(245, 158, 11, 0.45); }
        }

        .tv-rules-title {
            font-size: clamp(2.2rem, 3.2vw, 3.2rem);
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 1.25rem;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }

        .tv-rules-desc {
            font-size: clamp(1.25rem, 1.7vw, 1.65rem);
            line-height: 1.6;
            color: #cbd5e1;
            max-width: 780px;
            margin: 0 auto;
        }

        .tv-rules-footer {
            width: 100%;
            display: flex;
            justify-content: center;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .tv-rules-dots {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .rule-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .rule-dot.active {
            background: var(--accent);
            box-shadow: 0 0 14px var(--accent);
            transform: scale(1.35);
        }

        .rule-dot.completed {
            background: var(--success);
        }

        footer.tv-footer {
            flex-shrink: 0;
            padding: 0.5rem 1.5rem;
            background: linear-gradient(180deg, rgba(20, 16, 13, 0.95) 0%, rgba(10, 8, 7, 0.98) 100%);
            border-top: 1px solid var(--border-color);
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            z-index: 10;
        }
    </style>
</head>
<body>
    <header class="tv-header">
        <div class="show-title-group">
            <div class="show-title">🍁 {{ show.name }}</div>
            <div class="tv-round-bubble" id="tv-round-bubble">
                <span class="tv-round-title" id="tv-round">Round 1</span>
                <span class="tv-round-divider" id="tv-round-divider" style="display: none;">•</span>
                <span class="tv-round-cat" id="tv-cat" style="display: none;">Classic Dingbats</span>
            </div>
        </div>
        <div class="timer-container">
            <button type="button" class="tv-sound-btn" id="tv-sound-btn" onclick="toggleTvSound()" title="Toggle TV Sound Effects">
                🔊 Sound
            </button>
            <span class="timer-label">TIMER</span>
            <div class="timer-box" id="tv-timer">25</div>
        </div>
    </header>

    <div class="tv-content">
        <!-- LEFT: PUZZLE STAGE -->
        <main class="tv-stage">
            <div class="puzzle-viewport">
                <!-- TV RULES BRIEFING CARD -->
                <div class="tv-rules-card" id="tv-rules-card" style="display: none;">
                    <div class="tv-rules-header">
                        <span class="tv-rules-badge">📜 OFFICIAL TOURNAMENT RULES</span>
                        <span class="tv-rules-step" id="tv-rule-step">RULE 1 OF 6</span>
                    </div>
                    <div class="tv-rules-body">
                        <div class="tv-rules-icon-glow" id="tv-rule-icon">💡</div>
                        <h2 class="tv-rules-title" id="tv-rule-title">Say What You See</h2>
                        <p class="tv-rules-desc" id="tv-rule-desc">Call out the famous phrase, movie, object, or idiom hidden in the picture puzzle.</p>
                    </div>
                    <div class="tv-rules-footer">
                        <div class="tv-rules-dots" id="tv-rules-dots">
                            <!-- Progress dots rendered dynamically -->
                        </div>
                    </div>
                </div>

                <div class="puzzle-img-card" id="tv-img-card" style="display: none;">
                    <img src="" alt="Rebus" class="puzzle-img" id="tv-img">
                </div>

                <div class="answer-overlay" id="tv-answer">ANSWER</div>

                <!-- END OF ROUND ANNOUNCEMENT CARD -->
                <div class="splash-card" id="tv-round-end-card" style="display: none; max-width: 820px; width: 92%; padding: 2.2rem 2.5rem; border: 2px solid var(--accent); box-shadow: 0 20px 60px rgba(0,0,0,0.85);">
                    <div id="tv-end-badge" style="display: inline-block; background: rgba(245, 158, 11, 0.2); border: 1.5px solid var(--accent); color: var(--accent); font-weight: 900; font-size: 0.95rem; padding: 0.35rem 1.2rem; border-radius: 999px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 0.75rem;">
                        🏁 ROUND COMPLETE
                    </div>
                    <h1 id="tv-end-title" style="font-size: 3rem; font-weight: 900; letter-spacing: 1px; color: #fff; margin: 0 0 0.35rem 0;">END OF ROUND 1</h1>
                    <p id="tv-end-subtitle" style="font-size: 1.35rem; color: #cbd5e1; font-weight: 700; margin: 0 0 1.35rem 0;">All round puzzles completed!</p>

                    <!-- UP NEXT ROUND BRIEFING & RULES PREVIEW -->
                    <div id="tv-next-round-box" style="background: rgba(15, 23, 42, 0.75); border: 1.5px solid rgba(249, 115, 22, 0.45); border-radius: 16px; padding: 1.25rem 1.5rem; text-align: left;">
                        <div style="font-size: 0.85rem; font-weight: 900; color: var(--primary); text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 0.35rem;" id="tv-next-round-label">
                            ⏭️ UP NEXT • ROUND 2 BRIEFING &amp; RULES
                        </div>
                        <div style="font-size: 1.55rem; font-weight: 900; color: #fff; margin-bottom: 0.85rem;" id="tv-next-round-name">
                            Round 2: Flight Battles
                        </div>
                        <div id="tv-next-round-stats" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 0.75rem;">
                            <!-- Populated dynamically: Timer, Points, Steal, Questions -->
                        </div>
                        <div id="tv-next-round-cats" style="font-size: 0.95rem; color: #cbd5e1; font-weight: 600;"></div>
                    </div>
                </div>

                <!-- WELCOME SPLASH SCREEN (STAGE 1: ONLY ON TV SCREEN) -->
                <div class="splash-card" id="tv-welcome-splash-card" style="display: none; max-width: 1120px; width: 95%; padding: 1.5rem 2rem; background: linear-gradient(145deg, rgba(32, 26, 21, 0.96) 0%, rgba(18, 14, 11, 0.99) 100%); border: 2.5px solid rgba(245, 158, 11, 0.55); border-radius: 28px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.92), 0 0 60px rgba(249, 115, 22, 0.22);">
                    <div style="display: inline-block; background: rgba(249, 115, 22, 0.2); border: 1.5px solid rgba(249, 115, 22, 0.55); color: var(--accent); font-weight: 900; font-size: 0.9rem; padding: 0.3rem 1.25rem; border-radius: 999px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.65rem;">
                        🍁 WELCOME TO THE TOURNAMENT ARENA
                    </div>
                    <h1 style="font-size: clamp(2.1rem, 3.2vw, 3.1rem); font-weight: 900; letter-spacing: 1px; color: #fff; margin: 0 0 0.25rem 0; text-shadow: 0 4px 20px rgba(0,0,0,0.6);">
                        {{ show.name }}
                    </h1>
                    <p style="font-size: 1.15rem; color: #cbd5e1; font-weight: 700; margin: 0 0 1rem 0;">
                        {{ show.description ?? show.subtitle ?? 'Say What You See • Couple Edition Rebus Championship!' }}
                    </p>
                    <div style="display: flex; justify-content: center; align-items: center; margin-bottom: 0.85rem;">
                        <img src="/media/khapre_party_splash.jpg" alt="Khapre Party Splash" style="max-height: 54vh; max-width: 100%; width: auto; border-radius: 20px; border: 3px solid rgba(251, 191, 36, 0.55); box-shadow: 0 20px 55px rgba(0,0,0,0.85); object-fit: contain;">
                    </div>
                    <div style="display: inline-flex; align-items: center; gap: 0.65rem; background: rgba(245, 158, 11, 0.16); border: 1.5px solid rgba(245, 158, 11, 0.45); padding: 0.55rem 1.5rem; border-radius: 999px; font-weight: 800; font-size: 1rem; color: var(--accent);">
                        🎉 Get Ready! Host Will Unveil Competing Teams &amp; Rules Shortly
                    </div>
                </div>

                <!-- COMPETING TEAMS LINEUP CARD (STAGE 2: TEAMS UNVEILED ON TV) -->
                <div class="splash-card" id="tv-teams-intro-card" style="display: none; max-width: 1060px; width: 95%; padding: 2rem 2.5rem; background: linear-gradient(145deg, rgba(32, 26, 21, 0.96) 0%, rgba(18, 14, 11, 0.99) 100%); border: 2px solid rgba(249, 115, 22, 0.5); border-radius: 28px; box-shadow: 0 25px 70px rgba(0,0,0,0.9);">
                    <div style="display: inline-block; background: rgba(249, 115, 22, 0.2); border: 1.5px solid rgba(249, 115, 22, 0.55); color: var(--primary); font-weight: 900; font-size: 0.9rem; padding: 0.35rem 1.25rem; border-radius: 999px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 0.6rem;">
                        👥 OFFICIAL CONTESTANT LINEUP
                    </div>
                    <h1 style="font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 900; color: #fff; margin: 0 0 0.35rem 0;">
                        MEET TONIGHT'S COMPETING TEAMS
                    </h1>
                    <p style="font-size: 1.15rem; color: #cbd5e1; margin: 0 0 1.35rem 0;">
                         Let's hear it for our competing couples &amp; challengers!
                    </p>
                    <div id="tv-teams-showcase-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.85rem; text-align: left; max-height: 52vh; overflow-y: auto; padding: 0.25rem;">
                        <!-- Populated dynamically with competing teams -->
                    </div>
                </div>

                <!-- ROUND INTRO / SPLASH CARD -->
                <div class="splash-card" id="tv-splash" style="display: none; max-width: 820px; width: 92%; padding: 2.2rem 2.5rem;">
                    <div style="font-size: 4rem; margin-bottom: 0.5rem;" id="tv-splash-icon">🍁</div>
                    <div id="tv-splash-badge" style="display: inline-block; background: rgba(249, 115, 22, 0.18); border: 1.5px solid rgba(249, 115, 22, 0.45); color: var(--primary); font-weight: 900; font-size: 0.9rem; padding: 0.3rem 1.1rem; border-radius: 999px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 0.6rem;">
                        ROUND 1 BRIEFING &amp; FORMAT
                    </div>
                    <h1 id="tv-splash-title" style="font-size: 2.6rem; font-weight: 900; letter-spacing: 1px; margin: 0 0 0.4rem 0;">FALL PARTY REBUS ARENA</h1>
                    <p id="tv-splash-sub" style="font-size: 1.25rem; color: #cbd5e1; margin: 0 0 1.25rem 0;">Say What You See!</p>
                    <div id="tv-splash-stats" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1rem;"></div>
                    <div id="tv-splash-cats" style="font-size: 0.95rem; color: #cbd5e1; font-weight: 600; margin-bottom: 1.25rem;"></div>
                    <div style="display: inline-flex; align-items: center; gap: 0.75rem; background: rgba(245, 158, 11, 0.15); border: 1.5px solid rgba(245, 158, 11, 0.4); padding: 0.7rem 1.75rem; border-radius: 30px; font-weight: 800; font-size: 1.05rem; color: var(--accent);">
                        🎮 Waiting for Host to Start Round!
                    </div>
                </div>
            </div>
        </main>

        <!-- RIGHT: LIVE SCOREBOARD -->
        <aside class="tv-scoreboard" id="tv-scoreboard-aside">
            <div class="scoreboard-header">
                <span class="scoreboard-title">🏆 Live Scores</span>
                <span style="font-size: 0.85rem; font-weight: 700; color: #94a3b8;" id="tv-team-count">10 Teams</span>
            </div>
            <div class="matchup-callout" id="tv-matchup">
                <!-- e.g. Acorn Flight Matchup: Team A vs Team B -->
            </div>
            <div class="teams-list" id="tv-teams">
                <!-- Dynamically populated and sorted by score -->
            </div>
        </aside>
    </div>

    <footer class="tv-footer">
        Fall Party Rebus Gameshow - Copyrights (c) Vishal Khapre, Crafted with Natural Intelligence and powered by Artificial Intelligence
    </footer>

    <script src="/js/sounds.js"></script>
    <script>
        const SHOW_ID = {{ show.id }};
        let tvSoundEnabled = true;
        let tvTimerInterval = null;
        let tvRemainingSeconds = 25;
        let activeTimerStartStamp = null;
        let timeUpBuzzerPlayedForStamp = null;

        let hasInitializedTvState = false;
        let prevQuestionId = null;
        let prevQuestionStartedAt = null;
        let prevAnswerRevealed = 0;
        let prevRoundId = null;
        let prevRoundCompleted = false;
        let prevTeamScoreSum = 0;
        let prevShowStatus = null;
        let prevActiveRuleIdx = -1;

        function toggleTvSound() {
            tvSoundEnabled = !tvSoundEnabled;
            if (window.soundFX) {
                window.soundFX.enabled = tvSoundEnabled;
                if (tvSoundEnabled) {
                    window.soundFX.init();
                    window.soundFX.playTick();
                }
            }
            const btn = document.getElementById('tv-sound-btn');
            if (btn) {
                btn.innerText = tvSoundEnabled ? '🔊 Sound' : '🔇 Muted';
                btn.classList.toggle('muted', !tvSoundEnabled);
            }
        }

        function updateTvTimerBox(sec) {
            const box = document.getElementById('tv-timer');
            if (!box) return;
            box.innerText = sec;
            if (sec <= 5) {
                box.classList.add('danger');
            } else {
                box.classList.remove('danger');
            }
        }

        function startTvClientTimer(startedAt, duration) {
            const elapsed = Math.floor(Date.now() / 1000) - startedAt;
            tvRemainingSeconds = Math.max(0, (duration || 25) - elapsed);
            updateTvTimerBox(tvRemainingSeconds);

            if (activeTimerStartStamp === startedAt && tvTimerInterval) {
                return;
            }

            activeTimerStartStamp = startedAt;
            clearInterval(tvTimerInterval);

            tvTimerInterval = setInterval(() => {
                const nowElapsed = Math.floor(Date.now() / 1000) - startedAt;
                const nextRem = Math.max(0, (duration || 25) - nowElapsed);

                if (nextRem !== tvRemainingSeconds) {
                    tvRemainingSeconds = nextRem;
                    updateTvTimerBox(tvRemainingSeconds);

                    if (tvRemainingSeconds > 0 && tvRemainingSeconds <= 5 && window.soundFX) {
                        window.soundFX.playWarningTick();
                    }

                    if (tvRemainingSeconds === 0) {
                        clearInterval(tvTimerInterval);
                        tvTimerInterval = null;
                        if (timeUpBuzzerPlayedForStamp !== startedAt && window.soundFX) {
                            timeUpBuzzerPlayedForStamp = startedAt;
                            window.soundFX.playTimeUpBuzzer();
                        }
                    }
                }
            }, 250);
        }

        function stopTvClientTimer(defaultSec) {
            clearInterval(tvTimerInterval);
            tvTimerInterval = null;
            activeTimerStartStamp = null;
            const box = document.getElementById('tv-timer');
            if (box) {
                box.innerText = defaultSec || 25;
                box.classList.remove('danger');
            }
        }

        function syncDisplay() {
            fetch(`/api/shows/${SHOW_ID}/state`)
                .then(res => res.json())
                .then(data => {
                    const show = data.show;
                    const q = data.current_question;
                    const round = data.current_round;

                    if (round) {
                        document.getElementById('tv-round').innerText = round.name;
                    }

                    const catBadge = document.getElementById('tv-cat');
                    const roundDivider = document.getElementById('tv-round-divider');
                    const imgCard = document.getElementById('tv-img-card');
                    const img = document.getElementById('tv-img');
                    const ansBanner = document.getElementById('tv-answer');
                    const welcomeSplashCard = document.getElementById('tv-welcome-splash-card');
                    const teamsIntroCard = document.getElementById('tv-teams-intro-card');
                    const splash = document.getElementById('tv-splash');
                    const roundEndCard = document.getElementById('tv-round-end-card');
                    const rulesCard = document.getElementById('tv-rules-card');
                    const tvContentGrid = document.querySelector('.tv-content');
                    const scoreboardAside = document.getElementById('tv-scoreboard-aside');
                    const rulesList = Array.isArray(data.rules) ? data.rules : [];
                    const activeRuleIdx = (show.active_rule_index !== undefined && show.active_rule_index !== null) ? parseInt(show.active_rule_index) : -1;
                    const rProg = data.round_progress || {};
                    const showStatus = show.status || 'setup';

                    function buildDynamicRoundDescription(rObj) {
                        if (!rObj) return '';
                        if (rObj.settings_summary) return rObj.settings_summary;
                        const typeLabel = rObj.round_type === 'rapid_fire'
                            ? '⚡ Rapid Fire (All Remaining Starred Puzzles)'
                            : (rObj.round_type === 'head_to_head' ? 'Head-to-Head Flight Matchup' : 'All Teams Open Play');
                        const timerSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                        const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                        const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                        const advLabel = rObj.advancement_type === 'top_x'
                            ? `Top ${rObj.advance_top_x} Teams Advance`
                            : 'All Advance';
                        return `Type: ${typeLabel} • Timer: ${timerSec}s • Points: +${pts} (Steal: +${steal}) • Advancement: ${advLabel}`;
                    }

                    function buildRoundStatsHtml(rObj) {
                        if (!rObj) return '';
                        const timerSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                        const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                        const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                        const totalQ = rObj.total_questions || (Array.isArray(rObj.category_allocations) ? rObj.category_allocations.reduce((s, a) => s + (parseInt(a.count) || 0), 0) : 0);
                        const tileStyle = 'background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 0.65rem 0.5rem; text-align: center;';
                        return `
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">⏱️ Timer</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #38bdf8; margin-top: 0.15rem;">${timerSec}s</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">🏆 Win Points</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #10b981; margin-top: 0.15rem;">+${pts} pts</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">⚡ Steal</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #f59e0b; margin-top: 0.15rem;">+${steal} pts</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">🧩 Puzzles</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #fff; margin-top: 0.15rem;">${totalQ || 'All'}</div>
                            </div>
                        `;
                    }

                    function buildRoundMetaSummary(rObj) {
                        if (!rObj) return '';
                        const dynDesc = buildDynamicRoundDescription(rObj);
                        const allocs = Array.isArray(rObj.category_allocations) ? rObj.category_allocations : [];
                        const catPills = allocs.map(a => `${a.category_icon || '🧩'} ${a.category_name || 'Category'} (${a.count})`).join('  •  ');
                        return `<div style="margin-bottom: 0.35rem; color: #f8fafc;">${dynDesc}</div>` +
                            (catPills ? `<div style="font-size: 0.85rem; color: #94a3b8;">Categories: ${catPills}</div>` : '');
                    }

                    // Determine if we are on the initial Welcome Splash Screen (hide teams scoreboard until host clicks Next)
                    const isWelcomeSplashStage = (!q && activeRuleIdx < 0 && !rProg.is_completed && showStatus === 'setup');
                    const isTeamsIntroStage = (!q && activeRuleIdx < 0 && !rProg.is_completed && showStatus === 'teams_intro');

                    if (isWelcomeSplashStage) {
                        if (scoreboardAside) scoreboardAside.style.display = 'none';
                        if (tvContentGrid) tvContentGrid.classList.add('splash-fullscreen');
                        document.getElementById('tv-round').innerText = 'Welcome Splash';
                    } else {
                        if (scoreboardAside) scoreboardAside.style.display = 'flex';
                        if (tvContentGrid) tvContentGrid.classList.remove('splash-fullscreen');
                        if (isTeamsIntroStage) {
                            document.getElementById('tv-round').innerText = 'Competing Teams';
                        } else if (activeRuleIdx >= 0) {
                            document.getElementById('tv-round').innerText = 'Tournament Rules';
                        } else if (round) {
                            document.getElementById('tv-round').innerText = round.name;
                        }
                    }

                    if (activeRuleIdx >= 0 && rulesList.length > 0 && activeRuleIdx < rulesList.length) {
                        const activeRule = rulesList[activeRuleIdx];
                        if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                        if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                        splash.style.display = 'none';
                        if (roundEndCard) roundEndCard.style.display = 'none';
                        imgCard.style.display = 'none';
                        ansBanner.style.display = 'none';
                        catBadge.style.display = 'none';
                        if (roundDivider) roundDivider.style.display = 'none';
                        rulesCard.style.display = 'flex';

                        document.getElementById('tv-rule-step').innerText = `RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
                        document.getElementById('tv-rule-icon').innerText = activeRule.icon || '📜';
                        document.getElementById('tv-rule-title').innerText = activeRule.title;
                        document.getElementById('tv-rule-desc').innerText = activeRule.description;

                        const dotsWrap = document.getElementById('tv-rules-dots');
                        dotsWrap.innerHTML = '';
                        rulesList.forEach((_, idx) => {
                            const dot = document.createElement('div');
                            dot.className = 'rule-dot' + (idx === activeRuleIdx ? ' active' : (idx < activeRuleIdx ? ' completed' : ''));
                            dotsWrap.appendChild(dot);
                        });
                    } else {
                        rulesCard.style.display = 'none';

                        if (q) {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            imgCard.style.display = 'flex';
                            img.src = q.media_path;

                            if (q.category_name) {
                                const qProgress = (rProg.total > 0) ? ` (${rProg.used}/${rProg.total})` : '';
                                catBadge.innerText = `${q.category_icon || '🧩'} ${q.category_name}${qProgress}`;
                                catBadge.style.display = 'inline-flex';
                                if (roundDivider) roundDivider.style.display = 'inline';
                            } else {
                                catBadge.style.display = 'none';
                                if (roundDivider) roundDivider.style.display = 'none';
                            }

                            ansBanner.innerText = q.answer;
                            if (show.answer_revealed == 1) {
                                ansBanner.style.display = 'block';
                            } else {
                                ansBanner.style.display = 'none';
                            }
                        } else if (round && rProg.is_completed) {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (roundEndCard) {
                                roundEndCard.style.display = 'block';
                                const rNum = round.round_number || 1;
                                document.getElementById('tv-end-badge').innerText = `🏁 ROUND ${rNum} COMPLETE • ${rProg.used || rProg.total || 0} PUZZLES FINISHED`;
                                document.getElementById('tv-end-title').innerText = `END OF ROUND ${rNum}`;
                                document.getElementById('tv-end-subtitle').innerText = `${round.name} is complete! Check the live standings on the right.`;

                                const nextR = rProg.next_round;
                                const nextBox = document.getElementById('tv-next-round-box');
                                if (nextR) {
                                    nextBox.style.display = 'block';
                                    document.getElementById('tv-next-round-label').innerText = `⏭️ UP NEXT • ROUND ${nextR.round_number} RULES & INFO`;
                                    document.getElementById('tv-next-round-name').innerText = nextR.name;
                                    document.getElementById('tv-next-round-stats').innerHTML = buildRoundStatsHtml(nextR);
                                    document.getElementById('tv-next-round-cats').innerHTML = buildRoundMetaSummary(nextR);
                                } else {
                                    nextBox.style.display = 'block';
                                    document.getElementById('tv-next-round-label').innerText = '🏆 GRAND CHAMPIONSHIP COMPLETE';
                                    document.getElementById('tv-next-round-name').innerText = 'Congratulations to our Grand Champions!';
                                    document.getElementById('tv-next-round-stats').innerHTML = '';
                                    document.getElementById('tv-next-round-cats').innerHTML = '<div style="color: var(--accent); font-weight: 800;">All tournament rounds have been completed!</div>';
                                }
                            }
                        } else if (isWelcomeSplashStage) {
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'block';
                        } else if (isTeamsIntroStage) {
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (teamsIntroCard) {
                                teamsIntroCard.style.display = 'block';
                                const showcaseGrid = document.getElementById('tv-teams-showcase-grid');
                                if (showcaseGrid) {
                                    showcaseGrid.innerHTML = (data.teams || []).map((t, idx) => `
                                        <div style="background: rgba(255,255,255,0.05); border: 1.5px solid ${t.avatar_color || '#f97316'}; border-radius: 16px; padding: 0.9rem 1.1rem; display: flex; align-items: center; gap: 0.85rem; box-shadow: 0 8px 20px rgba(0,0,0,0.4);">
                                            <div style="width: 52px; height: 52px; border-radius: 14px; background: #120e0b; border: 2px solid ${t.avatar_color || '#f97316'}; display: flex; align-items: center; justify-content: center; font-size: 1.85rem; flex-shrink: 0;">
                                                ${t.avatar_emoji || '🍁'}
                                            </div>
                                            <div style="min-width: 0; flex: 1;">
                                                <div style="font-size: 0.72rem; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 1px;">TEAM #${idx + 1}</div>
                                                <div style="font-size: 1.15rem; font-weight: 900; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${t.name}</div>
                                                ${t.members ? `<div style="font-size: 0.85rem; color: #cbd5e1; font-weight: 600; margin-top: 2px;">${t.members}</div>` : ''}
                                            </div>
                                        </div>
                                    `).join('');
                                }
                            }
                        } else {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            splash.style.display = 'block';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';

                            if (round) {
                                document.getElementById('tv-splash-badge').innerText = `ROUND ${round.round_number || 1} BRIEFING & RULES`;
                                document.getElementById('tv-splash-title').innerText = round.name;
                                document.getElementById('tv-splash-sub').innerText = buildDynamicRoundDescription(round);
                                document.getElementById('tv-splash-stats').innerHTML = buildRoundStatsHtml(round);
                                document.getElementById('tv-splash-cats').innerHTML = buildRoundMetaSummary(round);
                            }
                        }
                    }

                    // Matchup callout
                    const matchupBox = document.getElementById('tv-matchup');
                    if (show.active_matchup_label && show.active_matchup_label.trim() !== '') {
                        matchupBox.innerText = `⚔️ ${show.active_matchup_label}`;
                        matchupBox.style.display = 'block';
                    } else {
                        matchupBox.style.display = 'none';
                    }

                    // Timer Sync (Smooth 1s client countdown + warning ticks & time-up buzzer)
                    if (show.question_started_at && show.answer_revealed == 0 && q) {
                        startTvClientTimer(parseInt(show.question_started_at), parseInt(show.timer_duration) || 25);
                    } else {
                        stopTvClientTimer(parseInt(show.timer_duration) || 25);
                    }

                    // Sound Effect Triggers on TV State Transitions
                    const curQId = q ? q.id : null;
                    const curQStart = show.question_started_at ? parseInt(show.question_started_at) : null;
                    const curRev = parseInt(show.answer_revealed) || 0;
                    const curRId = show.current_round_id ? parseInt(show.current_round_id) : null;
                    const curRDone = !!rProg.is_completed;
                    const curScoreSum = (data.teams || []).reduce((acc, t) => acc + (parseInt(t.score) || 0), 0);

                    if (hasInitializedTvState && window.soundFX) {
                        let playedDingThisTick = false;

                        if (curRev === 1 && prevAnswerRevealed === 0) {
                            window.soundFX.playDingCorrect();
                            playedDingThisTick = true;
                        }
                        if (curScoreSum > prevTeamScoreSum && !playedDingThisTick) {
                            window.soundFX.playDingCorrect();
                            playedDingThisTick = true;
                        }
                        if ((curRDone && !prevRoundCompleted) || (prevRoundId !== null && curRId !== prevRoundId && !curQId) || (showStatus !== prevShowStatus && (showStatus === 'teams_intro' || showStatus === 'round_intro'))) {
                            window.soundFX.playFanfare();
                        } else if (activeRuleIdx >= 0 && activeRuleIdx !== prevActiveRuleIdx) {
                            window.soundFX.playTick();
                        } else if (curQId && (curQId !== prevQuestionId || curQStart !== prevQuestionStartedAt)) {
                            window.soundFX.playTick();
                        }
                    }

                    hasInitializedTvState = true;
                    prevQuestionId = curQId;
                    prevQuestionStartedAt = curQStart;
                    prevAnswerRevealed = curRev;
                    prevRoundId = curRId;
                    prevRoundCompleted = curRDone;
                    prevTeamScoreSum = curScoreSum;
                    prevShowStatus = showStatus;
                    prevActiveRuleIdx = activeRuleIdx;

                    // Right Scoreboard Teams
                    const teamsWrap = document.getElementById('tv-teams');
                    teamsWrap.innerHTML = '';
                    document.getElementById('tv-team-count').innerText = `${data.teams.length} Teams`;

                    // Sort: Active first, highest score on top, stable order for ties
                    const sortedTeams = [...(data.teams || [])].sort((a, b) => {
                        const aElim = (a.is_eliminated == 1) ? 1 : 0;
                        const bElim = (b.is_eliminated == 1) ? 1 : 0;
                        if (aElim !== bElim) return aElim - bElim;

                        const aScore = parseInt(a.score) || 0;
                        const bScore = parseInt(b.score) || 0;
                        if (bScore !== aScore) return bScore - aScore;

                        return (parseInt(a.sort_order) || a.id) - (parseInt(b.sort_order) || b.id);
                    });

                    let rank = 1;
                    sortedTeams.forEach(t => {
                        const isEliminated = (t.is_eliminated == 1);
                        const score = parseInt(t.score) || 0;

                        let rankDisplay = `#${rank}`;
                        let rankClass = '';

                        if (isEliminated) {
                            rankDisplay = '✕';
                        } else {
                            if (score > 0) {
                                if (rank === 1) {
                                    rankDisplay = '🥇';
                                    rankClass = 'rank-1';
                                } else if (rank === 2) {
                                    rankDisplay = '🥈';
                                    rankClass = 'rank-2';
                                } else if (rank === 3) {
                                    rankDisplay = '🥉';
                                    rankClass = 'rank-3';
                                }
                            }
                            rank++;
                        }

                        const row = document.createElement('div');
                        row.className = 'team-card-row ' + (isEliminated ? 'eliminated' : rankClass);
                        const elimBadge = isEliminated ? `<span class="eliminated-tag">OUT</span>` : '';

                        row.innerHTML = `
                            <div class="team-left">
                                <span class="rank-badge">${rankDisplay}</span>
                                <div class="team-avatar" style="border: 2px solid ${t.avatar_color || '#f97316'};">${t.avatar_emoji || '🍁'}</div>
                                <div class="team-name-group">
                                    <div class="team-name">${t.name} ${elimBadge}</div>
                                    ${t.members ? `<div class="team-sub">${t.members}</div>` : ''}
                                </div>
                            </div>
                            <div class="team-score-badge">${score}</div>
                        `;
                        teamsWrap.appendChild(row);
                    });
                });
        }

        syncDisplay();
        setInterval(syncDisplay, 1500);
    </script>
</body>
</html>
