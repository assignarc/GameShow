                        </div>
                    </div>
                    <div class="tv-rules-footer" style="flex-direction: column; gap: 0.85rem; align-items: center;">
                        <div class="tv-rules-dots" id="tv-team-spot-dots"></div>
                        <div id="tv-teams-roster-strip" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; max-width: 100%;"></div>
                    </div>
                </div>

                <!-- ROUND INTRO / SPLASH CARD -->
                <div class="splash-card" id="tv-splash" style="display: none; max-width: 820px; width: 92%; padding: 2.2rem 2.5rem;">
                    <div style="font-size: 4rem; margin-bottom: 0.5rem;" id="tv-splash-icon">🍁</div>
                    <div id="tv-splash-badge" style="display: inline-block; background: rgba(249, 115, 22, 0.18); border: 1.5px solid rgba(249, 115, 22, 0.45); color: var(--primary); font-weight: 900; font-size: 0.9rem; padding: 0.3rem 1.1rem; border-radius: 999px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 0.6rem;">
