                        <h1 class="tv-team-spot-name" id="tv-team-spot-name">Team Name</h1>
                        <div id="tv-team-spot-members" style="font-size: clamp(1.35rem, 2vw, 1.85rem); font-weight: 800; color: #f8fafc; background: rgba(255, 255, 255, 0.07); border: 1.5px solid rgba(255, 255, 255, 0.16); padding: 0.55rem 1.75rem; border-radius: 999px; margin-bottom: 0.9rem;">
                            💑 Couple Names
                        </div>
                        <div id="tv-team-spot-flight" style="font-size: 0.95rem; font-weight: 800; color: var(--accent); letter-spacing: 1.5px; text-transform: uppercase;">
