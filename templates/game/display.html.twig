    </footer>

    <script src="/js/sounds.js?v=5"></script>
    <script>
        const SHOW_ID = {{ show.id }};
        let tvSoundEnabled = true;
        let tvTimerInterval = null;
        let tvRemainingSeconds = 25;
        let activeTimerStartStamp = null;
        let timeUpBuzzerPlayedForStamp = null;

        let hasInitializedTvState = false;
        let prevQuestionId = null;
        let prevQuestionStartedAt = null;
        let prevAnswerRevealed = 0;
        let prevRoundId = null;
        let prevRoundCompleted = false;
        let prevTeamScoreSum = 0;
        let prevShowStatus = null;
        let prevActiveRuleIdx = -1;
        let prevActiveTeamIdx = -1;
        let prevSfxAt = 0;
        let prevTeamScores = {};
        let recentScoreChanges = {};
        let pointsBurstTimeout = null;

        function triggerPointsBurstBanner(team, delta) {
            const banner = document.getElementById('tv-points-burst');
            if (!banner || !team) return;
            const emojiEl = document.getElementById('tv-points-burst-emoji');
            const labelEl = document.getElementById('tv-points-burst-label');
            const ptsEl = document.getElementById('tv-points-burst-pts');
            const teamEl = document.getElementById('tv-points-burst-team');
            const membersEl = document.getElementById('tv-points-burst-members');

            if (emojiEl) emojiEl.innerText = team.avatar_emoji || '🏆';
            if (labelEl) labelEl.innerText = delta > 0 ? '🏆 POINTS AWARDED!' : '⚠️ POINTS DEDUCTED';
            if (ptsEl) ptsEl.innerText = `${delta > 0 ? '+' + delta : delta} PTS`;
            if (teamEl) teamEl.innerText = team.name || 'Team';
            if (membersEl) {
                if (team.members && team.members.trim() !== '') {
                    membersEl.innerText = `💑 ${team.members}`;
                    membersEl.style.display = 'block';
                } else {
                    membersEl.style.display = 'none';
                }
            }

            banner.classList.toggle('penalty', delta < 0);
            banner.classList.remove('active');
            void banner.offsetWidth;
            banner.classList.add('active');

            clearTimeout(pointsBurstTimeout);
            pointsBurstTimeout = setTimeout(() => {
                banner.classList.remove('active');
            }, 2250);
        }

        function triggerStageTransition(cardEl) {
            const fx = document.getElementById('tv-stage-transition-fx');
            if (fx) {
                fx.classList.remove('active');
                void fx.offsetWidth;
                fx.classList.add('active');
            }
            if (cardEl) {
                cardEl.classList.remove('stage-card-3d-enter');
                void cardEl.offsetWidth;
                cardEl.classList.add('stage-card-3d-enter');
            }
        }

        function toggleTvSound() {
            tvSoundEnabled = !tvSoundEnabled;
            if (window.soundFX) {
                window.soundFX.enabled = tvSoundEnabled;
                if (tvSoundEnabled) {
                    window.soundFX.init();
                    window.soundFX.playTick();
                }
            }
            const btn = document.getElementById('tv-sound-btn');
            if (btn) {
                btn.innerText = tvSoundEnabled ? '🔊 Sound' : '🔇 Muted';
                btn.classList.toggle('muted', !tvSoundEnabled);
            }
        }

        function updateTvTimerBox(sec) {
            const box = document.getElementById('tv-timer');
            if (!box) return;
            box.innerText = sec;
            if (sec <= 5) {
                box.classList.add('danger');
            } else {
                box.classList.remove('danger');
            }
        }

        function startTvClientTimer(startedAt, duration) {
            const elapsed = Math.floor(Date.now() / 1000) - startedAt;
            tvRemainingSeconds = Math.max(0, (duration || 25) - elapsed);
            updateTvTimerBox(tvRemainingSeconds);

            if (activeTimerStartStamp === startedAt && tvTimerInterval) {
                return;
            }

            activeTimerStartStamp = startedAt;
            clearInterval(tvTimerInterval);

            tvTimerInterval = setInterval(() => {
                const nowElapsed = Math.floor(Date.now() / 1000) - startedAt;
                const nextRem = Math.max(0, (duration || 25) - nowElapsed);

                if (nextRem !== tvRemainingSeconds) {
                    tvRemainingSeconds = nextRem;
                    updateTvTimerBox(tvRemainingSeconds);

                    if (tvRemainingSeconds > 0 && tvRemainingSeconds <= 5 && window.soundFX) {
                        window.soundFX.playWarningTick();
                    }

                    if (tvRemainingSeconds === 0) {
                        clearInterval(tvTimerInterval);
                        tvTimerInterval = null;
                        if (timeUpBuzzerPlayedForStamp !== startedAt && window.soundFX) {
                            timeUpBuzzerPlayedForStamp = startedAt;
                            window.soundFX.playTimeUpBuzzer();
                        }
                    }
                }
            }, 250);
        }

        function stopTvClientTimer(defaultSec) {
            clearInterval(tvTimerInterval);
            tvTimerInterval = null;
            activeTimerStartStamp = null;
            const box = document.getElementById('tv-timer');
            if (box) {
                box.innerText = defaultSec || 25;
                box.classList.remove('danger');
            }
        }

        function syncDisplay() {
            fetch(`/api/shows/${SHOW_ID}/state`)
                .then(res => res.json())
                .then(data => {
                    const show = data.show;
                    const q = data.current_question;
                    const round = data.current_round;

                    if (round) {
                        document.getElementById('tv-round').innerText = round.name;
                    }

                    const catBadge = document.getElementById('tv-cat');
                    const roundDivider = document.getElementById('tv-round-divider');
                    const imgCard = document.getElementById('tv-img-card');
                    const img = document.getElementById('tv-img');
                    const ansBanner = document.getElementById('tv-answer');
                    const welcomeSplashCard = document.getElementById('tv-welcome-splash-card');
                    const teamsIntroCard = document.getElementById('tv-teams-intro-card');
                    const splash = document.getElementById('tv-splash');
                    const roundEndCard = document.getElementById('tv-round-end-card');
                    const rulesCard = document.getElementById('tv-rules-card');
                    const tvContentGrid = document.querySelector('.tv-content');
                    const scoreboardAside = document.getElementById('tv-scoreboard-aside');
                    const rulesList = Array.isArray(data.rules) ? data.rules : [];
                    const teamsList = Array.isArray(data.teams) ? data.teams : [];
                    const activeRuleIdx = (show.active_rule_index !== undefined && show.active_rule_index !== null) ? parseInt(show.active_rule_index) : -1;
                    const activeTeamIdx = (show.active_team_index !== undefined && show.active_team_index !== null) ? parseInt(show.active_team_index) : -1;
                    const rProg = data.round_progress || {};
                    const showStatus = show.status || 'setup';

                    function buildDynamicRoundDescription(rObj) {
                        if (!rObj) return '';
                        if (rObj.settings_summary) return rObj.settings_summary;
                        const typeLabel = rObj.round_type === 'rapid_fire'
                            ? '⚡ Rapid Fire (All Remaining Starred Puzzles)'
                            : (rObj.round_type === 'head_to_head' ? 'Head-to-Head Flight Matchup' : 'All Teams Open Play');
                        const timerSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                        const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                        const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                        const advLabel = rObj.advancement_type === 'top_x'
                            ? `Top ${rObj.advance_top_x} Teams Advance`
                            : 'All Advance';
                        return `Type: ${typeLabel} • Timer: ${timerSec}s • Points: +${pts} (Steal: +${steal}) • Advancement: ${advLabel}`;
                    }

                    function buildRoundStatsHtml(rObj) {
                        if (!rObj) return '';
                        const timerSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                        const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                        const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                        const totalQ = rObj.total_questions || (Array.isArray(rObj.category_allocations) ? rObj.category_allocations.reduce((s, a) => s + (parseInt(a.count) || 0), 0) : 0);
                        const tileStyle = 'background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 0.65rem 0.5rem; text-align: center;';
                        return `
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">⏱️ Timer</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #38bdf8; margin-top: 0.15rem;">${timerSec}s</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">🏆 Win Points</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #10b981; margin-top: 0.15rem;">+${pts} pts</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">⚡ Steal</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #f59e0b; margin-top: 0.15rem;">+${steal} pts</div>
                            </div>
                            <div style="${tileStyle}">
                                <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 800; text-transform: uppercase;">🧩 Puzzles</div>
                                <div style="font-size: 1.3rem; font-weight: 900; color: #fff; margin-top: 0.15rem;">${totalQ || 'All'}</div>
                            </div>
                        `;
                    }

                    function buildRoundMetaSummary(rObj) {
                        if (!rObj) return '';
                        const dynDesc = buildDynamicRoundDescription(rObj);
                        const allocs = Array.isArray(rObj.category_allocations) ? rObj.category_allocations : [];
                        const catPills = allocs.map(a => `${a.category_icon || '🧩'} ${a.category_name || 'Category'} (${a.count})`).join('  •  ');
                        return `<div style="margin-bottom: 0.35rem; color: #f8fafc;">${dynDesc}</div>` +
                            (catPills ? `<div style="font-size: 0.85rem; color: #94a3b8;">Categories: ${catPills}</div>` : '');
                    }

                    // Determine if we are on the initial Welcome Splash Screen (hide teams scoreboard & timer until game starts)
                    const isWelcomeSplashStage = (!q && activeRuleIdx < 0 && !rProg.is_completed && showStatus === 'setup');
                    const isTeamsIntroStage = (!q && activeRuleIdx < 0 && !rProg.is_completed && showStatus === 'teams_intro');
                    const roundBubble = document.getElementById('tv-round-bubble');
                    const timerLabelEl = document.getElementById('tv-timer-label');
                    const timerBoxEl = document.getElementById('tv-timer');

                    // Show timer ONLY when an active puzzle (q) is on screen
                    if (q) {
                        if (timerLabelEl) timerLabelEl.style.display = 'inline';
                        if (timerBoxEl) timerBoxEl.style.display = 'block';
                    } else {
                        if (timerLabelEl) timerLabelEl.style.display = 'none';
                        if (timerBoxEl) timerBoxEl.style.display = 'none';
                    }

                    if (isWelcomeSplashStage) {
                        if (scoreboardAside) scoreboardAside.style.display = 'none';
                        if (tvContentGrid) tvContentGrid.classList.add('splash-fullscreen');
                        if (roundBubble) roundBubble.style.display = 'none';
                    } else {
                        if (scoreboardAside) scoreboardAside.style.display = 'flex';
                        if (tvContentGrid) tvContentGrid.classList.remove('splash-fullscreen');
                        if (roundBubble) roundBubble.style.display = 'inline-flex';
                        if (isTeamsIntroStage) {
                            document.getElementById('tv-round').innerText = 'Competing Teams';
                        } else if (activeRuleIdx >= 0) {
                            document.getElementById('tv-round').innerText = 'Tournament Rules';
                        } else if (q && q.is_sample) {
                            document.getElementById('tv-round').innerText = 'Tryout Practice';
                        } else if (round) {
                            document.getElementById('tv-round').innerText = round.name;
                        }
                    }

                    if (activeRuleIdx >= 0 && rulesList.length > 0 && activeRuleIdx < rulesList.length) {
                        const activeRule = rulesList[activeRuleIdx];
                        if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                        if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                        splash.style.display = 'none';
                        if (roundEndCard) roundEndCard.style.display = 'none';
                        imgCard.style.display = 'none';
                        ansBanner.style.display = 'none';
                        catBadge.style.display = 'none';
                        if (roundDivider) roundDivider.style.display = 'none';
                        rulesCard.style.display = 'flex';
                        if (hasInitializedTvState && (activeRuleIdx !== prevActiveRuleIdx || showStatus !== prevShowStatus)) {
                            triggerStageTransition(rulesCard);
                        }

                        document.getElementById('tv-rule-step').innerText = `RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
                        document.getElementById('tv-rule-icon').innerText = activeRule.icon || '📜';
                        document.getElementById('tv-rule-title').innerText = activeRule.title;
                        document.getElementById('tv-rule-desc').innerText = activeRule.description;

                        const dotsWrap = document.getElementById('tv-rules-dots');
                        dotsWrap.innerHTML = '';
                        rulesList.forEach((_, idx) => {
                            const dot = document.createElement('div');
                            dot.className = 'rule-dot' + (idx === activeRuleIdx ? ' active' : (idx < activeRuleIdx ? ' completed' : ''));
                            dotsWrap.appendChild(dot);
                        });
                    } else {
                        rulesCard.style.display = 'none';

                        if (q) {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            imgCard.style.display = 'flex';
                            img.src = q.media_path;

                            if (q.category_name) {
                                const qProgress = (q.is_sample) ? ' (Practice • No Points)' : ((rProg.total > 0) ? ` (${rProg.used}/${rProg.total})` : '');
                                catBadge.innerText = `${q.category_icon || '🧩'} ${q.category_name}${qProgress}`;
                                catBadge.style.display = 'inline-flex';
                                if (roundDivider) roundDivider.style.display = 'inline';
                            } else {
                                catBadge.style.display = 'none';
                                if (roundDivider) roundDivider.style.display = 'none';
                            }

                            ansBanner.innerText = q.answer;
                            if (show.answer_revealed == 1) {
                                ansBanner.style.display = 'block';
                            } else {
                                ansBanner.style.display = 'none';
                            }
                        } else if (round && rProg.is_completed) {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (roundEndCard) {
                                roundEndCard.style.display = 'block';
                                if (hasInitializedTvState && !prevRoundCompleted) {
                                    triggerStageTransition(roundEndCard);
                                }
                                const rNum = round.round_number || 1;
                                document.getElementById('tv-end-badge').innerText = `🏁 ROUND ${rNum} COMPLETE • ${rProg.used || rProg.total || 0} PUZZLES FINISHED`;
                                document.getElementById('tv-end-title').innerText = `END OF ROUND ${rNum}`;
                                document.getElementById('tv-end-subtitle').innerText = `${round.name} is complete! Check the live standings on the right.`;

                                const nextR = rProg.next_round;
                                const nextBox = document.getElementById('tv-next-round-box');
                                if (nextR) {
                                    nextBox.style.display = 'block';
                                    document.getElementById('tv-next-round-label').innerText = `⏭️ UP NEXT • ROUND ${nextR.round_number} RULES & INFO`;
                                    document.getElementById('tv-next-round-name').innerText = nextR.name;
                                    document.getElementById('tv-next-round-stats').innerHTML = buildRoundStatsHtml(nextR);
                                    document.getElementById('tv-next-round-cats').innerHTML = buildRoundMetaSummary(nextR);
                                } else {
                                    nextBox.style.display = 'block';
                                    document.getElementById('tv-next-round-label').innerText = '🏆 GRAND CHAMPIONSHIP COMPLETE';
                                    document.getElementById('tv-next-round-name').innerText = 'Congratulations to our Grand Champions!';
                                    document.getElementById('tv-next-round-stats').innerHTML = '';
                                    document.getElementById('tv-next-round-cats').innerHTML = '<div style="color: var(--accent); font-weight: 800;">All tournament rounds have been completed!</div>';
                                }
                            }
                        } else if (isWelcomeSplashStage) {
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (welcomeSplashCard) {
                                welcomeSplashCard.style.display = 'flex';
                                if (hasInitializedTvState && showStatus !== prevShowStatus) {
                                    triggerStageTransition(welcomeSplashCard);
                                }
                            }
                        } else if (isTeamsIntroStage) {
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            splash.style.display = 'none';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (teamsIntroCard) {
                                teamsIntroCard.style.display = 'flex';
                                const safeIdx = (activeTeamIdx >= 0 && activeTeamIdx < teamsList.length) ? activeTeamIdx : 0;
                                const currTeam = teamsList[safeIdx];
                                if (hasInitializedTvState && (showStatus !== prevShowStatus || safeIdx !== prevActiveTeamIdx)) {
                                    triggerStageTransition(teamsIntroCard);
                                }
                                if (currTeam) {
                                    const teamColor = currTeam.avatar_color || '#f97316';
                                    document.getElementById('tv-team-spot-step').innerText = `TEAM ${safeIdx + 1} OF ${teamsList.length}`;
                                    const avatarEl = document.getElementById('tv-team-spot-avatar');
                                    avatarEl.innerText = currTeam.avatar_emoji || '🍁';
                                    avatarEl.style.borderColor = teamColor;
                                    document.getElementById('tv-team-spot-name').innerText = currTeam.name;
                                    const membersEl = document.getElementById('tv-team-spot-members');
                                    if (currTeam.members) {
                                        membersEl.style.display = 'inline-block';
                                        membersEl.innerText = `💑 ${currTeam.members}`;
                                    } else {
                                        membersEl.style.display = 'none';
                                    }
                                    const flightEl = document.getElementById('tv-team-spot-flight');
                                    flightEl.innerText = currTeam.flight_group ? `🍂 ${currTeam.flight_group.toUpperCase()} FLIGHT CONTENDERS` : '🍂 TOURNAMENT CONTENDERS';
                                }

                                const teamDotsWrap = document.getElementById('tv-team-spot-dots');
                                if (teamDotsWrap) {
                                    teamDotsWrap.innerHTML = '';
                                    teamsList.forEach((_, idx) => {
                                        const dot = document.createElement('div');
                                        dot.className = 'rule-dot' + (idx === safeIdx ? ' active' : (idx < safeIdx ? ' completed' : ''));
                                        teamDotsWrap.appendChild(dot);
                                    });
                                }

                                const rosterStrip = document.getElementById('tv-teams-roster-strip');
                                if (rosterStrip) {
                                    rosterStrip.innerHTML = `<span style="font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; align-self: center; margin-right: 0.35rem;">🪑 Seated:</span>` +
                                        teamsList.slice(0, safeIdx + 1).map((t, idx) => `
                                            <span class="tv-roster-pill ${idx === safeIdx ? 'current' : ''}">
                                                <span>${t.avatar_emoji || '🍁'}</span>
                                                <span>#${idx + 1} ${t.name}</span>
                                            </span>
                                        `).join('');
                                }
                            }
                        } else {
                            if (welcomeSplashCard) welcomeSplashCard.style.display = 'none';
                            if (teamsIntroCard) teamsIntroCard.style.display = 'none';
                            if (roundEndCard) roundEndCard.style.display = 'none';
                            splash.style.display = 'block';
                            imgCard.style.display = 'none';
                            ansBanner.style.display = 'none';
                            catBadge.style.display = 'none';
                            if (roundDivider) roundDivider.style.display = 'none';
                            if (hasInitializedTvState && (showStatus !== prevShowStatus || curRId !== prevRoundId)) {
                                triggerStageTransition(splash);
                            }

                            if (round) {
                                document.getElementById('tv-splash-badge').innerText = `ROUND ${round.round_number || 1} BRIEFING & RULES`;
                                document.getElementById('tv-splash-title').innerText = round.name;
                                document.getElementById('tv-splash-sub').innerText = buildDynamicRoundDescription(round);
                                document.getElementById('tv-splash-stats').innerHTML = buildRoundStatsHtml(round);
                                document.getElementById('tv-splash-cats').innerHTML = buildRoundMetaSummary(round);
                            }
                        }
                    }

                    // Matchup callout
                    const matchupBox = document.getElementById('tv-matchup');
                    if (show.active_matchup_label && show.active_matchup_label.trim() !== '') {
                        matchupBox.innerText = `⚔️ ${show.active_matchup_label}`;
                        matchupBox.style.display = 'block';
                    } else {
                        matchupBox.style.display = 'none';
                    }

                    // Timer Sync (Smooth 1s client countdown + warning ticks & time-up buzzer)
                    if (show.question_started_at && show.answer_revealed == 0 && q) {
                        startTvClientTimer(parseInt(show.question_started_at), parseInt(show.timer_duration) || 25);
                    } else {
                        stopTvClientTimer(parseInt(show.timer_duration) || 25);
                    }

                    // Sound Effect & Per-Team Score Change Triggers on TV State Transitions
                    const curQId = q ? q.id : null;
                    const curQStart = show.question_started_at ? parseInt(show.question_started_at) : null;
                    const curRev = parseInt(show.answer_revealed) || 0;
                    const curRId = show.current_round_id ? parseInt(show.current_round_id) : null;
                    const curRDone = !!rProg.is_completed;
                    const curScoreSum = teamsList.reduce((acc, t) => acc + (parseInt(t.score) || 0), 0);

                    // Detect individual team score changes
                    const nowMs = Date.now();
                    let changedTeams = [];
                    teamsList.forEach(t => {
                        const tid = t.id;
                        const curScore = parseInt(t.score) || 0;
                        if (hasInitializedTvState && prevTeamScores[tid] !== undefined && prevTeamScores[tid] !== curScore && !(showStatus === 'setup' && curScoreSum === 0)) {
                            const delta = curScore - prevTeamScores[tid];
                            recentScoreChanges[tid] = { delta, expiresAt: nowMs + 2250 };
                            changedTeams.push({ team: t, delta });
                        }
                        prevTeamScores[tid] = curScore;
                    });

                    if (hasInitializedTvState && window.soundFX) {
                        let playedScoreOrRevealSound = false;

                        if (changedTeams.length > 0) {
                            const lastChange = changedTeams[changedTeams.length - 1];
                            triggerPointsBurstBanner(lastChange.team, lastChange.delta);
                            if (lastChange.delta > 0) {
                                window.soundFX.playPointsAwarded();
                            } else {
                                window.soundFX.playPointsPenalty();
                            }
                            playedScoreOrRevealSound = true;
                        }

                        if (curRev === 1 && prevAnswerRevealed === 0) {
                            if (!playedScoreOrRevealSound) {
                                window.soundFX.playDingCorrect();
                            }
                            playedScoreOrRevealSound = true;
                        }

                        if (showStatus !== prevShowStatus && showStatus === 'setup') {
                            window.soundFX.playSplashIntro();
                        } else if (showStatus === 'teams_intro' && (showStatus !== prevShowStatus || activeTeamIdx !== prevActiveTeamIdx)) {
                            window.soundFX.playTeamUnveil();
                        } else if (activeRuleIdx >= 0 && (activeRuleIdx !== prevActiveRuleIdx || showStatus !== prevShowStatus)) {
                            window.soundFX.playRuleWhoosh();
                        } else if (showStatus === 'sample_puzzle' && (showStatus !== prevShowStatus || curQStart !== prevQuestionStartedAt)) {
                            window.soundFX.playRoundStartHorn();
                            img.classList.remove('stage-enter');
                            void img.offsetWidth;
                            img.classList.add('stage-enter');
                        } else if ((curRDone && !prevRoundCompleted) || (prevRoundId !== null && curRId !== prevRoundId && !curQId) || (showStatus !== prevShowStatus && showStatus === 'round_intro')) {
                            window.soundFX.playFanfare();
                        } else if (curQId && !prevQuestionId) {
                            // Entering the first puzzle of a round!
                            window.soundFX.playRoundStartHorn();
                            img.classList.remove('stage-enter');
                            void img.offsetWidth;
                            img.classList.add('stage-enter');
                        } else if (curQId && (curQId !== prevQuestionId || curQStart !== prevQuestionStartedAt)) {
                            window.soundFX.playTick();
                            img.classList.remove('stage-enter');
                            void img.offsetWidth;
                            img.classList.add('stage-enter');
                        }
                    } else if (!hasInitializedTvState && window.soundFX && isWelcomeSplashStage) {
                        window.soundFX.playSplashIntro();
                    }

                    const curSfxAt = parseInt(show.last_sfx_at, 10) || 0;
                    if (hasInitializedTvState && window.soundFX && curSfxAt > prevSfxAt && show.last_sfx_name) {
                        window.soundFX.playByName(show.last_sfx_name);
                    }

                    const didTeamStepChange = (showStatus !== prevShowStatus || activeTeamIdx !== prevActiveTeamIdx);
                    hasInitializedTvState = true;
                    prevQuestionId = curQId;
                    prevQuestionStartedAt = curQStart;
                    prevAnswerRevealed = curRev;
                    prevRoundId = curRId;
                    prevRoundCompleted = curRDone;
                    prevTeamScoreSum = curScoreSum;
                    prevShowStatus = showStatus;
                    prevActiveRuleIdx = activeRuleIdx;
                    prevActiveTeamIdx = activeTeamIdx;
                    prevSfxAt = curSfxAt;

                    // Right Scoreboard Teams
                    const teamsWrap = document.getElementById('tv-teams');
                    teamsWrap.innerHTML = '';
                    const safeTeamIdx = (activeTeamIdx >= 0 && activeTeamIdx < teamsList.length) ? activeTeamIdx : 0;
                    // While in teams_intro stage: teams introduced so far (indices 0 .. safeTeamIdx inclusive) are seated in the sidebar!
                    // Once we move past teams_intro (to rules_intro / round_intro / active), all teams are seated.
                    const seatedTeamsInput = isTeamsIntroStage ? teamsList.slice(0, safeTeamIdx + 1) : teamsList;
                    document.getElementById('tv-team-count').innerText = isTeamsIntroStage
                        ? `${seatedTeamsInput.length} / ${teamsList.length} Seated`
                        : `${teamsList.length} Teams`;

                    // Sort: Active first, highest score on top, stable order for ties
                    const sortedTeams = [...seatedTeamsInput].sort((a, b) => {
                        const aElim = (a.is_eliminated == 1) ? 1 : 0;
                        const bElim = (b.is_eliminated == 1) ? 1 : 0;
                        if (aElim !== bElim) return aElim - bElim;

                        const aScore = parseInt(a.score) || 0;
                        const bScore = parseInt(b.score) || 0;
                        if (bScore !== aScore) return bScore - aScore;

                        return (parseInt(a.sort_order) || a.id) - (parseInt(b.sort_order) || b.id);
                    });

                    // Highlight the currently introduced team that just took its seat in the sidebar
                    const justSeatedTeamId = (isTeamsIntroStage && teamsList[safeTeamIdx])
                        ? teamsList[safeTeamIdx].id
                        : null;
                    let rank = 1;
                    sortedTeams.forEach(t => {
                        const isEliminated = (t.is_eliminated == 1);
                        const score = parseInt(t.score) || 0;

                        let rankDisplay = `#${rank}`;
                        let rankClass = '';

                        if (isEliminated) {
                            rankDisplay = '✕';
                        } else {
                            if (score > 0) {
                                if (rank === 1) {
                                    rankDisplay = '🥇';
                                    rankClass = 'rank-1';
                                } else if (rank === 2) {
                                    rankDisplay = '🥈';
                                    rankClass = 'rank-2';
                                } else if (rank === 3) {
                                    rankDisplay = '🥉';
                                    rankClass = 'rank-3';
                                }
                            }
                            rank++;
                        }

                        const recentChange = (recentScoreChanges[t.id] && recentScoreChanges[t.id].expiresAt > nowMs)
                            ? recentScoreChanges[t.id]
                            : null;
                        const pointsClass = recentChange
                            ? (recentChange.delta > 0 ? ' points-gained' : ' points-lost')
                            : '';
                        const scorePopClass = recentChange ? ' score-pop' : '';
                        const deltaPillHtml = recentChange
                            ? `<span class="score-delta-pill ${recentChange.delta > 0 ? 'plus' : 'minus'}">${recentChange.delta > 0 ? '+' + recentChange.delta : recentChange.delta}</span>`
                            : '';

                        const row = document.createElement('div');
                        const isJustSeated = (justSeatedTeamId !== null && t.id == justSeatedTeamId);
                        row.className = 'team-card-row '
                            + (isEliminated ? 'eliminated' : rankClass)
                            + (isJustSeated ? ' spotlight-active' : '')
                            + (isJustSeated && didTeamStepChange ? ' just-seated-anim' : '')
                            + pointsClass;
                        const elimBadge = isEliminated ? `<span class="eliminated-tag">OUT</span>` : '';

                        row.innerHTML = `
                            <div class="team-left">
                                <span class="rank-badge">${rankDisplay}</span>
                                <div class="team-avatar" style="border: 2px solid ${t.avatar_color || '#f97316'};">${t.avatar_emoji || '🍁'}</div>
                                <div class="team-name-group">
                                    <div class="team-name">${t.name} ${elimBadge}</div>
                                    ${t.members ? `<div class="team-sub">${t.members}</div>` : ''}
                                </div>
                            </div>
                            <div class="team-score-badge${scorePopClass}">${score}${deltaPillHtml}</div>
                        `;
                        teamsWrap.appendChild(row);
                    });

                    // Render empty reserved seat placeholders for teams not yet introduced during teams_intro
                    if (isTeamsIntroStage) {
                        for (let sIdx = safeTeamIdx + 1; sIdx < teamsList.length; sIdx++) {
                            const seatDiv = document.createElement('div');
                            seatDiv.className = 'team-seat-placeholder';
                            seatDiv.innerHTML = `<span>🪑 Seat #${sIdx + 1} • Awaiting Intro</span><span>—</span>`;
                            teamsWrap.appendChild(seatDiv);
                        }
                    }
                });
        }

        syncDisplay();
        setInterval(syncDisplay, 1500);
    </script>
</body>
</html>
