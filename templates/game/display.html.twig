                        <span class="splash-particle" style="top: 44%; right: 2%; animation-delay: 2.1s;">🏆</span>
                    </div>
                    <div class="splash-hero-frame">
                        <img src="/media/khapre_party_splash.jpg" alt="Khapre Party Splash" class="splash-hero-img">
                    </div>
                    <div class="splash-cta-pill" title="Click to play Game Show Opening Theme">
                        <span class="eq-bars">
                            <span class="eq-bar"></span>
                            <span class="eq-bar"></span>
                            <span class="eq-bar"></span>
                            <span class="eq-bar"></span>
                        </span>
                        <span>🎉 Welcome to the Arena! Competing Teams &amp; Rules Up Next</span>
                        <span style="font-size: 0.85rem; opacity: 0.85;">🔊</span>
                    </div>
                </div>

                <!-- COMPETING TEAMS 1-BY-1 SPOTLIGHT CARD (STAGE 2: ONE TEAM AT A TIME ON TV) -->
                <div class="tv-team-spotlight-card" id="tv-teams-intro-card" style="display: none;">
