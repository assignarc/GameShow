<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ show.name }} | TV Display</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800;900&family=Bungee&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0a0807;
            --bg-panel: #16120e;
            --bg-card: #201a15;
            --border-color: #382e25;
            --primary: #f97316;
            --accent: #f59e0b;
            --danger: #ef4444;
            --success: #10b981;
            --gold: #fbbf24;
            --silver: #cbd5e1;
            --bronze: #d97706;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: #fff;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        header.tv-header {
            padding: 0.9rem 2rem;
            background: linear-gradient(180deg, rgba(28, 24, 21, 0.98) 0%, rgba(16, 13, 11, 0.9) 100%);
            border-bottom: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            z-index: 10;
        }

        .show-title-group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.45rem;
            min-width: 0;
            flex: 1;
        }

        .show-title {
            font-family: 'Bungee', cursive, sans-serif;
            font-size: clamp(1.4rem, 2.2vw, 2.1rem);
            color: var(--primary);
            letter-spacing: 1.5px;
            text-shadow: 0 4px 20px rgba(249, 115, 22, 0.5);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.15;
        }

        .tv-round-bubble {
            display: inline-flex;
            flex-direction: row;
            align-items: center;
            gap: 0.65rem;
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(249, 115, 22, 0.1) 100%);
            border: 1.5px solid rgba(245, 158, 11, 0.45);
            border-radius: 20px;
            padding: 0.35rem 1.15rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
            max-width: 100%;
            white-space: nowrap;
        }

        .tv-round-title {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 1.05rem;
            font-weight: 800;
            color: #fbbf24;
            letter-spacing: 0.4px;
            line-height: 1;
            text-shadow: 0 2px 10px rgba(245, 158, 11, 0.3);
            white-space: nowrap;
        }

        .tv-round-divider {
            color: rgba(251, 191, 36, 0.45);
            font-size: 0.95rem;
            font-weight: 900;
        }

        .tv-round-cat {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            color: #ffedd5;
            letter-spacing: 0.3px;
            line-height: 1;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            opacity: 0.95;
            white-space: nowrap;
        }

        .timer-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tv-sound-btn {
            background: rgba(255, 255, 255, 0.07);
            border: 1.5px solid rgba(245, 158, 11, 0.4);
            color: #fbbf24;
            padding: 0.45rem 0.9rem;
            border-radius: 12px;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 0.9rem;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
        }

        .tv-sound-btn:hover {
            background: rgba(245, 158, 11, 0.18);
            border-color: var(--accent);
        }

        .tv-sound-btn.muted {
            border-color: rgba(148, 163, 184, 0.3);
            color: #94a3b8;
        }

        .timer-label {
            font-size: 0.95rem;
            font-weight: 800;
            color: #94a3b8;
            letter-spacing: 1px;
        }

        .timer-box {
            font-family: 'Bungee', monospace;
            font-size: 3.2rem;
            color: var(--accent);
            line-height: 1;
            min-width: 90px;
            text-align: right;
            transition: color 0.2s;
        }

        .timer-box.danger {
            color: var(--danger);
            animation: pulse 0.5s infinite alternate;
        }

        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.12); }
        }

        /* 2-COLUMN LAYOUT: MAIN PUZZLE STAGE (LEFT) + LIVE SCOREBOARD (RIGHT) */
        .tv-content {
            display: grid;
            grid-template-columns: 1fr 380px;
            flex: 1;
            overflow: hidden;
            position: relative;
        }

        .tv-content.splash-fullscreen {
            grid-template-columns: 1fr !important;
        }

        @media (min-width: 1800px) {
            .tv-content {
                grid-template-columns: 1fr 430px;
            }
        }

        main.tv-stage {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 2rem;
            background: radial-gradient(circle at center, #2a1f16 0%, #0a0807 100%);
            overflow: hidden;
            perspective: 1200px;
        }

        /* Ambient Rotating Game Show Stage Spotlights */
        main.tv-stage::before,
        main.tv-stage::after {
            content: '';
            position: absolute;
            width: 140%;
            height: 140%;
            top: -20%;
            left: -20%;
            pointer-events: none;
            z-index: 0;
            background: conic-gradient(
                from 0deg at 50% 50%,
                transparent 0deg,
                rgba(249, 115, 22, 0.08) 25deg,
                transparent 55deg,
                transparent 180deg,
                rgba(251, 191, 36, 0.08) 205deg,
                transparent 235deg
            );
            animation: rotateStageBeams 22s linear infinite;
        }

        main.tv-stage::after {
            animation-direction: reverse;
            animation-duration: 30s;
            opacity: 0.75;
        }

        @keyframes rotateStageBeams {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Cinematic Stage Transition Light Sweep Overlay */
        .tv-stage-transition-fx {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 60;
            opacity: 0;
        }

        .tv-stage-transition-fx.active {
            animation: stageLightSweep 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes stageLightSweep {
            0% {
                opacity: 0.95;
                background: radial-gradient(circle at center, rgba(251, 191, 36, 0.55) 0%, rgba(249, 115, 22, 0.25) 45%, transparent 75%);
                transform: scale(0.65);
            }
            50% {
                opacity: 0.75;
                transform: scale(1.15);
            }
            100% {
                opacity: 0;
                transform: scale(1.4);
            }
        }

        /* Clean Stage Card Entrance — emerges smoothly from the back and stays steady */
        @keyframes stageCard3DEnter {
            0% {
                opacity: 0;
                transform: scale(0.76) translateY(20px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .stage-card-3d-enter {
            animation: stageCard3DEnter 0.48s cubic-bezier(0.22, 1, 0.36, 1) forwards !important;
        }

        /* 1-BY-1 TEAM SPOTLIGHT CARD */
        .tv-team-spotlight-card {
            background: linear-gradient(145deg, rgba(36, 28, 22, 0.97) 0%, rgba(16, 12, 9, 0.99) 100%);
            border: 2.5px solid rgba(251, 191, 36, 0.6);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.92), 0 0 65px rgba(249, 115, 22, 0.28);
            border-radius: 32px;
            padding: 2.5rem 3.2rem;
            max-width: 920px;
            width: 92%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            z-index: 5;
            overflow: hidden;
        }

        .tv-team-avatar-ring {
            position: relative;
            width: 138px;
            height: 138px;
            border-radius: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5.2rem;
            background: radial-gradient(circle, rgba(251, 191, 36, 0.22) 0%, rgba(18, 14, 11, 0.95) 75%);
            border: 3px solid var(--accent);
            box-shadow: 0 0 45px rgba(245, 158, 11, 0.45), inset 0 0 25px rgba(251, 191, 36, 0.25);
            margin-bottom: 1.35rem;
        }

        .tv-team-spot-name {
            font-size: clamp(2.5rem, 4vw, 3.8rem);
            font-weight: 900;
            letter-spacing: 1px;
            margin: 0 0 0.65rem 0;
            background: linear-gradient(90deg, #ffffff 0%, #fde68a 50%, #f97316 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.7));
        }

        .team-card-row.spotlight-active {
            border: 2px solid #fbbf24 !important;
            background: linear-gradient(90deg, rgba(251, 191, 36, 0.28) 0%, rgba(249, 115, 22, 0.16) 100%) !important;
            box-shadow: 0 0 25px rgba(251, 191, 36, 0.4);
        }

        .team-card-row.just-seated-anim {
            animation: teamSeatSlideIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes teamSeatSlideIn {
            0% {
                opacity: 0;
                transform: translateX(-80px) scale(0.85);
            }
            65% {
                opacity: 1;
                transform: translateX(6px) scale(1.03);
            }
            100% {
                opacity: 1;
                transform: translateX(0) scale(1);
            }
        }

        .team-seat-placeholder {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-radius: 14px;
            border: 1.5px dashed rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.02);
            color: rgba(148, 163, 184, 0.45);
            font-weight: 700;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .team-seat-placeholder.next-up {
            border-color: rgba(251, 191, 36, 0.45);
            background: rgba(251, 191, 36, 0.06);
            color: var(--accent);
        }

        .puzzle-viewport {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .puzzle-img-card {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            max-width: 95%;
            max-height: 78vh;
        }

        .puzzle-img {
            width: 100%;
            height: auto;
            max-width: 100%;
            max-height: 76vh;
            border-radius: 20px;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.92), 0 0 0 1px rgba(255, 255, 255, 0.08);
            object-fit: contain;
            background: #120e0b;
        }

        .answer-overlay {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            padding: 1.15rem 3.5rem;
            border-radius: 24px;
            font-size: clamp(2.2rem, 3.6vw, 3.5rem);
            font-weight: 900;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85), 0 0 45px rgba(16, 185, 129, 0.65), 0 0 0 3px rgba(255, 255, 255, 0.35);
            text-align: center;
            display: none;
            width: max-content;
            max-width: 90%;
            min-width: min(420px, 90%);
            box-sizing: border-box;
            white-space: normal;
            word-break: normal;
            overflow-wrap: break-word;
            animation: popAnswer 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 50;
            line-height: 1.25;
        }

        @keyframes popAnswer {
            0% { transform: translateX(-50%) scale(0.65) translateY(20px); opacity: 0; }
            100% { transform: translateX(-50%) scale(1) translateY(0); opacity: 1; }
        }

        .splash-card {
            text-align: center;
            color: var(--accent);
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ANIMATED WELCOME SPLASH & STAGE ENTRANCES */
        .welcome-splash-stage {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 96%;
            max-height: 83vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.9rem;
            z-index: 2;
        }

        .splash-particles {
            position: absolute;
            inset: -20px;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .splash-particle {
            position: absolute;
            font-size: 2rem;
            opacity: 0.75;
            filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.5));
            animation: floatParticle 6s ease-in-out infinite;
        }

        @keyframes floatParticle {
            0%, 100% { transform: translateY(0) rotate(0deg) scale(1); opacity: 0.65; }
            50% { transform: translateY(-22px) rotate(14deg) scale(1.15); opacity: 1; }
        }

        .splash-hero-frame {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
            animation: splashHeroEnter 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards, splashHeroFloat 4.5s ease-in-out 0.85s infinite;
        }

        .splash-hero-frame::before {
            content: '';
            position: absolute;
            inset: -14px;
            border-radius: 30px;
            background: conic-gradient(from 0deg, rgba(249, 115, 22, 0.65), rgba(251, 191, 36, 0.85), rgba(16, 185, 129, 0.45), rgba(245, 158, 11, 0.85), rgba(249, 115, 22, 0.65));
            filter: blur(22px);
            opacity: 0.7;
            z-index: -1;
            animation: auraPulse 3s ease-in-out infinite alternate;
        }

        .splash-hero-img {
            max-height: 73vh;
            max-width: 100%;
            width: auto;
            height: auto;
            border-radius: 22px;
            border: 3px solid rgba(251, 191, 36, 0.75);
            box-shadow: 0 30px 75px rgba(0, 0, 0, 0.92), 0 0 50px rgba(249, 115, 22, 0.35);
            object-fit: contain;
            background: #120e0b;
        }

        @keyframes splashHeroEnter {
            0% { opacity: 0; transform: scale(0.82) translateY(28px); filter: brightness(1.35); }
            70% { opacity: 1; transform: scale(1.02) translateY(-4px); filter: brightness(1.05); }
            100% { opacity: 1; transform: scale(1) translateY(0); filter: brightness(1); }
        }

        @keyframes splashHeroFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-8px) scale(1.008); }
        }

        @keyframes auraPulse {
            0% { opacity: 0.45; transform: scale(0.98); }
            100% { opacity: 0.85; transform: scale(1.03); }
        }

        .splash-cta-pill {
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: linear-gradient(90deg, rgba(32, 26, 21, 0.95) 0%, rgba(45, 34, 24, 0.95) 50%, rgba(32, 26, 21, 0.95) 100%);
            border: 2px solid rgba(251, 191, 36, 0.65);
            padding: 0.55rem 1.75rem;
            border-radius: 999px;
            font-weight: 800;
            font-size: 1.05rem;
            color: #fbbf24;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.75), 0 0 25px rgba(245, 158, 11, 0.28);
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            animation: pillPulse 2.2s ease-in-out infinite;
        }

        .splash-cta-pill:hover {
            transform: scale(1.04);
            box-shadow: 0 14px 35px rgba(0, 0, 0, 0.85), 0 0 35px rgba(251, 191, 36, 0.5);
        }

        @keyframes pillPulse {
            0%, 100% { box-shadow: 0 12px 30px rgba(0, 0, 0, 0.75), 0 0 20px rgba(245, 158, 11, 0.22); }
            50% { box-shadow: 0 12px 30px rgba(0, 0, 0, 0.75), 0 0 36px rgba(251, 191, 36, 0.55); }
        }

        .eq-bars {
            display: inline-flex;
            align-items: flex-end;
            gap: 3px;
            height: 16px;
        }

        .eq-bar {
            width: 3px;
            background: var(--accent);
            border-radius: 2px;
            animation: eqBounce 0.8s ease-in-out infinite alternate;
        }
        .eq-bar:nth-child(1) { height: 7px; animation-delay: 0s; }
        .eq-bar:nth-child(2) { height: 15px; animation-delay: 0.2s; }
        .eq-bar:nth-child(3) { height: 10px; animation-delay: 0.4s; }
        .eq-bar:nth-child(4) { height: 14px; animation-delay: 0.15s; }

        @keyframes eqBounce {
            0% { transform: scaleY(0.35); }
            100% { transform: scaleY(1); }
        }

        @keyframes teamCardPopIn {
            0% { opacity: 0; transform: translateY(24px) scale(0.88); }
            70% { opacity: 1; transform: translateY(-4px) scale(1.03); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes puzzleStageEnter {
            0% { opacity: 0; transform: scale(0.88) translateY(18px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .puzzle-img.stage-enter {
            animation: puzzleStageEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* RIGHT SCOREBOARD SIDEBAR */
        aside.tv-scoreboard {
            background: var(--bg-panel);
            border-left: 2px solid var(--border-color);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.55);
            z-index: 5;
        }

        .scoreboard-header {
            padding: 1.1rem 1.4rem;
            background: linear-gradient(180deg, #261d17 0%, #1c1510 100%);
            border-bottom: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .scoreboard-title {
            font-size: 1.2rem;
            font-weight: 900;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: 0.5px;
        }

        .matchup-callout {
            background: rgba(249, 115, 22, 0.15);
            border-bottom: 1px solid rgba(249, 115, 22, 0.3);
            padding: 0.6rem 1rem;
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--accent);
            text-align: center;
            display: none;
            flex-shrink: 0;
        }

        .teams-list {
            padding: 0.85rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            overflow-y: auto;
            flex: 1;
        }

        .teams-list::-webkit-scrollbar {
            width: 6px;
        }
        .teams-list::-webkit-scrollbar-thumb {
            background: #3d3228;
            border-radius: 3px;
        }

        .team-card-row {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            transition: all 0.25s ease;
            position: relative;
        }

        .team-card-row.rank-1 {
            border-color: rgba(251, 191, 36, 0.55);
            background: linear-gradient(90deg, rgba(251, 191, 36, 0.15) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.rank-2 {
            border-color: rgba(203, 213, 225, 0.45);
            background: linear-gradient(90deg, rgba(203, 213, 225, 0.1) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.rank-3 {
            border-color: rgba(217, 119, 6, 0.45);
            background: linear-gradient(90deg, rgba(217, 119, 6, 0.1) 0%, rgba(32, 26, 21, 0.95) 100%);
        }

        .team-card-row.eliminated {
            opacity: 0.38;
            filter: grayscale(0.85);
            border-color: rgba(255, 255, 255, 0.06);
            background: #14100d;
        }

        .team-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
            flex: 1;
        }

        .rank-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.92rem;
            font-weight: 800;
            color: #94a3b8;
            width: 26px;
            text-align: center;
            flex-shrink: 0;
        }

        .rank-1 .rank-badge { color: var(--gold); font-size: 1.25rem; }
        .rank-2 .rank-badge { color: var(--silver); font-size: 1.25rem; }
        .rank-3 .rank-badge { color: var(--bronze); font-size: 1.25rem; }

        .team-avatar {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: #120e0b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .team-name-group {
            min-width: 0;
            overflow: hidden;
        }

        .team-name {
            font-weight: 800;
            font-size: 1.05rem;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .team-sub {
            font-size: 0.78rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1px;
        }

        .team-score-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.3rem;
            font-weight: 900;
            color: var(--accent);
            background: #100d0a;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.3rem 0.7rem;
            flex-shrink: 0;
            text-align: right;
            min-width: 62px;
        }

        .rank-1 .team-score-badge {
            color: #fbbf24;
            border-color: rgba(251, 191, 36, 0.45);
            box-shadow: 0 0 14px rgba(251, 191, 36, 0.25);
        }

        .eliminated-tag {
            font-size: 0.65rem;
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.4);
            border-radius: 6px;
            padding: 0.1rem 0.4rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* POINTS AWARDED CELEBRATION & SCOREBOARD ANIMATIONS */
        .team-card-row.points-gained {
            border: 2px solid #10b981 !important;
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.35) 0%, rgba(251, 191, 36, 0.22) 100%) !important;
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.55);
            animation: scoreRowCelebrate 0.9s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 10;
        }

        .team-card-row.points-lost {
            border: 2px solid #ef4444 !important;
            background: linear-gradient(90deg, rgba(239, 68, 68, 0.3) 0%, rgba(32, 26, 21, 0.95) 100%) !important;
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.45);
            animation: scoreRowShake 0.6s ease-in-out;
        }

        @keyframes scoreRowCelebrate {
            0% { transform: scale(1); }
            25% { transform: scale(1.06) translateX(-8px); }
            60% { transform: scale(1.02) translateX(-3px); }
            100% { transform: scale(1) translateX(0); }
        }

        @keyframes scoreRowShake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        .team-score-badge {
            position: relative;
        }

        .team-score-badge.score-pop {
            color: #10b981 !important;
            border-color: #10b981 !important;
            box-shadow: 0 0 22px rgba(16, 185, 129, 0.65) !important;
            animation: scoreBadgePop 0.75s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes scoreBadgePop {
            0% { transform: scale(1); }
            35% { transform: scale(1.38); }
            100% { transform: scale(1); }
        }

        .score-delta-pill {
            position: absolute;
            top: -14px;
            right: -8px;
            padding: 0.18rem 0.6rem;
            border-radius: 999px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.92rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            pointer-events: none;
            z-index: 25;
            white-space: nowrap;
            animation: scoreDeltaFloat 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .score-delta-pill.plus {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: 2px solid #a7f3d0;
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.65);
        }

        .score-delta-pill.minus {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            border: 2px solid #fecaca;
            box-shadow: 0 8px 20px rgba(239, 68, 68, 0.65);
        }

        @keyframes scoreDeltaFloat {
            0% { opacity: 0; transform: translateY(12px) scale(0.5); }
            18% { opacity: 1; transform: translateY(-4px) scale(1.18); }
            75% { opacity: 1; transform: translateY(-12px) scale(1); }
            100% { opacity: 0; transform: translateY(-24px) scale(0.9); }
        }

        .tv-points-burst-banner {
            position: absolute;
            top: 26px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 75;
            display: none;
            align-items: center;
            gap: 1rem;
            padding: 0.95rem 2.4rem;
            border-radius: 999px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.97) 0%, rgba(5, 150, 105, 0.97) 50%, rgba(245, 158, 11, 0.97) 100%);
            border: 3px solid #fde68a;
            box-shadow: 0 20px 55px rgba(0, 0, 0, 0.85), 0 0 50px rgba(16, 185, 129, 0.65);
            color: #ffffff;
            pointer-events: none;
        }

        .tv-points-burst-banner.penalty {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.97) 0%, rgba(185, 28, 28, 0.97) 100%);
            border-color: #fca5a5;
            box-shadow: 0 20px 55px rgba(0, 0, 0, 0.85), 0 0 50px rgba(239, 68, 68, 0.65);
        }

        .tv-points-burst-banner.active {
            display: inline-flex;
            animation: pointsBurstBannerAnim 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes pointsBurstBannerAnim {
            0% { opacity: 0; transform: translateX(-50%) translateY(-35px) scale(0.65); }
            16% { opacity: 1; transform: translateX(-50%) translateY(4px) scale(1.06); }
            26% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
            82% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
            100% { opacity: 0; transform: translateX(-50%) translateY(-25px) scale(0.9); }
        }

        /* TV RULES PRESENTATION CARD */
        .tv-rules-card {
            background: linear-gradient(145deg, rgba(32, 26, 21, 0.96) 0%, rgba(18, 14, 11, 0.99) 100%);
            border: 2px solid rgba(245, 158, 11, 0.45);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 50px rgba(245, 158, 11, 0.18);
            border-radius: 28px;
            padding: 3rem 3.5rem;
            max-width: 900px;
            width: 92%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .tv-rules-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tv-rules-badge {
            font-size: 0.95rem;
            font-weight: 900;
            letter-spacing: 1.5px;
            color: var(--primary);
            text-transform: uppercase;
        }

        .tv-rules-step {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1rem;
            font-weight: 800;
            background: rgba(245, 158, 11, 0.2);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: var(--accent);
            padding: 0.35rem 1rem;
            border-radius: 20px;
            letter-spacing: 1px;
        }

        .tv-rules-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            margin: 0.5rem 0 1.5rem 0;
        }

        .tv-rules-icon-glow {
            font-size: 4.8rem;
            width: 105px;
            height: 105px;
            border-radius: 28px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(249, 115, 22, 0.08) 70%);
            border: 2px solid rgba(245, 158, 11, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 35px rgba(245, 158, 11, 0.3);
        }

        .tv-rules-title {
            font-size: clamp(2.2rem, 3.2vw, 3.2rem);
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 1.25rem;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }

        .tv-rules-desc {
            font-size: clamp(1.25rem, 1.7vw, 1.65rem);
            line-height: 1.6;
            color: #cbd5e1;
            max-width: 780px;
            margin: 0 auto;
        }

        .tv-rules-footer {
            width: 100%;
            display: flex;
            justify-content: center;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .tv-rules-dots {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .rule-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .rule-dot.active {
            background: var(--accent);
            box-shadow: 0 0 14px var(--accent);
            transform: scale(1.35);
        }

        .rule-dot.completed {
            background: var(--success);
        }

        footer.tv-footer {
            flex-shrink: 0;
            padding: 0.5rem 1.5rem;
            background: linear-gradient(180deg, rgba(20, 16, 13, 0.95) 0%, rgba(10, 8, 7, 0.98) 100%);
            border-top: 1px solid var(--border-color);
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            z-index: 10;
        }
    </style>
</head>
<body>
    <header class="tv-header">
