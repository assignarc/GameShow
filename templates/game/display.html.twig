                <div class="answer-overlay" id="tv-answer">ANSWER</div>

                <!-- END OF ROUND ANNOUNCEMENT CARD -->
                <div class="splash-card" id="tv-round-end-card" style="display: none; max-width: 820px; width: 92%; padding: 2.2rem 2.5rem; border: 2px solid var(--accent); box-shadow: 0 20px 60px rgba(0,0,0,0.85);">
                    <div id="tv-end-badge" style="display: inline-block; background: rgba(245, 158, 11, 0.2); border: 1.5px solid var(--accent); color: var(--accent); font-weight: 900; font-size: 0.95rem; padding: 0.35rem 1.2rem; border-radius: 999px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 0.75rem;">
                        🏁 ROUND COMPLETE
                    </div>
                    <h1 id="tv-end-title" style="font-size: 3rem; font-weight: 900; letter-spacing: 1px; color: #fff; margin: 0 0 0.35rem 0;">END OF ROUND 1</h1>
                    <p id="tv-end-subtitle" style="font-size: 1.35rem; color: #cbd5e1; font-weight: 700; margin: 0 0 1.35rem 0;">All round puzzles completed!</p>

                    <!-- UP NEXT ROUND BRIEFING & RULES PREVIEW -->
                    <div id="tv-next-round-box" style="background: rgba(15, 23, 42, 0.75); border: 1.5px solid rgba(249, 115, 22, 0.45); border-radius: 16px; padding: 1.25rem 1.5rem; text-align: left;">
                        <div style="font-size: 0.85rem; font-weight: 900; color: var(--primary); text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 0.35rem;" id="tv-next-round-label">
