{% extends 'base.html.twig' %}

{% block title %}Manage {{ show.name }} | Rebus Game Show{% endblock %}

{% block stylesheets %}
<style>
    .show-header {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .show-header-top {
        width: 100%;
    }

    .show-header-top h1 {
        font-size: 1.9rem;
        font-weight: 800;
        line-height: 1.25;
        margin-bottom: 0.35rem;
    }

    .show-header-top p {
        color: var(--accent);
        font-weight: 600;
        font-size: 1rem;
    }

    .show-header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        width: 100%;
    }

    .tabs-nav {
        display: flex;
        gap: 1rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 2rem;
    }

    .tab-btn {
        background: none;
        border: none;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 1.1rem;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
    }

    .tab-btn.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }

    .tab-pane {
        display: none;
    }
    .tab-pane.active {
        display: block;
    }

    .teams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .team-card {
        background: #191411;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.65rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        transition: all 0.15s ease;
    }

    .team-card:hover {
        border-color: rgba(245, 158, 11, 0.4);
        background: #201b16;
    }

    .team-card-top {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        width: 100%;
    }

    .team-avatar-mini {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        background: rgba(0, 0, 0, 0.4);
        border: 1.5px solid #f97316;
        flex-shrink: 0;
    }

    .team-name-title {
        font-weight: 700;
        font-size: 0.98rem;
        color: #f8fafc;
        line-height: 1.25;
        flex: 1;
        min-width: 0;
    }

    .team-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding-top: 0.35rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .team-meta-line {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.78rem;
        color: var(--text-muted);
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .team-members-tag {
        color: #cbd5e1;
    }

    .team-flight-tag {
        color: var(--accent);
        font-weight: 600;
    }

    .meta-dot {
        color: rgba(255, 255, 255, 0.2);
    }

    .team-bottom-right {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
    }

    .team-pts-badge {
        font-family: 'Bungee', cursive, sans-serif;
        font-size: 0.9rem;
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.25);
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        line-height: 1;
        letter-spacing: 0.5px;
    }

    .team-pts-badge.has-pts {
        color: #10b981;
        background: rgba(16, 185, 129, 0.12);
        border-color: rgba(16, 185, 129, 0.35);
    }

    .btn-mini {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
        font-size: 0.78rem;
        color: #60a5fa;
        transition: all 0.15s ease;
        padding: 0;
    }

    .btn-mini:hover {
        background: rgba(96, 165, 250, 0.15);
        border-color: #60a5fa;
    }

    .btn-mini-del {
        color: #ef4444;
    }

    .btn-mini-del:hover {
        background: rgba(239, 68, 68, 0.15);
        border-color: #ef4444;
    }

    .icon-picker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
        gap: 0.45rem;
        padding: 0.6rem;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        max-height: 160px;
        overflow-y: auto;
    }

    .icon-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        padding: 0.35rem;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .icon-tile:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: scale(1.15);
    }

    .icon-tile.selected {
        border-color: var(--accent);
        background: rgba(245, 158, 11, 0.25);
        box-shadow: 0 0 10px rgba(245, 158, 11, 0.45);
        transform: scale(1.1);
    }

    .rounds-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .round-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.75rem;
    }

    .round-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .round-allocations-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    .round-allocations-table th, .round-allocations-table td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }
    .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-sub);
        margin-bottom: 0.4rem;
    }
    .form-input, .form-select, .form-textarea {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        color: #fff;
        font-family: inherit;
    }

    .rules-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .rule-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
        transition: all 0.2s ease;
    }

    .rule-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .rule-left {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .rule-icon-box {
        font-size: 2.2rem;
        width: 60px;
        height: 60px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .rule-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.35rem;
    }

    .rule-desc {
        color: var(--text-sub);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .rule-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-shrink: 0;
    }

    .round-questions-box {
        margin-top: 1.25rem;
        padding-top: 1.15rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .round-q-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.9rem;
    }

    .round-q-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(225px, 1fr));
        gap: 0.75rem;
    }

    .round-q-card {
        background: #14100d;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        position: relative;
        transition: all 0.15s ease;
    }

    .round-q-card:hover {
        border-color: rgba(245, 158, 11, 0.45);
        transform: translateY(-1px);
    }

    .round-q-card[draggable="true"] {
        cursor: grab;
    }

    .round-q-card.dragging {
        opacity: 0.4;
        border-color: var(--primary);
        cursor: grabbing;
    }

    .round-q-card.drag-over {
        border: 2px dashed var(--accent);
        background: rgba(245, 158, 11, 0.12);
        transform: scale(1.02);
    }

    .round-q-thumb-wrap {
        width: 100%;
        height: 115px;
        background: #ffffff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .round-q-thumb {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .round-q-num-badge {
        position: absolute;
        top: 6px;
        left: 6px;
        background: rgba(15, 23, 42, 0.88);
        color: #fbbf24;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.12rem 0.45rem;
        border-radius: 6px;
        border: 1px solid rgba(251, 191, 36, 0.4);
    }

    .round-q-star-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.88);
        color: #fbbf24;
        font-size: 0.78rem;
        padding: 0.1rem 0.35rem;
        border-radius: 6px;
    }

    .round-q-answer {
        font-weight: 800;
        font-size: 0.88rem;
        color: #f8fafc;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .round-q-meta {
        font-size: 0.74rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.35rem;
    }

    .round-q-actions {
        display: flex;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.35rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .picker-q-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 0.75rem;
        max-height: 54vh;
        overflow-y: auto;
        padding: 0.25rem;
    }

    .picker-q-card {
        background: #14100d;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        padding: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .picker-q-card:hover:not(.disabled) {
        border-color: rgba(249, 115, 22, 0.6);
    }

    .picker-q-card.selected {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.12);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.25);
    }

    .picker-q-card.disabled {
        opacity: 0.48;
        cursor: not-allowed;
        border-style: dashed;
    }
</style>
{% endblock %}

{% block body %}
<div class="show-header">
    <div class="show-header-top">
        <h1>{{ show.name }}</h1>
        <p>{{ show.subtitle }}</p>
    </div>
    <div class="show-header-actions">
        <a href="{{ path('app_show_play', {'id': show.id}) }}" class="btn btn-primary">
            🚀 Enter Host Arena
        </a>
        <button type="button" class="btn btn-secondary" onclick="openHostQrModal()" style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-weight: 700;" title="Scan with iPhone to open Host Arena on mobile">
            📱 Host on iPhone (QR)
        </button>
        <a href="{{ path('app_show_display', {'id': show.id}) }}" target="_blank" class="btn btn-secondary">
            📺 TV Presentation View
        </a>
        <form method="POST" action="{{ path('app_show_reset', {'id': show.id}) }}" onsubmit="return confirm('Refresh &quot;{{ show.name|e('js') }}&quot;? This resets all team scores to 0, clears asked questions history, and returns to Round 1.');" style="margin: 0;">
            <button type="submit" class="btn btn-secondary" style="border-color: rgba(245, 158, 11, 0.4); color: #f59e0b; font-weight: 700;" title="Zero team scores, clear question history, and restart from Round 1">
                🔄 Refresh / Reset Show
            </button>
        </form>
        <form method="POST" action="{{ path('app_show_delete', {'id': show.id}) }}" onsubmit="return confirm('Are you sure you want to permanently delete this game show? All teams, rounds, and show progress will be removed.');" style="margin: 0;">
            <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.35); color: #ef4444; font-weight: 600;" title="Permanently Delete Game Show">
                🗑️ Delete Show
            </button>
        </form>
    </div>

    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; background: rgba(0, 0, 0, 0.35); border: 1px solid var(--border-color); border-radius: 12px; padding: 0.65rem 1rem; margin-top: 0.25rem;">
        <div style="display: flex; align-items: center; gap: 0.65rem;">
            <span style="font-size: 1.35rem;">{{ show.starred_only|default(0) ? '⭐' : '👍' }}</span>
            <div>
                <div style="font-weight: 800; font-size: 0.92rem; color: #fff;">
                    Game Show Puzzle Pool:
                    {% if show.starred_only|default(0) %}
                        <span style="color: #fbbf24;">⭐ Only Starred Puzzles ({{ pool_stats.starred }} available)</span>
                    {% else %}
                        <span style="color: var(--success);">👍 All Included Puzzles ({{ pool_stats.included }} available)</span>
                    {% endif %}
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted);">
                    {% if show.starred_only|default(0) %}
                        Strictly selects from Starred &amp; Included puzzles only. Skipped &amp; Excluded puzzles are never used.
                    {% else %}
                        Starred &amp; Included puzzles ({{ pool_stats.starred }}) always take 1st priority, followed by Unstarred Included puzzles. Skipped &amp; Excluded are never used.
                    {% endif %}
                </div>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
            <form method="POST" action="{{ path('app_show_puzzle_pool', {'id': show.id}) }}" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <input type="hidden" name="starred_only" value="{{ show.starred_only|default(0) ? '0' : '1' }}">
                <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 800; font-size: 0.85rem; padding: 0.45rem 0.9rem; border-radius: 8px; border: 1.5px solid {{ show.starred_only|default(0) ? '#fbbf24' : 'var(--border-color)' }}; background: {{ show.starred_only|default(0) ? 'rgba(251, 191, 36, 0.18)' : 'var(--bg-card)' }}; color: {{ show.starred_only|default(0) ? '#fbbf24' : 'var(--text-main)' }}; transition: all 0.2s ease;">
                    <input type="checkbox" {% if show.starred_only|default(0) %}checked{% endif %} onchange="this.form.submit()" style="width: 16px; height: 16px; accent-color: #fbbf24; cursor: pointer;">
                    <span>⭐ Only Select Starred Puzzles</span>
                </label>
            </form>
            <form method="POST" action="{{ path('app_show_rapid_fire_toggle', {'id': show.id}) }}" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <input type="hidden" name="enable" value="{{ has_rapid_fire|default(false) ? '0' : '1' }}">
                <label title="Automatically adds a Rapid Fire round with all remaining Starred puzzles not yet taken into other rounds (randomized, locked order &amp; selection)" style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 800; font-size: 0.85rem; padding: 0.45rem 0.9rem; border-radius: 8px; border: 1.5px solid {{ has_rapid_fire|default(false) ? '#38bdf8' : 'var(--border-color)' }}; background: {{ has_rapid_fire|default(false) ? 'rgba(56, 189, 248, 0.18)' : 'var(--bg-card)' }}; color: {{ has_rapid_fire|default(false) ? '#38bdf8' : 'var(--text-main)' }}; transition: all 0.2s ease;">
                    <input type="checkbox" {% if has_rapid_fire|default(false) %}checked{% endif %} onchange="this.form.submit()" style="width: 16px; height: 16px; accent-color: #38bdf8; cursor: pointer;">
                    <span>⚡ Rapid Fire Round (Remaining Starred)</span>
                </label>
            </form>
        </div>
    </div>
</div>

<div class="tabs-nav">
    <button class="tab-btn active" onclick="switchTab('teams')">👥 Teams ({{ teams|length }}/12)</button>
    <button class="tab-btn" onclick="switchTab('rounds')">🔄 Rounds & Question Categories ({{ rounds|length }})</button>
    <button class="tab-btn" onclick="switchTab('rules')">📜 Rules & Briefing ({{ rules|length }})</button>
</div>

<!-- TAB 1: TEAMS -->
<div id="tab-teams" class="tab-pane active">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2>Teams & Couples (Max 12)</h2>
        {% if teams|length < 12 %}
            <button class="btn btn-primary btn-sm" onclick="openAddTeamModal()">
                + Add Couple / Team
            </button>
        {% endif %}
    </div>

    <div class="teams-grid">
        {% for t in teams %}
            <div class="team-card">
                <div class="team-card-top">
                    <span class="team-avatar-mini" style="border-color: {{ t.avatar_color }};">{{ t.avatar_emoji }}</span>
                    <span class="team-name-title">{{ t.name }}</span>
                </div>
                <div class="team-card-bottom">
                    <div class="team-meta-line">
                        <span class="team-members-tag">{% if t.members %}👥 {{ t.members }}{% else %}<span style="color: var(--text-muted); font-style: italic;">No members set</span>{% endif %}</span>
                    </div>
                    <div class="team-bottom-right">
                        <span class="team-pts-badge {% if t.score > 0 %}has-pts{% endif %}">{{ t.score }} pts</span>
                        <button type="button" class="btn-mini edit-team-btn" onclick="openEditTeamModal({{ t|json_encode }})" title="Edit Team">✏️</button>
                        <form method="POST" action="{{ path('app_show_team_delete', {'id': show.id, 'teamId': t.id}) }}" onsubmit="return confirm('Remove team &quot;{{ t.name|e('js') }}&quot;?');" style="margin: 0;">
                            <button type="submit" class="btn-mini btn-mini-del" title="Remove Team">✕</button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <p style="color: var(--text-muted);">No teams added yet. Add up to 12 couples!</p>
        {% endfor %}
    </div>
</div>

<!-- TAB 2: ROUNDS -->
<div id="tab-rounds" class="tab-pane">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
        <div>
            <h2 style="margin: 0;">Game Rounds & Elimination Rules</h2>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">Configured for a 1-hour tournament pacing with balanced question quotas.</p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <form method="POST" action="{{ path('app_show_rapid_fire_toggle', {'id': show.id}) }}" style="margin: 0;">
                <input type="hidden" name="enable" value="{{ has_rapid_fire|default(false) ? '0' : '1' }}">
                <label title="Includes all Starred &amp; Included puzzles not yet taken into other rounds, randomized (order &amp; selection locked)" style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 800; font-size: 0.85rem; padding: 0.42rem 0.85rem; border-radius: 8px; border: 1.5px solid {{ has_rapid_fire|default(false) ? '#38bdf8' : 'var(--border-color)' }}; background: {{ has_rapid_fire|default(false) ? 'rgba(56, 189, 248, 0.18)' : 'rgba(255,255,255,0.04)' }}; color: {{ has_rapid_fire|default(false) ? '#38bdf8' : 'var(--text-main)' }};">
                    <input type="checkbox" {% if has_rapid_fire|default(false) %}checked{% endif %} onchange="this.form.submit()" style="width: 16px; height: 16px; accent-color: #38bdf8; cursor: pointer;">
                    <span>⚡ Add Rapid Fire Round (All Remaining Starred)</span>
                </label>
            </form>
            <form method="POST" action="{{ path('app_show_apply_one_hour_template', {'id': show.id}) }}" onsubmit="return confirm('Update rounds to the official 1-Hour Championship structure (4 rounds, 38 questions, calibrated for current active questions)?');" style="margin: 0;">
                <button type="submit" class="btn btn-secondary btn-sm" style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-weight: 700;" title="Apply balanced 4-round 1-hour tournament format">
                    ⏱️ Apply 1-Hour Format (38 Qs)
                </button>
            </form>
            <button class="btn btn-primary btn-sm" onclick="openNewRoundModal()">
                + Add New Round
            </button>
        </div>
    </div>

    <div class="rounds-list">
        {% for r in rounds %}
            {% set allocs = r.allocations|default([]) %}
            <div class="round-card">
                <div class="round-title-row">
                    <div>
                        <span class="badge" style="background: {{ r.round_type == 'rapid_fire' ? 'rgba(56, 189, 248, 0.2)' : 'rgba(249, 115, 22, 0.2)' }}; color: {{ r.round_type == 'rapid_fire' ? '#38bdf8' : 'var(--primary)' }};">
                            {{ r.round_type == 'rapid_fire' ? '⚡ Rapid Fire • Round ' ~ r.round_number : 'Round ' ~ r.round_number }}
                        </span>
                        <h3 style="font-size: 1.35rem; font-weight: 800; display: inline-block; margin-left: 0.5rem;">{{ r.name }}</h3>
                        <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
                            Type: <strong>{{ r.round_type == 'rapid_fire' ? '⚡ Rapid Fire (All Remaining Starred Puzzles • Randomized & Locked)' : (r.round_type == 'head_to_head' ? 'Head-to-Head Flight Matchup' : 'All Teams Open Play') }}</strong> • 
                            Timer: <strong>{{ r.timer_seconds }}s</strong> • 
                            Points: <strong>+{{ r.points_per_question }}</strong> (Steal: +{{ r.steal_points }}) • 
                            Advancement: <strong>{{ r.advancement_type == 'top_x' ? 'Top ' ~ r.advance_top_x ~ ' Teams Advance' : 'All Advance' }}</strong>
                        </div>
                    </div>
                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                        {% if not loop.first %}
                            <form method="POST" action="{{ path('app_show_round_move', {'id': show.id, 'roundId': r.id, 'direction': 'up'}) }}" style="margin: 0;">
                                <button type="submit" class="btn btn-secondary btn-sm" title="Move Up" style="padding: 0.4rem 0.65rem;">⬆️</button>
                            </form>
                        {% endif %}
                        {% if not loop.last %}
                            <form method="POST" action="{{ path('app_show_round_move', {'id': show.id, 'roundId': r.id, 'direction': 'down'}) }}" style="margin: 0;">
                                <button type="submit" class="btn btn-secondary btn-sm" title="Move Down" style="padding: 0.4rem 0.65rem;">⬇️</button>
                            </form>
                        {% endif %}
                        <button type="button" class="btn btn-secondary btn-sm edit-round-btn" data-round="{{ r|json_encode|e('html_attr') }}" style="padding: 0.4rem 0.85rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem;">
                            ✏️ Edit Round
                        </button>
                        {% if rounds|length > 1 %}
                            <form method="POST" action="{{ path('app_show_round_delete', {'id': show.id, 'roundId': r.id}) }}" onsubmit="return confirm('Are you sure you want to delete Round {{ r.round_number }} ({{ r.name|e('js') }})?');" style="margin: 0;">
                                <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.4rem 0.65rem; color: #ef4444; border-color: rgba(239, 68, 68, 0.35);" title="Delete Round">
                                    🗑️
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                <table class="round-allocations-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Number of Questions</th>
                            <th>Difficulty Filter</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for a in allocs %}
                            {% set catName = 'Unknown' %}
                            {% for c in categories %}
                                {% if c.id == a.category_id %}{% set catName = c.name %}{% endif %}
                            {% endfor %}
                            <tr>
                                <td><strong>{{ catName }}</strong></td>
                                <td>{{ a.count }} questions</td>
                                <td><span class="badge" style="background: rgba(255,255,255,0.08);">{{ a.difficulty }}</span></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" style="color: var(--text-muted);">Any category from master bank</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                {% set rQuestions = r.questions|default([]) %}
                <div class="round-questions-box" data-round-type="{{ r.round_type }}">
                    {% if r.round_type == 'rapid_fire' %}
                        <div class="round-q-header" style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.75rem 1rem; border-radius: 10px; margin-bottom: 1rem;">
                            <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
                                <strong style="font-size: 1.05rem; color: #38bdf8;">⚡ Rapid Fire Starred Pool</strong>
                                <span class="badge" id="round-q-count-badge-{{ r.id }}" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.45);">
                                    {{ rQuestions|length }} Remaining Starred Puzzles
                                </span>
                                <span style="font-size: 0.8rem; color: #cbd5e1;">
                                    🔒 <strong>Auto-Selected &amp; Order Locked:</strong> Includes all Starred &amp; Included puzzles not taken into other rounds, in randomized order. Manual selection and reordering are disabled.
                                </span>
                            </div>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <form method="POST" action="{{ path('app_show_round_questions_randomize', {'id': show.id, 'roundId': r.id}) }}" style="margin: 0;">
                                    <input type="hidden" name="mode" value="replace_all">
                                    <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.4rem 0.75rem; border-color: rgba(56, 189, 248, 0.45); color: #38bdf8; font-weight: 700;" title="Re-shuffle the random order of remaining Starred puzzles">
                                        🎲 Re-Shuffle Random Order
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="round-q-grid" id="round-q-grid-{{ r.id }}" data-rapid-fire="1">
                            {% for q in rQuestions %}
                                <div class="round-q-card"
                                     id="round-q-card-{{ r.id }}-{{ q.id }}"
                                     data-round-id="{{ r.id }}"
                                     data-qid="{{ q.id }}"
                                     style="cursor: default; border-color: rgba(56, 189, 248, 0.25);">
                                    <div class="round-q-thumb-wrap">
                                        <span class="round-q-num-badge" style="color: #38bdf8; border-color: rgba(56, 189, 248, 0.4);">RF #{{ loop.index }} • #{{ q.id }}</span>
                                        <span class="round-q-star-badge" title="Starred Puzzle">⭐</span>
                                        <img src="{{ q.media_path }}" alt="{{ q.answer }}" class="round-q-thumb" loading="lazy" draggable="false">
                                    </div>
                                    <div class="round-q-answer" title="{{ q.answer }}">{{ q.answer }}</div>
                                    <div class="round-q-meta">
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ q.category_icon|default('🧩') }} {{ q.category_name }}</span>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 0.68rem; padding: 0.1rem 0.4rem;">{{ q.difficulty }}</span>
                                    </div>
                                    <div class="round-q-actions" style="justify-content: center;">
                                        <span style="font-size: 0.72rem; color: #38bdf8; font-weight: 700;">🔒 Auto-Included Starred • Random Order</span>
                                    </div>
                                </div>
                            {% else %}
                                <div style="grid-column: 1 / -1; text-align: center; padding: 1.5rem; background: rgba(0,0,0,0.25); border: 1px dashed rgba(56, 189, 248, 0.35); border-radius: 12px; color: var(--text-muted);">
                                    All Starred &amp; Included puzzles are currently assigned to earlier rounds! Any unused Starred puzzles will automatically appear here.
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="round-q-header">
                            <div style="display: flex; align-items: center; gap: 0.6rem;">
                                <strong style="font-size: 1.05rem; color: #f8fafc;">🧩 Assigned Round Puzzles</strong>
                                <span class="badge" id="round-q-count-badge-{{ r.id }}" style="background: rgba(16, 185, 129, 0.16); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.35);">
                                    {{ rQuestions|length }} Puzzles
                                </span>
                                <span style="font-size: 0.78rem; color: var(--text-muted);">Drag cards or use ⬅ / ➡ to reorder • Zero duplicates across show</span>
                            </div>
                            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                                <button type="button" class="btn btn-primary btn-sm" onclick="openRoundQuestionPicker({{ r.id }}, {{ r.round_number }}, '{{ r.name|e('js') }}')" style="font-weight: 800; padding: 0.4rem 0.85rem;">
                                    + Add Puzzles to Round {{ r.round_number }}
                                </button>
                                <form method="POST" action="{{ path('app_show_round_questions_randomize', {'id': show.id, 'roundId': r.id}) }}" onsubmit="return confirm('Randomize all puzzles in Round {{ r.round_number }} ({{ r.name|e('js') }})? This will pick a fresh random set of non-duplicate puzzles from the pool.');" style="margin: 0;">
                                    <input type="hidden" name="mode" value="replace_all">
                                    <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.4rem 0.75rem; border-color: rgba(245, 158, 11, 0.4); color: #fbbf24; font-weight: 700;" title="Re-roll random non-duplicate puzzles for this round">
                                        🎲 Randomize Round
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="round-q-grid" id="round-q-grid-{{ r.id }}" data-rapid-fire="0">
                            {% for q in rQuestions %}
                                <div class="round-q-card"
                                     id="round-q-card-{{ r.id }}-{{ q.id }}"
                                     data-round-id="{{ r.id }}"
                                     data-qid="{{ q.id }}"
                                     draggable="true"
                                     ondragstart="onRoundCardDragStart(event, {{ r.id }}, {{ q.id }})"
                                     ondragover="onRoundCardDragOver(event)"
                                     ondragleave="onRoundCardDragLeave(event)"
                                     ondrop="onRoundCardDrop(event, {{ r.id }}, {{ q.id }})"
                                     ondragend="onRoundCardDragEnd(event)">
                                    <div class="round-q-thumb-wrap">
                                        <span class="round-q-num-badge">Q{{ loop.index }} • #{{ q.id }}</span>
                                        {% if q.is_favorite %}
                                            <span class="round-q-star-badge" title="Starred Puzzle">⭐</span>
                                        {% endif %}
                                        <img src="{{ q.media_path }}" alt="{{ q.answer }}" class="round-q-thumb" loading="lazy" draggable="false">
                                    </div>
                                    <div class="round-q-answer" title="{{ q.answer }}">{{ q.answer }}</div>
                                    <div class="round-q-meta">
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ q.category_icon|default('🧩') }} {{ q.category_name }}</span>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 0.68rem; padding: 0.1rem 0.4rem;">{{ q.difficulty }}</span>
                                    </div>
                                    <div class="round-q-actions">
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="moveRoundQuestion({{ r.id }}, {{ q.id }}, 'left')" {% if loop.first %}disabled{% endif %} style="padding: 0.28rem 0.45rem; font-size: 0.75rem;" title="Move earlier in round">
                                            ⬅
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="moveRoundQuestion({{ r.id }}, {{ q.id }}, 'right')" {% if loop.last %}disabled{% endif %} style="padding: 0.28rem 0.45rem; font-size: 0.75rem;" title="Move later in round">
                                            ➡
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="swapRoundQuestion({{ r.id }}, {{ q.id }})" style="flex: 1; padding: 0.28rem 0.4rem; font-size: 0.75rem;" title="Swap with another random puzzle">
                                            🔄 Swap
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="removeRoundQuestion({{ r.id }}, {{ q.id }})" style="padding: 0.28rem 0.45rem; font-size: 0.75rem; color: #ef4444; border-color: rgba(239, 68, 68, 0.35);" title="Remove puzzle from this round">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            {% else %}
                                <div style="grid-column: 1 / -1; text-align: center; padding: 1.5rem; background: rgba(0,0,0,0.25); border: 1px dashed var(--border-color); border-radius: 12px; color: var(--text-muted);">
                                    No puzzles assigned to this round yet. Click <strong>"+ Add Puzzles to Round {{ r.round_number }}"</strong> or <strong>"🎲 Randomize Round"</strong>.
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- TAB 3: RULES & BRIEFING -->
<div id="tab-rules" class="tab-pane">
    <div style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h3 style="margin: 0; font-size: 1.15rem; color: #f59e0b;">📜 Show Tournament Rules</h3>
            <p style="margin: 0.25rem 0 0; color: var(--text-sub); font-size: 0.9rem;">
                These rules are presented 1-by-1 on the TV display during the pre-show briefing.
                Inherited from the Master Common Rules template, customizable per gameshow.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <form method="POST" action="{{ path('app_show_rules_reset_common', {'id': show.id}) }}" onsubmit="return confirm('Reset rules for this show back to the Master Common Rules template? Any show-specific rule edits will be replaced.');" style="margin: 0;">
                <button type="submit" class="btn btn-secondary btn-sm" style="border-color: rgba(245, 158, 11, 0.4); color: #f59e0b;">
                    🔄 Reset to Common Rules
                </button>
            </form>
            <button type="button" class="btn btn-primary btn-sm" onclick="openAddShowRuleModal()">
                + Add Custom Rule
            </button>
        </div>
    </div>

    <div class="rules-grid">
        {% for rule in rules %}
            <div class="rule-card">
                <div class="rule-left">
                    <div class="rule-icon-box">{{ rule.icon|default('📜') }}</div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
                            <span style="font-size: 0.75rem; font-weight: 800; background: rgba(255, 255, 255, 0.1); padding: 0.2rem 0.5rem; border-radius: 6px; text-transform: uppercase; color: var(--accent);">
                                Rule {{ loop.index }}
                            </span>
                            <div class="rule-title" style="margin: 0;">{{ rule.title }}</div>
                        </div>
                        <div class="rule-desc">{{ rule.description }}</div>
                    </div>
                </div>
                <div class="rule-actions">
                    {% if not loop.first %}
                        <form method="POST" action="{{ path('app_show_rules_move', {'id': show.id}) }}" style="margin: 0;">
                            <input type="hidden" name="rule_id" value="{{ rule.id }}">
                            <input type="hidden" name="direction" value="up">
                            <button type="submit" class="btn btn-secondary btn-sm" title="Move Up">⬆</button>
                        </form>
                    {% endif %}
                    {% if not loop.last %}
                        <form method="POST" action="{{ path('app_show_rules_move', {'id': show.id}) }}" style="margin: 0;">
                            <input type="hidden" name="rule_id" value="{{ rule.id }}">
                            <input type="hidden" name="direction" value="down">
                            <button type="submit" class="btn btn-secondary btn-sm" title="Move Down">⬇</button>
                        </form>
                    {% endif %}
                    <button type="button" class="btn btn-secondary btn-sm edit-show-rule-btn" data-rule="{{ rule|json_encode }}" title="Edit Rule">
                        ✏️ Edit
                    </button>
                    <form method="POST" action="{{ path('app_show_rules_delete', {'id': show.id}) }}" onsubmit="return confirm('Delete this rule from this show?');" style="margin: 0;">
                        <input type="hidden" name="rule_id" value="{{ rule.id }}">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete Rule">🗑️</button>
                    </form>
                </div>
            </div>
        {% else %}
            <div style="text-align: center; padding: 3rem; background: var(--bg-card); border-radius: 16px; border: 1px dashed var(--border-color);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📜</div>
                <h3>No Rules Set for this Show</h3>
                <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Inherit the standard rules or create your own custom briefing points.</p>
                <form method="POST" action="{{ path('app_show_rules_reset_common', {'id': show.id}) }}">
                    <button type="submit" class="btn btn-primary">🔄 Inherit Master Common Rules</button>
                </form>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Modal: Add Team -->
<dialog id="add-team-modal" aria-labelledby="add-team-title" style="max-width: 540px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <h2 id="add-team-title" style="margin: 0; font-size: 1.35rem; font-weight: 800;">+ Add Team / Couple</h2>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('add-team-modal').close()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0;">✕</button>
    </div>
    <form method="POST" action="{{ path('app_show_team_add', {'id': show.id}) }}">
        <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; background: rgba(0,0,0,0.25); padding: 0.85rem 1rem; border-radius: 12px; border: 1px solid var(--border-color);">
            <div id="add-team-preview-avatar" style="width: 54px; height: 54px; border-radius: 50%; font-size: 2rem; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); border: 3px solid #f97316; flex-shrink: 0; transition: all 0.2s ease;">
                🍁
            </div>
            <div>
                <div id="add-team-preview-name" style="font-weight: 800; font-size: 1.1rem; color: #fff;">New Team</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Choose an icon below from the official party set</div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="add-team-name">Team Name</label>
            <input type="text" id="add-team-name" name="name" class="form-input" placeholder="e.g. Cider House Rules" required autofocus oninput="document.getElementById('add-team-preview-name').innerText = this.value || 'New Team'">
        </div>
        <div class="form-group">
            <label class="form-label" for="add-team-members">Couple / Member Names</label>
            <input type="text" id="add-team-members" name="members" class="form-input" placeholder="e.g. John & Sarah">
        </div>
        <input type="hidden" name="flight_group" value="General">
        <div class="form-group">
            <label class="form-label">Team Icon & Theme Color (Select from Fixed Set)</label>
            <input type="hidden" id="add-team-emoji" name="avatar_emoji" value="🍁">
            <input type="hidden" id="add-team-color" name="avatar_color" value="#f97316">
            <div class="icon-picker-grid" id="add-icon-picker"></div>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-team-modal').close()">Cancel</button>
            <button type="submit" class="btn btn-primary">Add Team</button>
        </div>
    </form>
</dialog>

<!-- Modal: Edit Team -->
<dialog id="edit-team-modal" aria-labelledby="edit-team-title" style="max-width: 540px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <h2 id="edit-team-title" style="margin: 0; font-size: 1.35rem; font-weight: 800; color: #60a5fa;">✏️ Edit Team / Couple</h2>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('edit-team-modal').close()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0;">✕</button>
    </div>
    <form id="edit-team-form" method="POST" action="">
        <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; background: rgba(0,0,0,0.25); padding: 0.85rem 1rem; border-radius: 12px; border: 1px solid var(--border-color);">
            <div id="edit-team-preview-avatar" style="width: 54px; height: 54px; border-radius: 50%; font-size: 2rem; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); border: 3px solid #f97316; flex-shrink: 0; transition: all 0.2s ease;">
                🍁
            </div>
            <div>
                <div id="edit-team-preview-name" style="font-weight: 800; font-size: 1.1rem; color: #fff;">Team Name</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Choose an icon below from the official party set</div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="edit-team-name">Team Name</label>
            <input type="text" id="edit-team-name" name="name" class="form-input" placeholder="e.g. Cider House Rules" required autofocus oninput="document.getElementById('edit-team-preview-name').innerText = this.value || 'Team Name'">
        </div>

        <div class="form-group">
            <label class="form-label" for="edit-team-members">Couple / Member Names</label>
            <input type="text" id="edit-team-members" name="members" class="form-input" placeholder="e.g. Vishal & Swati">
        </div>

        <input type="hidden" id="edit-team-flight" name="flight_group" value="General">

        <div class="form-group">
            <label class="form-label">Team Icon & Theme Color (Select from Fixed Set)</label>
            <input type="hidden" id="edit-team-emoji" name="avatar_emoji" value="🍁">
            <input type="hidden" id="edit-team-color" name="avatar_color" value="#f97316">
            <div class="icon-picker-grid" id="edit-icon-picker"></div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-team-modal').close()">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</dialog>

<!-- Modal: Add Round -->
<dialog id="round-modal" aria-labelledby="round-modal-title" style="max-width: 700px;">
    <h2 id="round-modal-title" style="margin-bottom: 1.5rem; font-size: 1.35rem; font-weight: 800;">Configure Game Round</h2>
    <form method="POST" action="{{ path('app_show_round_save', {'id': show.id}) }}">
        <input type="hidden" name="round_id" id="edit-round-id" value="0">
        
        <div class="form-group">
            <label class="form-label" for="round-name">Round Name</label>
            <input type="text" id="round-name" name="name" class="form-input" placeholder="e.g. Round 2: Flight Battles" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="round-type">Round Format</label>
                <select id="round-type" name="round_type" class="form-select" onchange="toggleRoundModalCategorySection()">
                    <option value="all_play">All Teams Open Play (Buzz-in / Open)</option>
                    <option value="head_to_head">Head-to-Head Flight Matchups (Paired)</option>
                    <option value="rapid_fire">⚡ Rapid Fire (All Remaining Starred Puzzles - Auto &amp; Locked)</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="round-timer">Question Timer (seconds)</label>
                <input type="number" id="round-timer" name="timer_seconds" class="form-input" value="25" min="10" max="120">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="round-pts">Points per Correct Guess</label>
                <input type="number" id="round-pts" name="points_per_question" class="form-input" value="10" min="1" max="100">
            </div>
            <div class="form-group">
                <label class="form-label" for="round-steal">Steal Points</label>
                <input type="number" id="round-steal" name="steal_points" class="form-input" value="5" min="0" max="50">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="adv-type">Advancement / Elimination</label>
                <select id="adv-type" name="advancement_type" class="form-select">
                    <option value="all">All Teams Advance (No elimination)</option>
                    <option value="top_x">Eliminate: Top X Teams Advance</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="adv-top-x">Top X Teams Advancing</label>
                <input type="number" id="adv-top-x" name="advance_top_x" class="form-input" value="5" min="1" max="12">
            </div>
        </div>

        <div id="round-modal-rapid-fire-notice" style="display: none; margin: 1.25rem 0; padding: 1rem; border-radius: 10px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.35); color: #38bdf8; font-size: 0.88rem; line-height: 1.45;">
            <strong>⚡ Rapid Fire Mode:</strong> Automatically includes all <strong>Starred &amp; Included</strong> puzzles that are not yet taken into other rounds, in randomized order. Manual question selection and order changes are disabled for this round.
        </div>

        <div id="round-modal-cat-allocs-wrap">
            <h4 style="margin: 1.5rem 0 0.75rem 0; font-size: 1rem; color: var(--accent);">Category Question Allocations</h4>
            {% for cat in categories %}
                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0.75rem; align-items: center; margin-bottom: 0.5rem;">
                    <div>
                        <input type="hidden" name="cat_ids[]" value="{{ cat.id }}">
                        <strong>{{ cat.icon }} {{ cat.name }}</strong>
                    </div>
                    <div>
                        <input type="number" name="cat_counts[]" class="form-input cat-count-input" data-cat-id="{{ cat.id }}" placeholder="Questions count" value="0" min="0" max="50">
                    </div>
                    <div>
                        <select name="cat_diffs[]" class="form-select cat-diff-select" data-cat-id="{{ cat.id }}">
                            <option value="Any">Any Difficulty</option>
                            <option value="Simple">Simple</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('round-modal').close()">Cancel</button>
            <button type="submit" id="round-modal-submit" class="btn btn-primary">Save Round Configuration</button>
        </div>
    </form>
</dialog>

<!-- Modal: Add/Edit Show Rule -->
<dialog id="show-rule-modal" aria-labelledby="show-rule-modal-title" style="max-width: 600px;">
    <h2 id="show-rule-modal-title" style="margin-bottom: 1.5rem; font-size: 1.35rem; font-weight: 800;">Rule Briefing Card</h2>
    <form method="POST" action="{{ path('app_show_rules_save', {'id': show.id}) }}">
        <input type="hidden" name="rule_id" id="edit-show-rule-id" value="0">
        
        <div class="form-row" style="grid-template-columns: 80px 1fr;">
            <div class="form-group">
                <label class="form-label" for="show-rule-icon">Icon</label>
                <input type="text" id="show-rule-icon" name="icon" class="form-input" style="font-size: 1.5rem; text-align: center;" value="📜" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="show-rule-title">Rule Title</label>
                <input type="text" id="show-rule-title" name="title" class="form-input" placeholder="e.g. 15-Second Buzzer Limit" required>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="show-rule-desc">Rule Explanation (Displayed large on TV)</label>
            <textarea id="show-rule-desc" name="description" class="form-textarea" rows="4" placeholder="Clear, concise instruction for contestants and audience..." required></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('show-rule-modal').close()">Cancel</button>
            <button type="submit" id="show-rule-modal-submit" class="btn btn-primary">Save Rule</button>
        </div>
    </form>
</dialog>

<!-- Modal: Host Arena Mobile QR Code -->
<dialog id="host-qr-modal" aria-labelledby="host-qr-title" style="max-width: 480px; text-align: center; border-color: rgba(56, 189, 248, 0.4);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 id="host-qr-title" style="margin: 0; font-size: 1.35rem; font-weight: 800; color: #38bdf8;">📱 Host on iPhone / Mobile</h2>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('host-qr-modal').close()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0;">✕</button>
    </div>
    <p style="color: var(--text-sub); font-size: 0.92rem; margin-bottom: 1.25rem;">
        Scan this QR code with your iPhone Camera to wirelessly control the entire game show (questions, reveals, timer, and live scoring).
    </p>

    <div style="background: #ffffff; padding: 1.25rem; border-radius: 18px; display: inline-flex; justify-content: center; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.6); margin-bottom: 1.25rem;">
        <div id="manage-qrcode"></div>
    </div>

    <div style="background: rgba(0, 0, 0, 0.5); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; word-break: break-all; color: var(--accent);">
        <a href="{{ mobile_host_url }}" target="_blank" style="color: inherit; text-decoration: none;">{{ mobile_host_url }}</a>
    </div>

    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1.5rem; line-height: 1.5;">
        📶 <strong>Local Wi-Fi:</strong> Phone must be on the same Wi-Fi network as this machine (Host IP: <code style="color: #fff; background: rgba(255,255,255,0.1); padding: 0.15rem 0.4rem; border-radius: 4px;">{{ lan_ip }}</code>).
    </p>

    <button type="button" class="btn btn-secondary" onclick="document.getElementById('host-qr-modal').close()" style="width: 100%;">Close</button>
</dialog>

<!-- Modal: Add Puzzles to Round (Question Picker) -->
<dialog id="round-question-picker-modal" aria-labelledby="rqp-title" style="max-width: 960px; width: 95%;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h2 id="rqp-title" style="margin: 0; font-size: 1.35rem; font-weight: 800; color: var(--primary);">🧩 Add Puzzles to Round</h2>
            <p id="rqp-subtitle" style="margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--text-muted);">
                Browse Included puzzles below. Duplicate puzzles or answers already in this show are automatically blocked.
            </p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('round-question-picker-modal').close()" style="border-radius: 50%; width: 34px; height: 34px; padding: 0;">✕</button>
    </div>

    <!-- Filters Bar -->
    <div style="display: grid; grid-template-columns: 1.8fr 1.2fr 1fr 1fr auto; gap: 0.65rem; align-items: center; margin-bottom: 1rem; background: rgba(0,0,0,0.3); padding: 0.75rem; border-radius: 12px; border: 1px solid var(--border-color);">
        <input type="text" id="rqp-search" class="form-input" placeholder="🔍 Search answer, keyword, or #ID..." oninput="debouncedLoadPickerQuestions()">
        <select id="rqp-category" class="form-select" onchange="loadPickerQuestions()">
            <option value="0">All Categories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}">{{ cat.icon }} {{ cat.name }}</option>
            {% endfor %}
        </select>
        <select id="rqp-difficulty" class="form-select" onchange="loadPickerQuestions()">
            <option value="Any">Any Difficulty</option>
            <option value="Simple">Simple</option>
            <option value="Medium">Medium</option>
            <option value="Hard">Hard</option>
        </select>
        <select id="rqp-starred" class="form-select" onchange="loadPickerQuestions()">
            <option value="all">⭐ Starred First (All Included)</option>
            <option value="1">⭐ Starred Only</option>
            <option value="0">👍 Unstarred Included</option>
        </select>
        <label style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; cursor: pointer; white-space: nowrap;">
            <input type="checkbox" id="rqp-hide-assigned" checked onchange="loadPickerQuestions()" style="accent-color: var(--primary);">
            Hide already in show
        </label>
    </div>

    <div id="rqp-status-bar" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.6rem; display: flex; justify-content: space-between; align-items: center;">
        <span id="rqp-results-count">Loading puzzles...</span>
        <span id="rqp-selected-count" style="color: #10b981; font-weight: 800;">0 selected</span>
    </div>

    <div class="picker-q-grid" id="rqp-grid">
        <!-- Populated dynamically -->
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <div style="font-size: 0.82rem; color: var(--text-muted);">
            Tip: Click any card to select multiple, or click <strong>+ Add</strong> on a single puzzle.
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('round-question-picker-modal').close()">Done</button>
            <button type="button" class="btn btn-primary" id="rqp-add-selected-btn" onclick="submitSelectedQuestionsToRound()" disabled>
                + Add Selected Puzzles
            </button>
        </div>
    </div>
</dialog>
{% endblock %}

{% block javascripts %}
<script src="/js/qrcode.min.js"></script>
<script>
    let qrGenerated = false;
    function openHostQrModal() {
        const modal = document.getElementById('host-qr-modal');
        modal.showModal();
        if (!qrGenerated) {
            new QRCode(document.getElementById('manage-qrcode'), {
                text: '{{ mobile_host_url|e('js') }}',
                width: 200,
                height: 200,
                colorDark: '#0a0807',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
            qrGenerated = true;
        }
    }
    function switchTab(name) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        const targetBtn = document.querySelector(`[onclick="switchTab('${name}')"]`);
        const targetPane = document.getElementById(`tab-${name}`);
        if (targetBtn && targetPane) {
            targetBtn.classList.add('active');
            targetPane.classList.add('active');
        }
    }

    const FIXED_ICONS = [
        { emoji: '🍁', label: 'Maple Leaf', color: '#f97316' },
        { emoji: '🎃', label: 'Pumpkin', color: '#eab308' },
        { emoji: '🍎', label: 'Apple / Cider', color: '#10b981' },
        { emoji: '🧣', label: 'Cozy Scarf', color: '#3b82f6' },
        { emoji: '🌰', label: 'Acorn', color: '#8b5cf6' },
        { emoji: '🥧', label: 'Fall Pie', color: '#ec4899' },
        { emoji: '🪵', label: 'Firewood', color: '#ef4444' },
        { emoji: '🚜', label: 'Tractor', color: '#14b8a6' },
        { emoji: '🔥', label: 'Bonfire', color: '#f59e0b' },
        { emoji: '🌕', label: 'Harvest Moon', color: '#6366f1' },
        { emoji: '🍂', label: 'Autumn Leaves', color: '#d97706' },
        { emoji: '☕', label: 'Spice Latte', color: '#b45309' },
        { emoji: '🌽', label: 'Harvest Corn', color: '#ca8a04' },
        { emoji: '🦃', label: 'Wild Turkey', color: '#9a3412' },
        { emoji: '🦊', label: 'Autumn Fox', color: '#ea580c' },
        { emoji: '🦉', label: 'Night Owl', color: '#475569' },
        { emoji: '🏆', label: 'Trophy', color: '#eab308' },
        { emoji: '🎯', label: 'Bullseye', color: '#ef4444' },
        { emoji: '🧩', label: 'Puzzle Piece', color: '#06b6d4' },
        { emoji: '⚡', label: 'Lightning Buzzer', color: '#eab308' },
    ];

    function renderIconPicker(containerId, inputEmojiId, inputColorId, previewAvatarId, currentEmoji) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = '';

        FIXED_ICONS.forEach(item => {
            const tile = document.createElement('div');
            tile.className = 'icon-tile' + (item.emoji === currentEmoji ? ' selected' : '');
            tile.innerText = item.emoji;
            tile.title = `${item.label} (${item.emoji})`;
            tile.onclick = () => {
                container.querySelectorAll('.icon-tile').forEach(t => t.classList.remove('selected'));
                tile.classList.add('selected');

                document.getElementById(inputEmojiId).value = item.emoji;
                document.getElementById(inputColorId).value = item.color;

                const preview = document.getElementById(previewAvatarId);
                if (preview) {
                    preview.innerText = item.emoji;
                    preview.style.borderColor = item.color;
                }
            };
            container.appendChild(tile);
        });
    }

    function openAddTeamModal() {
        document.getElementById('add-team-name').value = '';
        document.getElementById('add-team-members').value = '';
        document.getElementById('add-team-flight').value = 'Acorn Flight';
        document.getElementById('add-team-emoji').value = '🍁';
        document.getElementById('add-team-color').value = '#f97316';

        const previewAvatar = document.getElementById('add-team-preview-avatar');
        previewAvatar.innerText = '🍁';
        previewAvatar.style.borderColor = '#f97316';
        document.getElementById('add-team-preview-name').innerText = 'New Team';

        renderIconPicker('add-icon-picker', 'add-team-emoji', 'add-team-color', 'add-team-preview-avatar', '🍁');
        document.getElementById('add-team-modal').showModal();
    }

    function openEditTeamModal(team) {
        const form = document.getElementById('edit-team-form');
        form.action = `/shows/{{ show.id }}/teams/${team.id}/update`;

        document.getElementById('edit-team-name').value = team.name || '';
        document.getElementById('edit-team-members').value = team.members || '';
        document.getElementById('edit-team-flight').value = team.flight_group || 'Acorn Flight';
        document.getElementById('edit-team-emoji').value = team.avatar_emoji || '🍁';
        document.getElementById('edit-team-color').value = team.avatar_color || '#f97316';

        const preview = document.getElementById('edit-team-preview-avatar');
        preview.innerText = team.avatar_emoji || '🍁';
        preview.style.borderColor = team.avatar_color || '#f97316';

        const previewName = document.getElementById('edit-team-preview-name');
        previewName.innerText = team.name || 'Team Name';

        renderIconPicker('edit-icon-picker', 'edit-team-emoji', 'edit-team-color', 'edit-team-preview-avatar', team.avatar_emoji || '🍁');

        document.getElementById('edit-team-modal').showModal();
    }

    function openAddShowRuleModal() {
        document.getElementById('edit-show-rule-id').value = '0';
        document.getElementById('show-rule-modal-title').textContent = 'Add Show Rule';
        document.getElementById('show-rule-modal-submit').textContent = 'Add Rule';
        document.getElementById('show-rule-icon').value = '📜';
        document.getElementById('show-rule-title').value = '';
        document.getElementById('show-rule-desc').value = '';
        document.getElementById('show-rule-modal').showModal();
    }

    function openEditShowRuleModal(rule) {
        document.getElementById('edit-show-rule-id').value = rule.id || 0;
        document.getElementById('show-rule-modal-title').textContent = 'Edit Rule: ' + (rule.title || '');
        document.getElementById('show-rule-modal-submit').textContent = 'Save Changes';
        document.getElementById('show-rule-icon').value = rule.icon || '📜';
        document.getElementById('show-rule-title').value = rule.title || '';
        document.getElementById('show-rule-desc').value = rule.description || '';
        document.getElementById('show-rule-modal').showModal();
    }

    function toggleRoundModalCategorySection() {
        const rType = document.getElementById('round-type')?.value;
        const rfNotice = document.getElementById('round-modal-rapid-fire-notice');
        const catWrap = document.getElementById('round-modal-cat-allocs-wrap');
        if (rType === 'rapid_fire') {
            if (rfNotice) rfNotice.style.display = 'block';
            if (catWrap) catWrap.style.display = 'none';
        } else {
            if (rfNotice) rfNotice.style.display = 'none';
            if (catWrap) catWrap.style.display = 'block';
        }
    }

    function openNewRoundModal() {
        document.getElementById('edit-round-id').value = '0';
        document.getElementById('round-modal-title').textContent = 'Configure New Game Round';
        document.getElementById('round-modal-submit').textContent = 'Create Round';
        document.getElementById('round-name').value = '';
        document.getElementById('round-type').value = 'all_play';
        document.getElementById('round-timer').value = 25;
        document.getElementById('round-pts').value = 10;
        document.getElementById('round-steal').value = 5;
        document.getElementById('adv-type').value = 'all';
        document.getElementById('adv-top-x').value = 5;

        document.querySelectorAll('.cat-count-input').forEach(input => input.value = 0);
        document.querySelectorAll('.cat-diff-select').forEach(select => select.value = 'Any');
        toggleRoundModalCategorySection();

        document.getElementById('round-modal').showModal();
    }

    function openEditRoundModal(round) {
        document.getElementById('edit-round-id').value = round.id;
        document.getElementById('round-modal-title').textContent = 'Edit Round ' + round.round_number + ': ' + round.name;
        document.getElementById('round-modal-submit').textContent = 'Save Round Changes';
        document.getElementById('round-name').value = round.name || '';
        document.getElementById('round-type').value = round.round_type || 'all_play';
        document.getElementById('round-timer').value = round.timer_seconds || 25;
        document.getElementById('round-pts').value = round.points_per_question ?? 10;
        document.getElementById('round-steal').value = round.steal_points ?? 5;
        document.getElementById('adv-type').value = round.advancement_type || 'all';
        document.getElementById('adv-top-x').value = round.advance_top_x || 5;

        // Reset all category inputs
        document.querySelectorAll('.cat-count-input').forEach(input => input.value = 0);
        document.querySelectorAll('.cat-diff-select').forEach(select => select.value = 'Any');

        // Populate existing category allocations
        const allocs = Array.isArray(round.allocations) ? round.allocations : [];
        allocs.forEach(alloc => {
            const countInput = document.querySelector(`.cat-count-input[data-cat-id="${alloc.category_id}"]`);
            if (countInput) {
                countInput.value = alloc.count || 0;
            }
            const diffSelect = document.querySelector(`.cat-diff-select[data-cat-id="${alloc.category_id}"]`);
            if (diffSelect) {
                diffSelect.value = alloc.difficulty || 'Any';
            }
        });
        toggleRoundModalCategorySection();

        document.getElementById('round-modal').showModal();
    }

    const SHOW_ID = {{ show.id }};
    let activePickerRoundId = null;
    let activePickerRoundNumber = 1;
    let activePickerRoundName = '';
    let pickerSelectedIds = new Set();
    let pickerSearchTimer = null;

    function openRoundQuestionPicker(roundId, roundNum, roundName) {
        activePickerRoundId = roundId;
        activePickerRoundNumber = roundNum;
        activePickerRoundName = roundName;
        pickerSelectedIds.clear();
        updatePickerSelectedCount();

        document.getElementById('rqp-title').innerText = `🧩 Add Puzzles to Round ${roundNum}: ${roundName}`;
        document.getElementById('rqp-search').value = '';
        document.getElementById('rqp-modal')?.showModal?.();
        document.getElementById('round-question-picker-modal').showModal();
        loadPickerQuestions();
    }

    function debouncedLoadPickerQuestions() {
        clearTimeout(pickerSearchTimer);
        pickerSearchTimer = setTimeout(loadPickerQuestions, 220);
    }

    function updatePickerSelectedCount() {
        const cnt = pickerSelectedIds.size;
        const lbl = document.getElementById('rqp-selected-count');
        const btn = document.getElementById('rqp-add-selected-btn');
        if (lbl) lbl.innerText = `${cnt} selected`;
        if (btn) {
            btn.disabled = (cnt === 0);
            btn.innerText = cnt > 0
                ? `+ Add ${cnt} Selected Puzzle${cnt > 1 ? 's' : ''} to Round ${activePickerRoundNumber}`
                : '+ Add Selected Puzzles';
        }
    }

    function loadPickerQuestions() {
        if (!activePickerRoundId) return;
        const q = document.getElementById('rqp-search').value.trim();
        const catId = document.getElementById('rqp-category').value;
        const diff = document.getElementById('rqp-difficulty').value;
        const starred = document.getElementById('rqp-starred').value;
        const hideAssigned = document.getElementById('rqp-hide-assigned').checked ? '1' : '0';

        const grid = document.getElementById('rqp-grid');
        const countSpan = document.getElementById('rqp-results-count');
        if (countSpan) countSpan.innerText = 'Loading eligible puzzles...';

        const params = new URLSearchParams({
            q,
            category_id: catId,
            difficulty: diff,
            starred,
            hide_assigned: hideAssigned,
            limit: '120'
        });

        fetch(`/api/shows/${SHOW_ID}/available-questions?${params.toString()}`)
            .then(r => r.json())
            .then(data => {
                const list = Array.isArray(data.questions) ? data.questions : [];
                if (countSpan) {
                    countSpan.innerText = `Showing ${list.length} Included puzzle${list.length === 1 ? '' : 's'} (${data.total_in_show || 0} total assigned across show)`;
                }
                grid.innerHTML = '';

                if (list.length === 0) {
                    grid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; padding: 2.5rem; color: var(--text-muted);">No matching Included puzzles found. Try clearing your search or category filter.</div>`;
                    return;
                }

                list.forEach(item => {
                    const card = document.createElement('div');
                    const isSelected = pickerSelectedIds.has(item.id);
                    card.className = 'picker-q-card' + (!item.can_select ? ' disabled' : (isSelected ? ' selected' : ''));
                    card.dataset.qid = item.id;

                    const starHtml = item.is_favorite ? `<span class="round-q-star-badge" title="Starred">⭐</span>` : '';
                    const actionHtml = item.can_select
                        ? `<button type="button" class="btn btn-primary btn-sm" style="width: 100%; padding: 0.3rem 0.5rem; font-size: 0.78rem; font-weight: 800;" onclick="event.stopPropagation(); addSingleQuestionToRound(${item.id});">+ Add to Round ${activePickerRoundNumber}</button>`
                        : `<div style="font-size: 0.72rem; color: #f59e0b; font-weight: 800; text-align: center; padding: 0.25rem; background: rgba(245, 158, 11, 0.12); border-radius: 6px;">🚫 ${item.duplicate_reason || 'Already in Show'}</div>`;

                    card.innerHTML = `
                        <div class="round-q-thumb-wrap" style="height: 105px;">
                            <span class="round-q-num-badge">#${item.id}</span>
                            ${starHtml}
                            <img src="${item.media_path}" alt="" class="round-q-thumb" loading="lazy">
                        </div>
                        <div class="round-q-answer" title="${item.answer}">${item.answer}</div>
                        <div class="round-q-meta">
                            <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${item.category_icon || '🧩'} ${item.category_name}</span>
                            <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 0.65rem; padding: 0.1rem 0.35rem;">${item.difficulty}</span>
                        </div>
                        <div style="margin-top: auto; padding-top: 0.3rem;">
                            ${actionHtml}
                        </div>
                    `;

                    if (item.can_select) {
                        card.addEventListener('click', () => {
                            if (pickerSelectedIds.has(item.id)) {
                                pickerSelectedIds.delete(item.id);
                                card.classList.remove('selected');
                            } else {
                                pickerSelectedIds.add(item.id);
                                card.classList.add('selected');
                            }
                            updatePickerSelectedCount();
                        });
                    }

                    grid.appendChild(card);
                });
            });
    }

    function syncRapidFireGridsFromPayload(rfList) {
        if (!Array.isArray(rfList)) return;
        rfList.forEach(rf => {
            if (rf && rf.round_id) {
                renderRoundQuestionsGrid(rf.round_id, rf.questions || [], true);
            }
        });
    }

    function addSingleQuestionToRound(qId) {
        if (!activePickerRoundId) return;
        fetch(`/shows/${SHOW_ID}/rounds/${activePickerRoundId}/questions/add`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ question_ids: [qId] })
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                alert(data.error || 'Could not add puzzle (duplicate or ineligible).');
                return;
            }
            pickerSelectedIds.delete(qId);
            updatePickerSelectedCount();
            renderRoundQuestionsGrid(activePickerRoundId, data.round_questions || []);
            syncRapidFireGridsFromPayload(data.rapid_fire_rounds);
            loadPickerQuestions();
        });
    }

    function submitSelectedQuestionsToRound() {
        if (!activePickerRoundId || pickerSelectedIds.size === 0) return;
        const ids = Array.from(pickerSelectedIds);
        fetch(`/shows/${SHOW_ID}/rounds/${activePickerRoundId}/questions/add`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ question_ids: ids })
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                alert(data.error || 'Could not add selected puzzles.');
                return;
            }
            pickerSelectedIds.clear();
            updatePickerSelectedCount();
            renderRoundQuestionsGrid(activePickerRoundId, data.round_questions || []);
            syncRapidFireGridsFromPayload(data.rapid_fire_rounds);
            loadPickerQuestions();
        });
    }

    function removeRoundQuestion(roundId, qId) {
        fetch(`/shows/${SHOW_ID}/rounds/${roundId}/questions/${qId}/remove`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                renderRoundQuestionsGrid(roundId, data.round_questions || []);
                syncRapidFireGridsFromPayload(data.rapid_fire_rounds);
            }
        });
    }

    function swapRoundQuestion(roundId, qId) {
        fetch(`/shows/${SHOW_ID}/rounds/${roundId}/questions/${qId}/swap`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                alert(data.error || 'No alternative unused puzzles available to swap.');
                return;
            }
            renderRoundQuestionsGrid(roundId, data.round_questions || []);
            syncRapidFireGridsFromPayload(data.rapid_fire_rounds);
        });
    }

    let draggedRoundId = null;
    let draggedQId = null;

    function moveRoundQuestion(roundId, qId, direction) {
        fetch(`/shows/${SHOW_ID}/rounds/${roundId}/questions/reorder`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ question_id: qId, direction })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                renderRoundQuestionsGrid(roundId, data.round_questions || []);
            }
        });
    }

    function onRoundCardDragStart(e, roundId, qId) {
        draggedRoundId = roundId;
        draggedQId = qId;
        e.currentTarget.classList.add('dragging');
        if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', String(qId));
        }
    }

    function onRoundCardDragOver(e) {
        e.preventDefault();
        if (e.dataTransfer) {
            e.dataTransfer.dropEffect = 'move';
        }
        e.currentTarget.classList.add('drag-over');
    }

    function onRoundCardDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }

    function onRoundCardDragEnd(e) {
        e.currentTarget.classList.remove('dragging');
        document.querySelectorAll('.round-q-card.drag-over').forEach(el => el.classList.remove('drag-over'));
    }

    function onRoundCardDrop(e, targetRoundId, targetQId) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        if (draggedRoundId !== targetRoundId || !draggedQId || draggedQId === targetQId) {
            return;
        }

        const grid = document.getElementById(`round-q-grid-${targetRoundId}`);
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll('.round-q-card'));
        const currentIds = cards.map(c => parseInt(c.dataset.qid)).filter(Boolean);
        const fromIdx = currentIds.indexOf(draggedQId);
        const toIdx = currentIds.indexOf(targetQId);
        if (fromIdx === -1 || toIdx === -1) return;

        currentIds.splice(fromIdx, 1);
        currentIds.splice(toIdx, 0, draggedQId);

        fetch(`/shows/${SHOW_ID}/rounds/${targetRoundId}/questions/reorder`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ question_ids: currentIds })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                renderRoundQuestionsGrid(targetRoundId, data.round_questions || []);
            }
        });
    }

    function renderRoundQuestionsGrid(roundId, questions, forceRapidFire = null) {
        const grid = document.getElementById(`round-q-grid-${roundId}`);
        const badge = document.getElementById(`round-q-count-badge-${roundId}`);
        const isRapidFire = forceRapidFire !== null
            ? forceRapidFire
            : (grid && grid.dataset.rapidFire === '1');

        if (badge) {
            badge.innerText = isRapidFire
                ? `${questions.length} Remaining Starred Puzzles`
                : `${questions.length} Puzzles`;
        }
        if (!grid) return;

        if (!questions || questions.length === 0) {
            grid.innerHTML = isRapidFire
                ? `<div style="grid-column: 1 / -1; text-align: center; padding: 1.5rem; background: rgba(0,0,0,0.25); border: 1px dashed rgba(56, 189, 248, 0.35); border-radius: 12px; color: var(--text-muted);">All Starred &amp; Included puzzles are currently assigned to earlier rounds! Any unused Starred puzzles will automatically appear here.</div>`
                : `<div style="grid-column: 1 / -1; text-align: center; padding: 1.5rem; background: rgba(0,0,0,0.25); border: 1px dashed var(--border-color); border-radius: 12px; color: var(--text-muted);">No puzzles assigned to this round yet. Click <strong>"+ Add Puzzles"</strong> or <strong>"🎲 Randomize Round"</strong>.</div>`;
            return;
        }

        grid.innerHTML = '';
        questions.forEach((q, idx) => {
            const card = document.createElement('div');
            card.className = 'round-q-card';
            card.id = `round-q-card-${roundId}-${q.id}`;
            card.dataset.roundId = roundId;
            card.dataset.qid = q.id;

            if (isRapidFire) {
                card.style.cursor = 'default';
                card.style.borderColor = 'rgba(56, 189, 248, 0.25)';
                card.innerHTML = `
                    <div class="round-q-thumb-wrap">
                        <span class="round-q-num-badge" style="color: #38bdf8; border-color: rgba(56, 189, 248, 0.4);">RF #${idx + 1} • #${q.id}</span>
                        <span class="round-q-star-badge" title="Starred Puzzle">⭐</span>
                        <img src="${q.media_path}" alt="" class="round-q-thumb" loading="lazy" draggable="false">
                    </div>
                    <div class="round-q-answer" title="${q.answer}">${q.answer}</div>
                    <div class="round-q-meta">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${q.category_icon || '🧩'} ${q.category_name}</span>
                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 0.68rem; padding: 0.1rem 0.4rem;">${q.difficulty}</span>
                    </div>
                    <div class="round-q-actions" style="justify-content: center;">
                        <span style="font-size: 0.72rem; color: #38bdf8; font-weight: 700;">🔒 Auto-Included Starred • Random Order</span>
                    </div>
                `;
            } else {
                card.draggable = true;
                card.ondragstart = (ev) => onRoundCardDragStart(ev, roundId, q.id);
                card.ondragover = (ev) => onRoundCardDragOver(ev);
                card.ondragleave = (ev) => onRoundCardDragLeave(ev);
                card.ondrop = (ev) => onRoundCardDrop(ev, roundId, q.id);
                card.ondragend = (ev) => onRoundCardDragEnd(ev);

                const starHtml = q.is_favorite ? `<span class="round-q-star-badge" title="Starred Puzzle">⭐</span>` : '';
                const firstDisabled = (idx === 0) ? 'disabled' : '';
                const lastDisabled = (idx === questions.length - 1) ? 'disabled' : '';
                card.innerHTML = `
                    <div class="round-q-thumb-wrap">
                        <span class="round-q-num-badge">Q${idx + 1} • #${q.id}</span>
                        ${starHtml}
                        <img src="${q.media_path}" alt="" class="round-q-thumb" loading="lazy" draggable="false">
                    </div>
                    <div class="round-q-answer" title="${q.answer}">${q.answer}</div>
                    <div class="round-q-meta">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${q.category_icon || '🧩'} ${q.category_name}</span>
                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 0.68rem; padding: 0.1rem 0.4rem;">${q.difficulty}</span>
                    </div>
                    <div class="round-q-actions">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="moveRoundQuestion(${roundId}, ${q.id}, 'left')" ${firstDisabled} style="padding: 0.28rem 0.45rem; font-size: 0.75rem;" title="Move earlier in round">
                            ⬅
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="moveRoundQuestion(${roundId}, ${q.id}, 'right')" ${lastDisabled} style="padding: 0.28rem 0.45rem; font-size: 0.75rem;" title="Move later in round">
                            ➡
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="swapRoundQuestion(${roundId}, ${q.id})" style="flex: 1; padding: 0.28rem 0.4rem; font-size: 0.75rem;" title="Swap with another random puzzle">
                            🔄 Swap
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="removeRoundQuestion(${roundId}, ${q.id})" style="padding: 0.28rem 0.45rem; font-size: 0.75rem; color: #ef4444; border-color: rgba(239, 68, 68, 0.35);" title="Remove puzzle from this round">
                            ✕
                        </button>
                    </div>
                `;
            }
            grid.appendChild(card);
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Activate tab if URL hash is present (e.g. #tab-rules)
        if (window.location.hash) {
            const hashTab = window.location.hash.replace('#tab-', '').replace('#', '');
            if (['teams', 'rounds', 'rules'].includes(hashTab)) {
                switchTab(hashTab);
            }
        }

        document.querySelectorAll('.edit-show-rule-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                try {
                    const ruleData = JSON.parse(this.dataset.rule);
                    openEditShowRuleModal(ruleData);
                } catch (e) {
                    console.error('Failed to parse rule data', e);
                }
            });
        });

        document.querySelectorAll('.edit-round-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                try {
                    const roundData = JSON.parse(this.dataset.round);
                    openEditRoundModal(roundData);
                } catch (e) {
                    console.error('Failed to parse round data', e);
                }
            });
        });
    });
</script>
{% endblock %}

