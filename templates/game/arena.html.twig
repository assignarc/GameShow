{% extends 'base.html.twig' %}

{% block title %}Host Arena | {{ show.name }}{% endblock %}

{% block stylesheets %}
<style>
    /* ==========================================================================
       HOST ARENA — RESPONSIVE COCKPIT (Desktop, Tablet / iPad, Phone / iPhone)
       ========================================================================== */
    :root {
        --arena-target: 32px;
    }
    @media (pointer: coarse) {
        :root {
            --arena-target: 44px;
        }
    }

    /* Desktop & Tablet Landscape/Portrait (>= 768px): Dual-pane zero-scroll cockpit */
    @media (min-width: 768px) {
        html, body {
            overflow: hidden !important;
            height: 100vh !important;
            height: 100dvh !important;
        }
        main.container {
            padding: 0.65rem 1rem !important;
            max-width: 1640px !important;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 !important;
            min-height: 0 !important;
            height: calc(100vh - 60px) !important;
            height: calc(100dvh - 60px) !important;
            overflow: hidden !important;
        }
        footer.site-footer {
            display: none !important;
        }
        .arena-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) clamp(290px, 31vw, 370px);
            gap: 0.85rem;
            height: 100%;
            min-height: 0;
            flex: 1;
            overflow: hidden;
        }
    }

    /* Phone / Small Handheld (< 768px): Single-column Remote + Segmented Tabs + Thumb Dock */
    @media (max-width: 767px) {
        main.container {
            padding: 0.5rem 0.65rem 0 0.65rem !important;
        }
        footer.site-footer {
            display: none !important;
        }
        .arena-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            height: auto;
            gap: 0.75rem;
            padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px));
        }
    }

    .arena-menu-container {
        position: relative;
    }

    .arena-menu-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-color);
        color: #f8fafc;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .arena-menu-btn:hover, .arena-menu-btn.active {
        background: rgba(249, 115, 22, 0.2);
        border-color: var(--primary);
        color: var(--primary);
    }

    .arena-dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        background: rgba(24, 20, 17, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1.5px solid var(--border-color);
        border-radius: 14px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.85);
        padding: 0.45rem;
        min-width: 220px;
        max-width: min(270px, calc(100vw - 1.5rem));
        max-height: calc(100vh - 140px);
        max-height: calc(100dvh - 140px);
        overflow-y: auto;
        overscroll-behavior: contain;
        z-index: 200;
        animation: menuDropdownFade 0.18s ease-out;
    }
    .arena-dropdown-menu.open {
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
    }

    @keyframes menuDropdownFade {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .arena-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        background: transparent;
        border: none;
        color: #f8fafc;
        text-decoration: none;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
        width: 100%;
        transition: background 0.15s ease;
    }
    .arena-dropdown-item:hover, .arena-dropdown-item:active {
        background: rgba(255, 255, 255, 0.08);
    }
    .arena-dropdown-item.danger {
        color: #f87171;
    }
    .arena-dropdown-item.danger:hover {
        background: rgba(239, 68, 68, 0.15);
    }

    .arena-dropdown-icon {
        font-size: 1.25rem;
        flex-shrink: 0;
        line-height: 1;
    }

    .arena-dropdown-title {
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.2;
    }

    .arena-dropdown-sub {
        font-size: 0.72rem;
        color: var(--text-muted);
        margin-top: 1px;
    }

    .arena-dropdown-divider {
        height: 1px;
        background: var(--border-color);
        margin: 0.25rem 0.5rem;
    }

    .main-stage {
        container: stage / inline-size;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
        height: 100%;
        min-height: 0;
    }

    .stage-top-bar {
        padding: 0.65rem 1.15rem;
        background: rgba(0, 0, 0, 0.5);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
        flex-shrink: 0;
    }

    .top-bar-left {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        overflow: hidden;
    }

    .top-round-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        overflow: hidden;
    }

    .round-badge-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: #000;
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.75px;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(249, 115, 22, 0.35);
    }

    .round-indicator, .round-name-text {
        font-weight: 800;
        font-size: 1.05rem;
        color: #f8fafc;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    .top-meta-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        overflow: hidden;
    }

    .top-cat-badge {
        font-size: 0.72rem;
        padding: 0.15rem 0.55rem;
        border-radius: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        display: inline-block;
    }

    .top-bar-right {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .timer-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .timer-display {
        font-family: 'Bungee', monospace;
        font-size: 2.3rem;
        color: var(--accent);
        min-width: 70px;
        text-align: center;
        line-height: 1;
    }
    .timer-display.danger {
        color: var(--danger);
        animation: pulse 0.6s infinite alternate;
    }

    @keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    .puzzle-viewport {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: safe center;
        padding: 0.65rem 1rem;
        position: relative;
        background: radial-gradient(circle at center, #1e1814 0%, #0d0b09 100%);
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
        gap: 0.5rem;
    }

    .puzzle-img-wrap {
        width: 100%;
        max-width: 96%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 1 auto;
        min-height: 0;
        position: relative;
        gap: 1rem;
    }

    .quick-sfx-overlay-btn {
        position: static;
        flex-shrink: 0;
        z-index: 15;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.7rem 0.75rem;
        min-width: 74px;
        border-radius: 16px;
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        background: transparent;
        color: #fff;
        font-weight: 900;
        font-size: 0.78rem;
        letter-spacing: 0.4px;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        transition: transform 0.14s ease, background 0.14s ease, border-color 0.14s ease;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .quick-sfx-overlay-btn .q-icon {
        font-size: 1.55rem;
        line-height: 1;
    }

    .quick-sfx-overlay-btn.correct {
        border-color: rgba(16, 185, 129, 0.55);
        background: rgba(16, 185, 129, 0.08);
    }

    .quick-sfx-overlay-btn.wrong {
        border-color: rgba(239, 68, 68, 0.55);
        background: rgba(239, 68, 68, 0.08);
    }

    .quick-sfx-overlay-btn.correct:hover {
        background: rgba(16, 185, 129, 0.2);
        transform: scale(1.06);
    }

    .quick-sfx-overlay-btn.wrong:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: scale(1.06);
    }

    .quick-sfx-overlay-btn:active {
        transform: scale(0.94);
    }

    @media (max-width: 767px) {
        .puzzle-img-wrap {
            gap: 0;
        }
        .quick-sfx-overlay-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            min-width: 54px;
            padding: 0.5rem 0.4rem;
            font-size: 0.66rem;
            border-radius: 12px;
        }
        .quick-sfx-overlay-btn.correct {
            left: 4px;
            background: rgba(16, 185, 129, 0.14);
        }
        .quick-sfx-overlay-btn.wrong {
            right: 4px;
            background: rgba(239, 68, 68, 0.14);
        }
        .quick-sfx-overlay-btn:hover {
            transform: translateY(-50%) scale(1.06);
        }
        .quick-sfx-overlay-btn:active {
            transform: translateY(-50%) scale(0.94);
        }
        .quick-sfx-overlay-btn .q-icon {
            font-size: 1.2rem;
        }
    }

    .puzzle-img {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 42dvh;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7);
        object-fit: contain;
    }

    .answer-banner {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(16, 185, 129, 0.95);
        color: #000;
        padding: 0.65rem 2rem;
        border-radius: 12px;
        font-size: 1.5rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.5);
        display: none;
        animation: slideUp 0.3s ease-out;
        z-index: 10;
    }

    .time-up-banner {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(239, 68, 68, 0.95);
        color: #fff;
        padding: 0.4rem 1.75rem;
        border-radius: 10px;
        font-size: 1.2rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.6);
        display: none;
        animation: slideDown 0.3s ease-out;
        z-index: 10;
    }

    @keyframes slideUp {
        from { transform: translate(-50%, 20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }
    @keyframes slideDown {
        from { transform: translate(-50%, -20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }

    .stage-controls {
        padding: 0.5rem 0.9rem;
        background: rgba(0, 0, 0, 0.55);
        border-top: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        flex-shrink: 0;
        flex-wrap: wrap;
        min-height: 54px;
    }

    .desktop-action-group {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        flex-wrap: wrap;
        min-width: 0;
    }

    .desktop-action-group .btn {
        min-height: var(--arena-target);
        padding: 0.42rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 700;
        border-radius: 8px;
        white-space: nowrap;
        gap: 0.35rem;
    }

    .round-nav-group {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        flex-shrink: 0;
        flex-wrap: nowrap;
        margin-inline-start: auto;
    }

    .round-nav-group select.form-select-sm {
        min-height: var(--arena-target);
        background: var(--bg-card);
        color: #fff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.35rem 0.55rem;
        font-size: 0.82rem;
        font-weight: 700;
        max-width: 210px;
    }

    @container stage (max-width: 680px) {
        .stage-controls {
            flex-direction: column;
            align-items: stretch;
            gap: 0.45rem;
            padding: 0.55rem 0.75rem;
        }
        .desktop-action-group {
            justify-content: space-between;
        }
        .desktop-action-group .btn {
            flex: 1 1 auto;
            padding: 0.4rem 0.5rem;
            font-size: 0.8rem;
        }
        .round-nav-group {
            margin-inline-start: 0;
            width: 100%;
            justify-content: space-between;
        }
        .round-nav-group select.form-select-sm {
            flex: 1;
            max-width: none;
        }
    }

    /* Sidebar Scoreboard */
    .scoreboard-panel {
        container: scoreboard / inline-size;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
        min-height: 0;
    }

    .panel-header {
        padding: 0.85rem 1.15rem;
        background: rgba(0, 0, 0, 0.4);
        border-bottom: 1px solid var(--border-color);
        font-weight: 800;
        font-size: 1.05rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .teams-list-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
        padding: 0.65rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .team-row {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.65rem 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }
    .team-row.eliminated {
        opacity: 0.4;
        filter: grayscale(1);
    }

    .team-score-ctrl {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-shrink: 0;
    }

    .score-btn {
        background: rgba(249, 115, 22, 0.15);
        color: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.82rem;
        min-height: max(36px, var(--arena-target));
        min-width: 40px;
        padding: 0.3rem 0.55rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    /* On narrower tablet/sidebar widths, stack score buttons cleanly below team name so names never get crushed */
    @container scoreboard (max-width: 335px) {
        .team-row {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
            padding: 0.65rem 0.75rem;
        }
        .team-score-ctrl {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.4rem;
        }
        .score-btn {
            width: 100%;
        }
    }
    .score-btn:hover, .score-btn:active {
        background: var(--primary);
        color: #000;
        transform: scale(1.05);
    }

    .team-row.points-gained {
        border-color: #10b981 !important;
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.35) 0%, rgba(251, 191, 36, 0.22) 100%) !important;
        box-shadow: 0 0 22px rgba(16, 185, 129, 0.55);
        animation: arenaPointsGlow 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .team-row.points-lost {
        border-color: #ef4444 !important;
        background: linear-gradient(90deg, rgba(239, 68, 68, 0.32) 0%, rgba(20, 16, 13, 0.95) 100%) !important;
        animation: arenaPointsShake 0.55s ease;
    }
    @keyframes arenaPointsGlow {
        0% { transform: scale(1); }
        30% { transform: scale(1.035) translateX(-3px); }
        100% { transform: scale(1) translateX(0); }
    }
    @keyframes arenaPointsShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        50% { transform: translateX(5px); }
        75% { transform: translateX(-3px); }
    }
    .arena-score-delta-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 900;
        margin-left: 0.35rem;
        animation: arenaDeltaPop 1.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .arena-score-delta-badge.plus {
        background: linear-gradient(135deg, #10b981, #fbbf24);
        color: #052e16;
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.5);
    }
    .arena-score-delta-badge.minus {
        background: linear-gradient(135deg, #ef4444, #991b1b);
        color: #fff;
    }
    @keyframes arenaDeltaPop {
        0% { opacity: 0; transform: scale(0.5) translateY(6px); }
        20% { opacity: 1; transform: scale(1.15) translateY(-2px); }
        80% { opacity: 1; transform: scale(1) translateY(-4px); }
        100% { opacity: 0; transform: scale(0.9) translateY(-10px); }
    }

    /* Mobile Responsive Layout & Touch Dock */
    .mobile-arena-tabs {
        display: none;
        background: rgba(0, 0, 0, 0.65);
        border-bottom: 1px solid var(--border-color);
        padding: 0.5rem 0.75rem;
        gap: 0.5rem;
    }

    .mobile-tab-btn {
        flex: 1;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.65rem 0.75rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .mobile-tab-btn.active {
        background: rgba(249, 115, 22, 0.18);
        border-color: var(--primary);
        color: var(--primary);
    }

    .host-clue-card {
        background: linear-gradient(135deg, rgba(20, 16, 13, 0.95) 0%, rgba(32, 26, 21, 0.98) 100%);
        border: 1.5px solid rgba(16, 185, 129, 0.5);
        border-radius: 12px;
        padding: 0.45rem 0.9rem;
        width: 90%;
        max-width: 580px;
        margin-top: 0.45rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
        box-sizing: border-box;
        flex-shrink: 0;
    }

    .host-clue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.2rem;
    }

    .host-clue-badge {
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: var(--accent);
        text-transform: uppercase;
    }

    .host-tv-status {
        font-size: 0.68rem;
        font-weight: 800;
        padding: 0.15rem 0.5rem;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-muted);
    }
    .host-tv-status.revealed {
        background: rgba(16, 185, 129, 0.25);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.5);
    }

    .host-clue-answer {
        font-size: 1.25rem;
        font-weight: 900;
        color: #10b981;
        letter-spacing: 0.5px;
        line-height: 1.15;
    }

    .host-clue-prompt {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-top: 0.1rem;
    }

    /* Fixed Floating Thumb Dock for iPhone */
    .floating-host-dock {
        display: none;
    }

    .qa-point-btn {
        flex: 1;
        background: var(--bg-card);
        border: 1.5px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0.6rem 0.5rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        white-space: nowrap;
    }
    .qa-point-btn.active {
        background: rgba(245, 158, 11, 0.2);
        border-color: var(--accent);
        color: var(--accent);
        transform: scale(1.02);
    }

    .qa-team-tile {
        background: var(--bg-dark);
        border: 1.5px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        cursor: pointer;
        transition: all 0.15s ease;
        text-align: left;
    }
    .qa-team-tile:hover, .qa-team-tile:active {
        border-color: var(--primary);
        background: rgba(249, 115, 22, 0.15);
        transform: scale(1.02);
    }

    .qa-teams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
        gap: 0.65rem;
        max-height: 55dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0.2rem;
    }

    .arena-splash-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    @media (max-width: 520px) {
        .arena-splash-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .sidebar-tab-bar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem;
        padding: 0.55rem 0.65rem;
        background: rgba(0, 0, 0, 0.45);
        border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
    }

    .sidebar-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-muted);
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.45rem 0.5rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
        min-height: 38px;
    }
    .sidebar-tab-btn:hover {
        color: #f8fafc;
        background: rgba(255, 255, 255, 0.05);
    }
    .sidebar-tab-btn.active {
        background: rgba(249, 115, 22, 0.18);
        border-color: rgba(249, 115, 22, 0.55);
        color: var(--primary);
    }

    .sounds-panel-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0.55rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .sfx-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.4rem;
    }

    .sfx-section-label {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        padding: 0.1rem 0.15rem 0;
    }

    .sfx-divider {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.35rem 0 0.1rem;
        color: var(--text-muted);
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .sfx-divider::before,
    .sfx-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border-color);
    }

    .sfx-tile {
        background: var(--bg-dark);
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        padding: 0.45rem 0.55rem;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        cursor: pointer;
        text-align: left;
        color: #f8fafc;
        min-height: max(42px, var(--arena-target));
        transition: all 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .sfx-tile:hover, .sfx-tile:active {
        border-color: #c084fc;
        background: rgba(168, 85, 247, 0.16);
        transform: scale(0.99);
    }

    @media (max-width: 767px) {
        .sidebar-tab-bar {
            display: none;
        }
        .mobile-arena-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            position: sticky;
            top: 56px;
            z-index: 40;
            border-radius: 12px;
            margin-bottom: 0.5rem;
        }

        .mobile-tab-btn {
            min-height: 44px;
            font-size: 0.84rem;
            padding: 0.45rem 0.35rem;
            white-space: nowrap;
        }

        .main-stage {
            border-radius: 16px;
            overflow: visible;
        }

        .arena-dropdown-menu {
            min-width: 195px;
            padding: 0.35rem;
            max-height: calc(100dvh - 180px);
        }

        .arena-dropdown-item {
            padding: 0.45rem 0.6rem;
            gap: 0.55rem;
            min-height: 40px;
        }

        .arena-dropdown-icon {
            font-size: 1.05rem;
        }

        .arena-dropdown-title {
            font-size: 0.85rem;
        }

        .arena-dropdown-sub {
            display: none;
        }

        .arena-dropdown-divider {
            margin: 0.2rem 0.35rem;
        }

        .stage-top-bar {
            padding: 0.55rem 0.75rem;
            gap: 0.45rem;
        }

        .round-badge-pill {
            font-size: 0.68rem;
            padding: 0.15rem 0.45rem;
        }

        .round-indicator, .round-name-text {
            font-size: 0.92rem;
        }

        .top-cat-badge {
            font-size: 0.68rem;
            padding: 0.12rem 0.45rem;
        }

        .desktop-only-btn, .desktop-only-label, .desktop-only-inline {
            display: none !important;
        }

        .timer-display {
            font-size: 1.75rem;
            min-width: 44px;
        }

        .sound-toggle-btn, .arena-menu-btn {
            padding: 0.35rem 0.6rem;
            font-size: 0.85rem;
            min-height: 40px;
            min-width: 40px;
        }

        #rules-ctrl-bar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.6rem;
            padding: 0.65rem 0.75rem !important;
        }

        .puzzle-viewport {
            padding: 0.75rem 0.65rem;
            min-height: 46dvh;
            justify-content: flex-start;
            overflow: visible;
        }

        /* On phones, show the Secret Answer Key FIRST so the Host sees it immediately without scrolling! */
        #host-clue-card {
            order: -1;
            width: 100%;
            margin-top: 0;
            margin-bottom: 0.35rem;
            padding: 0.6rem 0.85rem;
        }

        .host-clue-answer {
            font-size: 1.35rem;
        }

        .puzzle-img-wrap {
            max-width: 100%;
            max-height: none;
        }

        .puzzle-img {
            max-height: 36dvh;
        }

        #no-question-splash, #arena-rules-card {
            width: 100% !important;
            padding: 1.1rem 1rem !important;
        }

        .stage-controls {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.6rem 0.75rem;
            background: rgba(0, 0, 0, 0.5);
        }

        .desktop-action-group {
            display: none !important;
        }

        .round-nav-group {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.45rem;
            width: 100%;
        }

        .round-nav-group select,
        .round-nav-group .btn {
            min-height: 44px;
        }

        .round-nav-group select {
            flex: 1;
            min-width: 0;
            background: var(--bg-card);
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 0.4rem 0.6rem;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .scoreboard-panel {
            display: none;
            border-radius: 16px;
            height: auto;
            overflow: visible;
        }

        .panel-header {
            padding: 0.55rem 0.85rem;
            font-size: 0.95rem;
        }

        .teams-list-scroll,
        .sounds-panel-scroll {
            overflow-y: visible;
            height: auto;
            padding: 0.45rem;
            gap: 0.35rem;
        }

        .team-row {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 0.45rem;
            padding: 0.45rem 0.6rem;
            border-radius: 10px;
        }

        .team-score-ctrl {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            flex-shrink: 0;
        }

        .score-btn {
            min-height: 40px;
            min-width: 40px;
            width: auto;
            padding: 0.25rem 0.48rem;
            font-size: 0.8rem;
        }

        .floating-host-dock {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(20, 16, 13, 0.96);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 2px solid rgba(245, 158, 11, 0.45);
            padding: 0.55rem max(0.65rem, env(safe-area-inset-right, 0px)) max(0.6rem, env(safe-area-inset-bottom, 0px)) max(0.65rem, env(safe-area-inset-left, 0px));
            gap: 0.45rem;
            align-items: center;
            justify-content: space-between;
            z-index: 100;
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.85);
        }

        .dock-btn {
            min-height: 48px;
            font-size: 0.92rem;
            font-weight: 800;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            text-align: center;
            white-space: nowrap;
            padding: 0 0.4rem;
            transition: transform 0.15s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .dock-btn:active {
            transform: scale(0.96);
        }

        .dock-btn-next {
            flex: 1.35;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
        }

        .dock-btn-reveal {
            flex: 1.25;
            background: #10b981;
            color: #000;
        }

        .dock-btn-award {
            flex: 1.2;
            background: #f59e0b;
            color: #000;
        }

        .dock-btn-icon {
            width: 46px;
            min-width: 44px;
            flex-shrink: 0;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: #fff;
            font-size: 1.15rem;
        }

        #quick-award-modal:modal {
            max-width: 100%;
            width: 100%;
            margin: auto auto 0 auto;
            border-radius: 24px 24px 0 0;
            border-bottom: none;
            max-height: 85dvh;
            padding: 1.25rem max(1rem, env(safe-area-inset-right, 0px)) max(1.25rem, env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));
            animation: slideUpSheet 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUpSheet {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
    }
</style>
{% endblock %}

{% block body %}
<!-- MOBILE VIEW SWITCHER (Visible on phones) -->
<div class="mobile-arena-tabs" id="mobile-tabs">
    <button type="button" class="mobile-tab-btn active" id="tab-stage-btn" onclick="setArenaMobileTab('stage')">
        🎮 Stage
    </button>
    <button type="button" class="mobile-tab-btn" id="tab-scores-btn" onclick="setArenaMobileTab('scores')">
        🏆 Scores (<span id="mobile-team-count">0</span>)
    </button>
    <button type="button" class="mobile-tab-btn" id="tab-sounds-btn" onclick="setArenaMobileTab('sounds')">
        🎭 Sounds
    </button>
</div>

<div class="arena-layout">
    <!-- MAIN STAGE -->
    <div class="main-stage" id="arena-main-stage">
        <div class="stage-top-bar">
            <div class="top-bar-left">
                <div class="top-round-row">
                    <span class="round-badge-pill" id="round-badge-num">ROUND 1</span>
                    <span class="round-indicator" id="round-indicator">Warm-Up</span>
                </div>
                <div class="top-meta-row">
                    <span class="badge top-cat-badge" id="cat-badge" style="background: var(--primary); color: #000;">Ready</span>
                </div>
            </div>
            <div class="top-bar-right">
                <div class="arena-menu-container">
                    <button type="button" class="btn btn-secondary btn-sm arena-menu-btn" id="arena-menu-btn" onclick="toggleArenaMenu()" aria-expanded="false" title="Show navigation & tools">
                        ⚙️ <span class="arena-menu-label">Menu</span> ▾
                    </button>
                    <div class="arena-dropdown-menu" id="arena-dropdown-menu">
                        <a href="{{ path('app_show_manage', {'id': show.id}) }}" class="arena-dropdown-item">
                            <span class="arena-dropdown-icon">⚙️</span>
                            <div>
                                <div class="arena-dropdown-title">Manage Show</div>
                                <div class="arena-dropdown-sub">Settings, teams & rounds</div>
                            </div>
                        </a>
                        <a href="{{ path('app_show_display', {'id': show.id}) }}" target="_blank" class="arena-dropdown-item">
                            <span class="arena-dropdown-icon">📺</span>
                            <div>
                                <div class="arena-dropdown-title">TV Display ↗</div>
                                <div class="arena-dropdown-sub">Audience presentation</div>
                            </div>
                        </a>
                        <div class="arena-dropdown-divider"></div>
                        <button type="button" class="arena-dropdown-item" onclick="triggerAction('start_rules'); closeArenaMenu();">
                            <span class="arena-dropdown-icon">📜</span>
                            <div>
                                <div class="arena-dropdown-title">Rules Briefing</div>
                                <div class="arena-dropdown-sub">Present rules 1-by-1 on TV</div>
                            </div>
                        </button>
                        <button type="button" class="arena-dropdown-item" onclick="triggerAction('start_sample_puzzle'); closeArenaMenu();">
                            <span class="arena-dropdown-icon">🎯</span>
                            <div>
                                <div class="arena-dropdown-title">Sample Tryout Puzzle</div>
                                <div class="arena-dropdown-sub">Practice "FALL PARTY" puzzle on TV</div>
                            </div>
                        </button>
                        <button type="button" class="arena-dropdown-item" onclick="openArenaQrModal(); closeArenaMenu();">
                            <span class="arena-dropdown-icon">📱</span>
                            <div>
                                <div class="arena-dropdown-title">iPhone Remote QR</div>
                                <div class="arena-dropdown-sub">Host arena on your phone</div>
                            </div>
                        </button>
                        <button type="button" class="arena-dropdown-item" id="btn-sound" onclick="toggleSound(); closeArenaMenu();">
                            <span class="arena-dropdown-icon" id="menu-sound-icon">🔇</span>
                            <div>
                                <div class="arena-dropdown-title" id="menu-sound-title">Host Audio: Muted</div>
                                <div class="arena-dropdown-sub" id="menu-sound-sub">Mute/unmute sounds on this device</div>
                            </div>
                        </button>
                        <div class="arena-dropdown-divider"></div>
                        <button type="button" class="arena-dropdown-item danger" onclick="resetShowConfirm(); closeArenaMenu();">
                            <span class="arena-dropdown-icon">🔄</span>
                            <div>
                                <div class="arena-dropdown-title">Reset Game Show</div>
                                <div class="arena-dropdown-sub">Reset scores &amp; state (keeps questions)</div>
                            </div>
                        </button>
                        <button type="button" class="arena-dropdown-item" onclick="resetQuestionsConfirm(); closeArenaMenu();">
                            <span class="arena-dropdown-icon">🎲</span>
                            <div>
                                <div class="arena-dropdown-title" style="color: #c084fc;">Reset Questions</div>
                                <div class="arena-dropdown-sub">Choose new questions (keeps settings &amp; scores)</div>
                            </div>
                        </button>
                    </div>
                </div>

                <button type="button" class="btn btn-secondary btn-sm desktop-only-btn" onclick="openArenaQrModal()" title="Show Mobile QR Code to scan with phone" style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-weight: 700;">
                    📱 QR
                </button>
            </div>
        </div>

        <!-- RULES BRIEFING CONTROL BAR -->
        <div id="rules-ctrl-bar" style="display: none; background: linear-gradient(90deg, rgba(245, 158, 11, 0.15) 0%, rgba(32, 26, 21, 0.95) 100%); border-bottom: 2px solid var(--accent); padding: 0.75rem 1.5rem; align-items: center; justify-content: space-between; flex-shrink: 0;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <span style="font-size: 1.6rem;" id="arena-rule-icon-small">📜</span>
                <div>
                    <div style="font-size: 0.75rem; font-weight: 800; color: var(--accent); text-transform: uppercase;" id="arena-rule-step-small">TV DISPLAYING: RULE 1 OF 6</div>
                    <strong style="font-size: 1.05rem; color: #fff;" id="arena-rule-title-small">Rule Title</strong>
                </div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-rule" onclick="triggerAction('prev_rule')">⬅ Prev Rule</button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-next-rule" onclick="triggerAction('next_rule')">Next Rule ➡</button>
                <button type="button" class="btn btn-success btn-sm" onclick="triggerAction('finish_rules')" style="font-weight: 700;">🎯 Sample Puzzle</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="triggerAction('close_rules')" title="Close rules briefing">✕ Close</button>
            </div>
        </div>

        <div class="puzzle-viewport" id="viewport">
            <div class="time-up-banner" id="time-up-banner">⏰ TIME IS UP!</div>

            <!-- RULES BRIEFING PREVIEW CARD (HOST VIEW) -->
            <div id="arena-rules-card" style="display: none; text-align: center; max-width: 650px; background: rgba(32, 26, 21, 0.96); border: 2px solid var(--accent); border-radius: 20px; padding: 2.25rem 2.5rem; box-shadow: 0 15px 40px rgba(0,0,0,0.7);">
                <div style="font-size: 0.8rem; font-weight: 900; color: var(--accent); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 1rem;" id="arena-rule-badge">SHOW RULES BRIEFING • AUDIENCE VIEW</div>
                <div style="font-size: 3.8rem; width: 85px; height: 85px; margin: 0 auto 1.25rem auto; border-radius: 22px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); display: flex; align-items: center; justify-content: center;" id="arena-rule-icon">💡</div>
                <h2 style="font-size: 1.85rem; font-weight: 900; color: #fff; margin-bottom: 1rem;" id="arena-rule-title">Say What You See</h2>
                <p style="font-size: 1.15rem; line-height: 1.6; color: #cbd5e1; margin-bottom: 1.5rem;" id="arena-rule-desc">Call out the famous phrase, movie, object, or idiom hidden in the picture puzzle.</p>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;" id="arena-rule-hint">Advance 1-by-1 with "Next Rule ➡" to unveil each rule on TV, then proceed to the Sample Tryout Puzzle.</div>
            </div>

            <div class="puzzle-img-wrap" id="img-wrap">
                <button type="button" class="quick-sfx-overlay-btn correct" id="quick-sfx-correct" style="display: none;" onclick="playRandomQuickSfx('correct')" title="Play random Correct Answer sound on TV">
                    <span class="q-icon">✅</span>
                    <span>Correct</span>
                </button>
                <img src="" alt="Rebus Puzzle" class="puzzle-img" id="puzzle-image" style="display: none;">
                <button type="button" class="quick-sfx-overlay-btn wrong" id="quick-sfx-wrong" style="display: none;" onclick="playRandomQuickSfx('wrong')" title="Play random Wrong Answer sound on TV">
                    <span class="q-icon">❌</span>
                    <span>Wrong</span>
                </button>
                <div id="no-question-splash" style="text-align: center; color: var(--text-muted); max-width: 660px; width: 95%; background: rgba(32, 26, 21, 0.92); border: 1.5px solid var(--border-color); border-radius: 18px; padding: 1.5rem 1.75rem;">
                    <div style="font-size: 2.75rem; margin-bottom: 0.4rem;" id="arena-splash-icon">🍁</div>
                    <div id="arena-splash-badge" style="display: inline-block; background: rgba(249, 115, 22, 0.18); border: 1px solid var(--primary); color: var(--primary); font-weight: 800; font-size: 0.78rem; padding: 0.2rem 0.85rem; border-radius: 999px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.45rem;">
                        📺 TV SCREEN IS SHOWING: SPLASH SCREEN
                    </div>
                    <h2 id="arena-splash-title" style="color: #fff; font-size: 1.5rem; font-weight: 900; margin-bottom: 0.3rem;">Welcome Splash Screen is Live on TV</h2>
                    <p id="arena-splash-sub" style="margin-bottom: 0.85rem; font-size: 0.95rem; color: #cbd5e1;">The TV screen is displaying the Khapre Party splash screen. Click Next to unveil the competing teams!</p>
                    <div id="arena-splash-preview-wrap" style="display: none; margin-bottom: 0.85rem;">
                        <img src="/media/khapre_party_splash.jpg" alt="Splash Preview" style="max-height: 140px; max-width: 100%; border-radius: 12px; border: 2px solid rgba(251, 191, 36, 0.45); box-shadow: 0 8px 25px rgba(0,0,0,0.6);">
                    </div>
                    <div id="arena-splash-stats" class="arena-splash-stats-grid"></div>
                    <div id="arena-splash-meta" style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.85rem;"></div>
                    <div id="arena-splash-btn-group" style="display: flex; justify-content: center; gap: 0.55rem; flex-wrap: wrap;">
                        <button type="button" class="btn btn-secondary btn-sm" id="arena-splash-prev-btn" onclick="triggerAction('prev_team')" style="display: none; font-weight: 700;">
                            ⬅ Prev Team
                        </button>
                        <button type="button" class="btn btn-primary" id="arena-splash-action-btn" onclick="hostNextStep()" style="font-weight: 800; padding: 0.6rem 1.5rem;">
                            👥 Next: Introduce Team 1 on TV
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" id="arena-splash-skip-btn" onclick="triggerAction('finish_teams')" style="display: none; font-weight: 700;">
                            ⏭️ Skip to Rules
                        </button>
                    </div>
                </div>
            </div>

            <!-- HOST SECRET ANSWER KEY (Always visible to host!) -->
            <div class="host-clue-card" id="host-clue-card" style="display: none;">
                <div class="host-clue-header">
                    <span class="host-clue-badge">🤫 HOST ANSWER KEY</span>
                    <span class="host-tv-status" id="host-tv-status">📺 Hidden on TV</span>
                </div>
                <div class="host-clue-answer" id="host-clue-answer">ANSWER GOES HERE</div>
            </div>

            <div class="answer-banner" id="answer-banner">
                <span id="answer-text">ANSWER GOES HERE</span>
            </div>
        </div>

        <!-- TIMER BAR (Right below puzzle screen, above controls) -->
        <div id="arena-timer-bar" style="display: none; align-items: center; justify-content: center; gap: 0.6rem; padding: 0.35rem 1rem; background: rgba(0, 0, 0, 0.48); border-top: 1px solid var(--border-color); flex-shrink: 0;">
            <span class="timer-label" id="arena-timer-label" style="font-weight: 800; letter-spacing: 0.75px;">⏱️ TIME LEFT:</span>
            <div class="timer-display" id="timer-box" style="font-size: 1.95rem; min-width: 54px;">25</div>
        </div>

        <div class="stage-controls">
            <div class="desktop-action-group">
                <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-q" onclick="triggerAction('prev_question')" title="Previous Question (Go back in history)">
                    ⏮️ Prev
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-next-q" onclick="hostNextStep()" title="Advance to Next Stage or Question">
                    ▶️ Next
                </button>
                <button type="button" class="btn btn-success btn-sm" id="btn-reveal" onclick="triggerAction('reveal_answer')">
                    💡 Reveal
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="openQuickAward()" style="background: rgba(245, 158, 11, 0.2); border-color: var(--accent); color: var(--accent); font-weight: 700;">
                    🏆 Points
                </button>
                <button type="button" class="btn btn-secondary btn-sm" id="btn-pause" onclick="toggleTimer()">
