{% extends 'base.html.twig' %}

{% block title %}Host Arena | {{ show.name }}{% endblock %}

{% block stylesheets %}
<style>
    .arena-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1.5rem;
        height: calc(100vh - 140px);
    }

    .arena-menu-container {
        position: relative;
    }

    .arena-menu-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-color);
        color: #f8fafc;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .arena-menu-btn:hover, .arena-menu-btn.active {
        background: rgba(249, 115, 22, 0.2);
        border-color: var(--primary);
        color: var(--primary);
    }

    .arena-dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        background: rgba(24, 20, 17, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1.5px solid var(--border-color);
        border-radius: 14px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.85);
        padding: 0.5rem;
        min-width: 240px;
        z-index: 200;
        animation: menuDropdownFade 0.18s ease-out;
    }
    .arena-dropdown-menu.open {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    @keyframes menuDropdownFade {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .arena-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        background: transparent;
        border: none;
        color: #f8fafc;
        text-decoration: none;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
        width: 100%;
        transition: background 0.15s ease;
    }
    .arena-dropdown-item:hover, .arena-dropdown-item:active {
        background: rgba(255, 255, 255, 0.08);
    }
    .arena-dropdown-item.danger {
        color: #f87171;
    }
    .arena-dropdown-item.danger:hover {
        background: rgba(239, 68, 68, 0.15);
    }

    .arena-dropdown-icon {
        font-size: 1.25rem;
        flex-shrink: 0;
        line-height: 1;
    }

    .arena-dropdown-title {
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.2;
    }

    .arena-dropdown-sub {
        font-size: 0.72rem;
        color: var(--text-muted);
        margin-top: 1px;
    }

    .arena-dropdown-divider {
        height: 1px;
        background: var(--border-color);
        margin: 0.25rem 0.5rem;
    }

    .main-stage {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    .stage-top-bar {
        padding: 0.85rem 1.25rem;
        background: rgba(0, 0, 0, 0.5);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
    }

    .top-bar-left {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        overflow: hidden;
    }

    .top-round-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        overflow: hidden;
    }

    .round-badge-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: #000;
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.75px;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(249, 115, 22, 0.35);
    }

    .round-indicator, .round-name-text {
        font-weight: 800;
        font-size: 1.05rem;
        color: #f8fafc;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    .top-meta-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        overflow: hidden;
    }

    .top-cat-badge {
        font-size: 0.72rem;
        padding: 0.15rem 0.55rem;
        border-radius: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        display: inline-block;
    }

    .top-bar-right {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .timer-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .timer-display {
        font-family: 'Bungee', monospace;
        font-size: 2.3rem;
        color: var(--accent);
        min-width: 70px;
        text-align: center;
        line-height: 1;
    }
    .timer-display.danger {
        color: var(--danger);
        animation: pulse 0.6s infinite alternate;
    }

    @keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    .puzzle-viewport {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
        background: radial-gradient(circle at center, #1e1814 0%, #0d0b09 100%);
    }

    .puzzle-img-wrap {
        width: 100%;
        max-width: 90%;
        max-height: 58vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .puzzle-img {
        width: 100%;
        height: auto;
        max-width: 100%;
        max-height: 56vh;
        border-radius: 14px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
        object-fit: contain;
    }

    .answer-banner {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(16, 185, 129, 0.95);
        color: #000;
        padding: 0.9rem 2.5rem;
        border-radius: 14px;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.5);
        display: none;
        animation: slideUp 0.3s ease-out;
    }

    .time-up-banner {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(239, 68, 68, 0.95);
        color: #fff;
        padding: 0.5rem 2rem;
        border-radius: 10px;
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.6);
        display: none;
        animation: slideDown 0.3s ease-out;
    }

    @keyframes slideUp {
        from { transform: translate(-50%, 20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }
    @keyframes slideDown {
        from { transform: translate(-50%, -20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }

    .stage-controls {
        padding: 1rem 1.5rem;
        background: rgba(0, 0, 0, 0.5);
        border-top: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    /* Sidebar Scoreboard */
    .scoreboard-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .panel-header {
        padding: 1rem 1.25rem;
        background: rgba(0, 0, 0, 0.4);
        border-bottom: 1px solid var(--border-color);
        font-weight: 800;
        font-size: 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .teams-list-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .team-row {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
    }
    .team-row.eliminated {
        opacity: 0.4;
        filter: grayscale(1);
    }

    .team-score-ctrl {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .score-btn {
        background: rgba(249, 115, 22, 0.15);
        color: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.85rem;
        min-height: 38px;
        padding: 0.35rem 0.65rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .score-btn:hover, .score-btn:active {
        background: var(--primary);
        color: #000;
        transform: scale(1.05);
    }

    /* Mobile Responsive Layout & Touch Dock */
    .mobile-arena-tabs {
        display: none;
        background: rgba(0, 0, 0, 0.65);
        border-bottom: 1px solid var(--border-color);
        padding: 0.5rem 0.75rem;
        gap: 0.5rem;
    }

    .mobile-tab-btn {
        flex: 1;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.65rem 0.75rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .mobile-tab-btn.active {
        background: rgba(249, 115, 22, 0.18);
        border-color: var(--primary);
        color: var(--primary);
    }

    .host-clue-card {
        background: linear-gradient(135deg, rgba(20, 16, 13, 0.95) 0%, rgba(32, 26, 21, 0.98) 100%);
        border: 1.5px solid rgba(16, 185, 129, 0.5);
        border-radius: 14px;
        padding: 0.85rem 1.25rem;
        width: 92%;
        max-width: 650px;
        margin-top: 1rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        box-sizing: border-box;
    }

    .host-clue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .host-clue-badge {
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: var(--accent);
        text-transform: uppercase;
    }

    .host-tv-status {
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-muted);
    }
    .host-tv-status.revealed {
        background: rgba(16, 185, 129, 0.25);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.5);
    }

    .host-clue-answer {
        font-size: 1.45rem;
        font-weight: 900;
        color: #10b981;
        letter-spacing: 0.5px;
    }

    .host-clue-prompt {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-top: 0.15rem;
    }

    /* Fixed Floating Thumb Dock for iPhone */
    .floating-host-dock {
        display: none;
    }

    .qa-point-btn {
        flex: 1;
        background: var(--bg-card);
        border: 1.5px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0.6rem 0.5rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        white-space: nowrap;
    }
    .qa-point-btn.active {
        background: rgba(245, 158, 11, 0.2);
        border-color: var(--accent);
        color: var(--accent);
        transform: scale(1.02);
    }

    .qa-team-tile {
        background: var(--bg-dark);
        border: 1.5px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        cursor: pointer;
        transition: all 0.15s ease;
        text-align: left;
    }
    .qa-team-tile:hover, .qa-team-tile:active {
        border-color: var(--primary);
        background: rgba(249, 115, 22, 0.15);
        transform: scale(1.02);
    }

    @media (max-width: 900px) {
        .arena-layout {
            grid-template-columns: 1fr;
            height: auto;
            gap: 1rem;
            padding-bottom: 95px;
        }

        .mobile-arena-tabs {
            display: flex;
        }

        .main-stage {
            border-radius: 16px;
        }

        .stage-top-bar {
            padding: 0.55rem 0.75rem;
            gap: 0.5rem;
        }

        .round-badge-pill {
            font-size: 0.7rem;
            padding: 0.15rem 0.45rem;
        }

        .round-indicator, .round-name-text {
            font-size: 0.92rem;
        }

        .top-cat-badge {
            font-size: 0.68rem;
            padding: 0.1rem 0.45rem;
        }

        .desktop-only-btn, .desktop-only-label, .desktop-only-inline {
            display: none !important;
        }

        .timer-display {
            font-size: 1.85rem;
            min-width: 46px;
        }

        .sound-toggle-btn {
            padding: 0.35rem 0.6rem;
            font-size: 0.85rem;
            min-height: 36px;
        }

        .puzzle-viewport {
            padding: 1rem 0.75rem;
            min-height: 44vh;
        }

        .puzzle-img-wrap {
            max-height: 34vh;
        }

        .puzzle-img {
            max-height: 32vh;
        }

        .stage-controls {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.65rem 0.85rem;
            background: rgba(0, 0, 0, 0.5);
        }

        .desktop-action-group {
            display: none !important;
        }

        .round-nav-group {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.4rem;
            width: 100%;
        }

        .round-nav-group select {
            flex: 1;
            min-width: 0;
            background: var(--bg-card);
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 0.4rem 0.6rem;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .floating-host-dock {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(20, 16, 13, 0.96);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 2px solid rgba(245, 158, 11, 0.4);
            padding: 0.65rem 0.85rem max(0.65rem, env(safe-area-inset-bottom)) 0.85rem;
            gap: 0.5rem;
            align-items: center;
            justify-content: space-between;
            z-index: 100;
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.8);
        }

        .dock-btn {
            height: 50px;
            font-size: 0.98rem;
            font-weight: 800;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            text-align: center;
            transition: all 0.15s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .dock-btn:active {
            transform: scale(0.96);
        }

        .dock-btn-next {
            flex: 1.3;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
        }

        .dock-btn-reveal {
            flex: 1.3;
            background: #10b981;
            color: #000;
        }

        .dock-btn-award {
            flex: 1.3;
            background: #f59e0b;
            color: #000;
        }

        .dock-btn-icon {
            width: 48px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: #fff;
            font-size: 1.25rem;
        }

        #quick-award-modal:modal {
            max-width: 100%;
            width: 100%;
            margin: auto auto 0 auto;
            border-radius: 24px 24px 0 0;
            border-bottom: none;
            max-height: 85vh;
            padding: 1.5rem 1.25rem max(1.5rem, env(safe-area-inset-bottom)) 1.25rem;
            animation: slideUpSheet 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUpSheet {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
    }
</style>
{% endblock %}

{% block body %}
<!-- MOBILE VIEW SWITCHER (Visible on phones) -->
<div class="mobile-arena-tabs" id="mobile-tabs">
    <button type="button" class="mobile-tab-btn active" id="tab-stage-btn" onclick="setArenaMobileTab('stage')">
        🎮 Stage & Answers
    </button>
    <button type="button" class="mobile-tab-btn" id="tab-scores-btn" onclick="setArenaMobileTab('scores')">
        🏆 Scoreboard (<span id="mobile-team-count">0</span>)
    </button>
</div>

<div class="arena-layout">
    <!-- MAIN STAGE -->
    <div class="main-stage" id="arena-main-stage">
        <div class="stage-top-bar">
            <div class="top-bar-left">
                <div class="top-round-row">
                    <span class="round-badge-pill" id="round-badge-num">ROUND 1</span>
                    <span class="round-indicator" id="round-indicator">Warm-Up</span>
                </div>
                <div class="top-meta-row">
                    <span class="badge top-cat-badge" id="cat-badge" style="background: var(--primary); color: #000;">Ready</span>
                </div>
            </div>
            <div class="top-bar-right">
                <div class="arena-menu-container">
                    <button type="button" class="btn btn-secondary btn-sm arena-menu-btn" id="arena-menu-btn" onclick="toggleArenaMenu()" aria-expanded="false" title="Show navigation & tools">
                        ⚙️ <span class="arena-menu-label">Menu</span> ▾
                    </button>
                    <div class="arena-dropdown-menu" id="arena-dropdown-menu">
                        <a href="{{ path('app_show_manage', {'id': show.id}) }}" class="arena-dropdown-item">
                            <span class="arena-dropdown-icon">⚙️</span>
                            <div>
                                <div class="arena-dropdown-title">Manage Show</div>
                                <div class="arena-dropdown-sub">Settings, teams & rounds</div>
                            </div>
                        </a>
                        <a href="{{ path('app_show_display', {'id': show.id}) }}" target="_blank" class="arena-dropdown-item">
                            <span class="arena-dropdown-icon">📺</span>
                            <div>
                                <div class="arena-dropdown-title">TV Display ↗</div>
                                <div class="arena-dropdown-sub">Audience presentation</div>
                            </div>
                        </a>
                        <div class="arena-dropdown-divider"></div>
                        <button type="button" class="arena-dropdown-item" onclick="triggerAction('start_rules'); closeArenaMenu();">
                            <span class="arena-dropdown-icon">📜</span>
                            <div>
                                <div class="arena-dropdown-title">Rules Briefing</div>
                                <div class="arena-dropdown-sub">Present rules 1-by-1 on TV</div>
                            </div>
                        </button>
                        <button type="button" class="arena-dropdown-item" onclick="openArenaQrModal(); closeArenaMenu();">
                            <span class="arena-dropdown-icon">📱</span>
                            <div>
                                <div class="arena-dropdown-title">iPhone Remote QR</div>
                                <div class="arena-dropdown-sub">Host arena on your phone</div>
                            </div>
                        </button>
                        <div class="arena-dropdown-divider"></div>
                        <button type="button" class="arena-dropdown-item danger" onclick="resetShowConfirm(); closeArenaMenu();">
                            <span class="arena-dropdown-icon">🔄</span>
                            <div>
                                <div class="arena-dropdown-title">Reset Show</div>
                                <div class="arena-dropdown-sub">Restart from Round 1</div>
                            </div>
                        </button>
                    </div>
                </div>

                <button type="button" class="btn btn-secondary btn-sm desktop-only-btn" onclick="openArenaQrModal()" title="Show Mobile QR Code to scan with phone" style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-weight: 700;">
                    📱 QR
                </button>
                <button type="button" class="btn btn-secondary btn-sm sound-toggle-btn" id="btn-sound" onclick="toggleSound()" title="Toggle Sound">
                    🔊<span class="desktop-only-inline"> Sound</span>
                </button>
                <span class="timer-label desktop-only-label">TIME:</span>
                <div class="timer-display" id="timer-box">25</div>
            </div>
        </div>

        <!-- RULES BRIEFING CONTROL BAR -->
        <div id="rules-ctrl-bar" style="display: none; background: linear-gradient(90deg, rgba(245, 158, 11, 0.15) 0%, rgba(32, 26, 21, 0.95) 100%); border-bottom: 2px solid var(--accent); padding: 0.75rem 1.5rem; align-items: center; justify-content: space-between; flex-shrink: 0;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <span style="font-size: 1.6rem;" id="arena-rule-icon-small">📜</span>
                <div>
                    <div style="font-size: 0.75rem; font-weight: 800; color: var(--accent); text-transform: uppercase;" id="arena-rule-step-small">TV DISPLAYING: RULE 1 OF 6</div>
                    <strong style="font-size: 1.05rem; color: #fff;" id="arena-rule-title-small">Rule Title</strong>
                </div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-rule" onclick="triggerAction('prev_rule')">⬅ Prev Rule</button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-next-rule" onclick="triggerAction('next_rule')">Next Rule ➡</button>
                <button type="button" class="btn btn-success btn-sm" onclick="finishRulesAndPlay()" style="font-weight: 700;">🚀 Start Round 1</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="triggerAction('close_rules')" title="Close rules briefing">✕ Close</button>
            </div>
        </div>

        <div class="puzzle-viewport" id="viewport">
            <div class="time-up-banner" id="time-up-banner">⏰ TIME IS UP!</div>

            <!-- RULES BRIEFING PREVIEW CARD (HOST VIEW) -->
            <div id="arena-rules-card" style="display: none; text-align: center; max-width: 650px; background: rgba(32, 26, 21, 0.96); border: 2px solid var(--accent); border-radius: 20px; padding: 2.25rem 2.5rem; box-shadow: 0 15px 40px rgba(0,0,0,0.7);">
                <div style="font-size: 0.8rem; font-weight: 900; color: var(--accent); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 1rem;" id="arena-rule-badge">SHOW RULES BRIEFING • AUDIENCE VIEW</div>
                <div style="font-size: 3.8rem; width: 85px; height: 85px; margin: 0 auto 1.25rem auto; border-radius: 22px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); display: flex; align-items: center; justify-content: center;" id="arena-rule-icon">💡</div>
                <h2 style="font-size: 1.85rem; font-weight: 900; color: #fff; margin-bottom: 1rem;" id="arena-rule-title">Say What You See</h2>
                <p style="font-size: 1.15rem; line-height: 1.6; color: #cbd5e1; margin-bottom: 1.5rem;" id="arena-rule-desc">Call out the famous phrase, movie, object, or idiom hidden in the picture puzzle.</p>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;" id="arena-rule-hint">Advance 1-by-1 with "Next Rule ➡" or finish to begin Round 1.</div>
            </div>

            <div class="puzzle-img-wrap" id="img-wrap">
                <img src="" alt="Rebus Puzzle" class="puzzle-img" id="puzzle-image" style="display: none;">
                <div id="no-question-splash" style="text-align: center; color: var(--text-muted);">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">🍁</div>
                    <h2>Ready to Play!</h2>
                    <p style="margin-top: 0.5rem;">Click "Next Question" to start the round timer.</p>
                </div>
            </div>

            <!-- HOST SECRET ANSWER KEY (Always visible to host!) -->
            <div class="host-clue-card" id="host-clue-card" style="display: none;">
                <div class="host-clue-header">
                    <span class="host-clue-badge">🤫 HOST ANSWER KEY</span>
                    <span class="host-tv-status" id="host-tv-status">📺 Hidden on TV</span>
                </div>
                <div class="host-clue-answer" id="host-clue-answer">ANSWER GOES HERE</div>
                <div class="host-clue-prompt" id="host-clue-prompt">Category • Difficulty</div>
            </div>

            <div class="answer-banner" id="answer-banner">
                <span id="answer-text">ANSWER GOES HERE</span>
            </div>
        </div>

        <div class="stage-controls">
            <div class="desktop-action-group" style="display: flex; gap: 0.5rem; align-items: center;">
                <button type="button" class="btn btn-secondary btn-sm" id="btn-prev-q" onclick="triggerAction('prev_question')" title="Previous Question (Go back in history)">
                    ⏮️ Prev Q
                </button>
                <button type="button" class="btn btn-primary" id="btn-next-q" onclick="triggerAction('next_question')" title="Next Question">
                    ▶️ Next Question
                </button>
                <button type="button" class="btn btn-success" id="btn-reveal" onclick="triggerAction('reveal_answer')">
                    💡 Reveal Answer
                </button>
                <button type="button" class="btn btn-secondary" onclick="openQuickAward()" style="background: rgba(245, 158, 11, 0.2); border-color: var(--accent); color: var(--accent); font-weight: 700;">
                    🏆 Award Points
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleTimer()">
                    ⏸️ Pause / Resume
                </button>
            </div>

            <div class="round-nav-group" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <select id="round-select" class="form-select-sm" onchange="changeRound(this.value)" title="Switch Round">
                    <!-- Loaded dynamically -->
                </select>
                <button type="button" class="btn btn-danger btn-sm" onclick="advanceToNextRound()" title="End round and eliminate teams if applicable">
                    ⏭️ End Round
                </button>
                <button type="button" class="btn btn-secondary btn-sm" id="btn-open-rules" onclick="triggerAction('start_rules')" style="border-color: rgba(245, 158, 11, 0.4); color: #f59e0b; font-weight: 700;" title="Present rules 1-by-1 to audience on TV">
                    📜 Rules Briefing
                </button>
                <button type="button" class="btn btn-secondary btn-sm desktop-only-btn" onclick="resetShowConfirm()" title="Reset game show to Round 1 and zero scores" style="border-color: rgba(245, 158, 11, 0.4); color: #f59e0b;">
                    🔄 Reset Show
                </button>
            </div>
        </div>
    </div>

    <!-- SIDEBAR: LIVE SCOREBOARD & POINTS AWARD -->
    <div class="scoreboard-panel" id="arena-scoreboard">
        <div class="panel-header">
            <span>🏆 Scoreboard</span>
            <span style="font-size: 0.8rem; color: var(--text-muted);" id="q-counter">Asked: 0</span>
        </div>

        <div class="teams-list-scroll" id="teams-list">
            <!-- Dynamically populated -->
        </div>
    </div>
</div>

<!-- FLOATING THUMB DOCK FOR IPHONE / MOBILE (Sticky bottom) -->
<div class="floating-host-dock" id="floating-dock">
    <button type="button" class="dock-btn dock-btn-icon" id="dock-btn-prev" onclick="triggerAction('prev_question')" title="Previous Question">
        ⏮️
    </button>
    <button type="button" class="dock-btn dock-btn-next" id="dock-btn-next" onclick="triggerAction('next_question')">
        ▶️ Next
    </button>
    <button type="button" class="dock-btn dock-btn-reveal" id="dock-btn-reveal" onclick="triggerAction('reveal_answer')">
        💡 Reveal
    </button>
    <button type="button" class="dock-btn dock-btn-award" id="dock-btn-award" onclick="openQuickAward()">
        🏆 Award
    </button>
    <button type="button" class="dock-btn dock-btn-icon" id="dock-btn-pause" onclick="toggleTimer()" title="Pause/Resume">
        ⏸️
    </button>
</div>

<!-- FLOATING DOCK IN RULES BRIEFING MODE (iPhone) -->
<div class="floating-host-dock" id="floating-rules-dock" style="display: none;">
    <button type="button" class="dock-btn dock-btn-icon" onclick="triggerAction('prev_rule')" title="Previous Rule">
        ⬅
    </button>
    <button type="button" class="dock-btn dock-btn-next" id="dock-btn-next-rule" onclick="triggerAction('next_rule')">
        Next Rule ➡
    </button>
    <button type="button" class="dock-btn dock-btn-reveal" onclick="finishRulesAndPlay()">
        🚀 Start R1
    </button>
    <button type="button" class="dock-btn dock-btn-icon" onclick="triggerAction('close_rules')" title="Close rules">
        ✕
    </button>
</div>

<!-- Quick Score Award Modal / Bottom Sheet -->
<dialog id="quick-award-modal" aria-labelledby="qa-title">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
        <div>
            <h2 id="qa-title" style="margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--accent);">🏆 Award Points to Team</h2>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem;" id="qa-subtitle">Select points, then tap the winning team</div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('quick-award-modal').close()" style="border-radius: 50%; width: 34px; height: 34px; padding: 0;">✕</button>
    </div>

    <!-- Point Value Selector -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; overflow-x: auto; padding-bottom: 0.2rem;" id="qa-points-bar">
        <button type="button" class="qa-point-btn active" id="qa-pts-round" data-pts="10" onclick="selectAwardPoints(10, this)">+10 Win</button>
        <button type="button" class="qa-point-btn" id="qa-pts-steal" data-pts="5" onclick="selectAwardPoints(5, this)">+5 Steal</button>
        <button type="button" class="qa-point-btn" data-pts="15" onclick="selectAwardPoints(15, this)">+15 Bonus</button>
        <button type="button" class="qa-point-btn" data-pts="-5" onclick="selectAwardPoints(-5, this)" style="border-color: rgba(239, 68, 68, 0.4); color: #ef4444;">-5 Penalty</button>
    </div>

    <!-- Teams Grid -->
    <div id="qa-teams-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; max-height: 55vh; overflow-y: auto; padding: 0.2rem;">
        <!-- Loaded dynamically -->
    </div>
</dialog>

<!-- Arena Mobile QR Code Modal -->
<dialog id="arena-qr-modal" aria-labelledby="arena-qr-title" style="max-width: 460px; text-align: center; border-color: rgba(56, 189, 248, 0.4);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 id="arena-qr-title" style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #38bdf8;">📱 Connect iPhone Host Remote</h2>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('arena-qr-modal').close()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0;">✕</button>
    </div>
    <p style="color: var(--text-sub); font-size: 0.9rem; margin-bottom: 1rem;">
        Scan with your iPhone Camera to open this host control room on your mobile device.
    </p>
    <div style="background: #ffffff; padding: 1.25rem; border-radius: 18px; display: inline-flex; justify-content: center; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.6); margin-bottom: 1rem;">
        <div id="arena-qrcode"></div>
    </div>
    <div style="background: rgba(0, 0, 0, 0.5); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.6rem 0.85rem; margin-bottom: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; word-break: break-all; color: var(--accent);">
        <a href="{{ mobile_host_url }}" target="_blank" style="color: inherit; text-decoration: none;">{{ mobile_host_url }}</a>
    </div>
    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1.25rem;">
        Local IP: <strong style="color: #fff;">{{ lan_ip }}</strong> • Same Wi-Fi required
    </p>
    <button type="button" class="btn btn-secondary" onclick="document.getElementById('arena-qr-modal').close()" style="width: 100%;">Done</button>
</dialog>
{% endblock %}

{% block javascripts %}
<script src="/js/sounds.js"></script>
<script src="/js/qrcode.min.js"></script>
<script>
    const SHOW_ID = {{ show.id }};
    let currentState = null;
    let timerInterval = null;
    let remainingSeconds = 25;
    let isPaused = false;
    let soundEnabled = true;
    let arenaQrInit = false;
    let selectedAwardPts = 10;
    let activeMobileView = 'stage';

    function setArenaMobileTab(tab) {
        activeMobileView = tab;
        document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
        const activeBtn = document.getElementById(`tab-${tab}-btn`);
        if (activeBtn) activeBtn.classList.add('active');

        const stageEl = document.getElementById('arena-main-stage');
        const scoresEl = document.getElementById('arena-scoreboard');

        if (window.innerWidth <= 900) {
            if (tab === 'stage') {
                stageEl.style.display = 'flex';
                scoresEl.style.display = 'none';
            } else {
                stageEl.style.display = 'none';
                scoresEl.style.display = 'flex';
            }
        } else {
            stageEl.style.display = 'flex';
            scoresEl.style.display = 'flex';
        }
    }

    function toggleArenaMenu() {
        const menu = document.getElementById('arena-dropdown-menu');
        const btn = document.getElementById('arena-menu-btn');
        if (!menu) return;
        const isOpen = menu.classList.toggle('open');
        if (btn) {
            btn.classList.toggle('active', isOpen);
            btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }
    }

    function closeArenaMenu() {
        const menu = document.getElementById('arena-dropdown-menu');
        const btn = document.getElementById('arena-menu-btn');
        if (menu) menu.classList.remove('open');
        if (btn) {
            btn.classList.remove('active');
            btn.setAttribute('aria-expanded', 'false');
        }
    }

    document.addEventListener('click', function(e) {
        const container = document.querySelector('.arena-menu-container');
        if (container && !container.contains(e.target)) {
            closeArenaMenu();
        }
    });

    function openArenaQrModal() {
        const modal = document.getElementById('arena-qr-modal');
        modal.showModal();
        if (!arenaQrInit && document.getElementById('arena-qrcode')) {
            new QRCode(document.getElementById('arena-qrcode'), {
                text: '{{ mobile_host_url|e('js') }}',
                width: 200,
                height: 200,
                colorDark: '#0a0807',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
            arenaQrInit = true;
        }
    }

    function selectAwardPoints(pts, btn) {
        selectedAwardPts = pts;
        document.querySelectorAll('.qa-point-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
    }

    function openQuickAward(preselectedTeamId = null) {
        if (!currentState || !currentState.teams) return;
        const modal = document.getElementById('quick-award-modal');
        const grid = document.getElementById('qa-teams-grid');
        grid.innerHTML = '';

        const round = currentState.current_round;
        const roundPts = round ? round.points_per_question : 10;
        const stealPts = round ? round.steal_points : 5;

        // Update default button values
        const roundBtn = document.getElementById('qa-pts-round');
        if (roundBtn) {
            roundBtn.innerText = `+${roundPts} Win`;
            roundBtn.dataset.pts = roundPts;
        }
        const stealBtn = document.getElementById('qa-pts-steal');
        if (stealBtn) {
            stealBtn.innerText = `+${stealPts} Steal`;
            stealBtn.dataset.pts = stealPts;
        }

        const q = currentState.current_question;
        const subtitle = document.getElementById('qa-subtitle');
        if (q && q.answer) {
            subtitle.innerText = `Q: "${q.answer}" • Tap winning team`;
        } else {
            subtitle.innerText = 'Tap winning team to award';
        }

        currentState.teams.forEach(t => {
            const isEliminated = (t.is_eliminated == 1);
            const card = document.createElement('div');
            card.className = 'qa-team-tile';
            if (isEliminated) {
                card.style.opacity = '0.4';
            }
            if (preselectedTeamId && t.id === preselectedTeamId) {
                card.style.borderColor = 'var(--accent)';
                card.style.background = 'rgba(245, 158, 11, 0.2)';
            }

            card.innerHTML = `
                <div style="display:flex; align-items:center; gap:0.5rem; min-width:0; overflow:hidden;">
                    <span style="font-size:1.6rem;">${t.avatar_emoji || '🍁'}</span>
                    <div style="min-width:0; overflow:hidden;">
                        <strong style="font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">${t.name}</strong>
                        <div style="font-size:0.75rem; color:var(--text-muted);">${t.score} pts</div>
                    </div>
                </div>
                <div style="font-size:1rem; font-weight:800; color:var(--accent);">+</div>
            `;

            card.addEventListener('click', () => {
                awardPoints(t.id, selectedAwardPts);
                card.style.background = 'rgba(16, 185, 129, 0.3)';
                card.style.borderColor = '#10b981';
                setTimeout(() => {
                    modal.close();
                }, 300);
            });

            grid.appendChild(card);
        });

        modal.showModal();
    }

    function toggleSound() {
        soundEnabled = !soundEnabled;
        window.soundFX.enabled = soundEnabled;
        const btn = document.getElementById('btn-sound');
        if (btn) {
            btn.innerHTML = soundEnabled 
                ? '🔊<span class="desktop-only-inline"> Sound</span>' 
                : '🔇<span class="desktop-only-inline"> Muted</span>';
        }
    }

    function fetchState() {
        fetch(`/api/shows/${SHOW_ID}/state`)
            .then(res => res.json())
            .then(data => {
                currentState = data;
                renderUI();
            });
    }

    function renderUI() {
        if (!currentState) return;
        const show = currentState.show;
        const q = currentState.current_question;
        const round = currentState.current_round;
        const roundPts = round ? round.points_per_question : 10;
        const stealPts = round ? round.steal_points : 5;

        // Round indicator
        if (round) {
            const roundBadge = document.getElementById('round-badge-num');
            if (roundBadge) {
                roundBadge.innerText = `ROUND ${round.round_number || 1}`;
            }
            const cleanRoundName = (round.name || '').replace(/^Round\s*\d+\s*[:\-]\s*/i, '').trim();
            document.getElementById('round-indicator').innerText = cleanRoundName || round.name || 'Round';
        }

        // Host Clue Card (Always visible to host)
        const hostClueCard = document.getElementById('host-clue-card');
        const hostClueAns = document.getElementById('host-clue-answer');
        const hostCluePrompt = document.getElementById('host-clue-prompt');
        const hostTvStatus = document.getElementById('host-tv-status');

        if (q) {
            hostClueCard.style.display = 'block';
            hostClueAns.innerText = q.answer;
            hostCluePrompt.innerText = `${q.category_name || 'Category'} • ${q.difficulty} • Points: +${roundPts} (Steal: +${stealPts})`;
            if (show.answer_revealed == 1) {
                hostTvStatus.innerText = '📺 REVEALED ON TV ✅';
                hostTvStatus.className = 'host-tv-status revealed';
            } else {
                hostTvStatus.innerText = '📺 Hidden on TV';
                hostTvStatus.className = 'host-tv-status';
            }
        } else {
            hostClueCard.style.display = 'none';
        }

        // Rules display or Question display
        const rulesList = Array.isArray(currentState.rules) ? currentState.rules : [];
        const activeRuleIdx = (show.active_rule_index !== undefined && show.active_rule_index !== null) ? parseInt(show.active_rule_index) : -1;
        const rulesBar = document.getElementById('rules-ctrl-bar');
        const rulesCard = document.getElementById('arena-rules-card');
        const btnNextRule = document.getElementById('btn-next-rule');
        const btnPrevRule = document.getElementById('btn-prev-rule');
        const floatingDock = document.getElementById('floating-dock');
        const floatingRulesDock = document.getElementById('floating-rules-dock');

        if (activeRuleIdx >= 0 && rulesList.length > 0 && activeRuleIdx < rulesList.length) {
            const rule = rulesList[activeRuleIdx];
            rulesBar.style.display = 'flex';
            rulesCard.style.display = 'block';
            if (window.innerWidth <= 900) {
                floatingDock.style.display = 'none';
                floatingRulesDock.style.display = 'flex';
            }

            document.getElementById('img-wrap').style.display = 'none';
            document.getElementById('answer-banner').style.display = 'none';
            document.getElementById('time-up-banner').style.display = 'none';
            hostClueCard.style.display = 'none';

            document.getElementById('arena-rule-step-small').innerText = `TV DISPLAYING: RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
            document.getElementById('arena-rule-icon-small').innerText = rule.icon || '📜';
            document.getElementById('arena-rule-title-small').innerText = rule.title;

            document.getElementById('arena-rule-badge').innerText = `SHOW RULES BRIEFING • RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
            document.getElementById('arena-rule-icon').innerText = rule.icon || '📜';
            document.getElementById('arena-rule-title').innerText = rule.title;
            document.getElementById('arena-rule-desc').innerText = rule.description;

            if (btnPrevRule) btnPrevRule.disabled = (activeRuleIdx === 0);
            if (btnNextRule) {
                if (activeRuleIdx === rulesList.length - 1) {
                    btnNextRule.innerText = 'Last Rule ✔';
                    btnNextRule.disabled = true;
                } else {
                    btnNextRule.innerText = 'Next Rule ➡';
                    btnNextRule.disabled = false;
                }
            }

            document.getElementById('cat-badge').innerText = 'Rules Briefing';
            document.getElementById('cat-badge').style.background = 'var(--accent)';
        } else {
            rulesBar.style.display = 'none';
            rulesCard.style.display = 'none';
            if (window.innerWidth <= 900) {
                floatingDock.style.display = 'flex';
                floatingRulesDock.style.display = 'none';
            }
            document.getElementById('img-wrap').style.display = 'flex';

            if (q) {
                document.getElementById('no-question-splash').style.display = 'none';
                const img = document.getElementById('puzzle-image');
                img.src = q.media_path;
                img.style.display = 'block';

                const badge = document.getElementById('cat-badge');
                badge.innerText = q.category_name + ' • ' + q.difficulty;
                badge.style.background = q.category_color || 'var(--primary)';

                document.getElementById('answer-text').innerText = q.answer;
                if (show.answer_revealed == 1) {
                    document.getElementById('answer-banner').style.display = 'block';
                    document.getElementById('time-up-banner').style.display = 'none';
                } else {
                    document.getElementById('answer-banner').style.display = 'none';
                }
            } else {
                document.getElementById('no-question-splash').style.display = 'block';
                document.getElementById('puzzle-image').style.display = 'none';
                document.getElementById('answer-banner').style.display = 'none';
                document.getElementById('time-up-banner').style.display = 'none';
                document.getElementById('cat-badge').innerText = 'Ready';
                document.getElementById('cat-badge').style.background = 'var(--primary)';
            }
        }

        // Scoreboard & Mobile Counts
        const teamsContainer = document.getElementById('teams-list');
        teamsContainer.innerHTML = '';
        const teamCount = currentState.teams.length;
        document.getElementById('mobile-team-count').innerText = teamCount;

        currentState.teams.forEach(t => {
            const div = document.createElement('div');
            div.className = 'team-row ' + (t.is_eliminated == 1 ? 'eliminated' : '');
            div.innerHTML = `
                <div style="display:flex; align-items:center; gap:0.6rem; min-width:0; flex:1; cursor:pointer;" onclick="openQuickAward(${t.id})" title="Click to award points">
                    <span style="font-size:1.5rem;">${t.avatar_emoji || '🍁'}</span>
                    <div style="min-width:0; overflow:hidden;">
                        <strong style="font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">${t.name}</strong>
                        <div style="font-size:0.75rem; color:var(--text-muted);">${t.score} pts • ${t.flight_group || 'General'}</div>
                    </div>
                </div>
                <div class="team-score-ctrl">
                    <button class="score-btn" style="background:rgba(16,185,129,0.2); color:#10b981; border-color:#10b981;" onclick="awardPoints(${t.id}, ${roundPts})" title="Award Round Points">+${roundPts}</button>
                    <button class="score-btn" style="background:rgba(245,158,11,0.2); color:var(--accent); border-color:var(--accent);" onclick="awardPoints(${t.id}, ${stealPts})" title="Steal Points">+${stealPts}</button>
                    <button class="score-btn" style="background:rgba(239,68,68,0.2); color:var(--danger); border-color:var(--danger);" onclick="awardPoints(${t.id}, -5)" title="Deduct Points">-5</button>
                </div>
            `;
            teamsContainer.appendChild(div);
        });

        // Round Selector
        const rSelect = document.getElementById('round-select');
        rSelect.innerHTML = '';
        currentState.rounds.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.id;
            opt.innerText = r.name;
            if (show.current_round_id == r.id) opt.selected = true;
            rSelect.appendChild(opt);
        });

        document.getElementById('q-counter').innerText = 'Asked: ' + currentState.used_questions_count;

        const prevBtn = document.getElementById('btn-prev-q');
        const dockPrevBtn = document.getElementById('dock-btn-prev');
        const hasUsed = (currentState.used_questions_count && currentState.used_questions_count > 0);
        if (prevBtn) prevBtn.disabled = !hasUsed;
        if (dockPrevBtn) dockPrevBtn.disabled = !hasUsed;

        // Timer Sync
        if (show.question_started_at && show.answer_revealed == 0) {
            const elapsed = Math.floor(Date.now() / 1000) - show.question_started_at;
            remainingSeconds = Math.max(0, (show.timer_duration || 25) - elapsed);
            startClientTimer();
        } else {
            clearInterval(timerInterval);
            document.getElementById('timer-box').innerText = show.timer_duration || 25;
            document.getElementById('timer-box').classList.remove('danger');
        }
    }

    function startClientTimer() {
        clearInterval(timerInterval);
        updateTimerDisplay();
        timerInterval = setInterval(() => {
            if (!isPaused && remainingSeconds > 0) {
                remainingSeconds--;
                updateTimerDisplay();

                if (remainingSeconds > 0 && remainingSeconds <= 5) {
                    window.soundFX.playWarningTick();
                }

                if (remainingSeconds === 0) {
                    clearInterval(timerInterval);
                    document.getElementById('timer-box').classList.add('danger');
                    document.getElementById('time-up-banner').style.display = 'block';
                    window.soundFX.playTimeUpBuzzer();
                }
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        const box = document.getElementById('timer-box');
        box.innerText = remainingSeconds;
        if (remainingSeconds <= 5) {
            box.classList.add('danger');
        } else {
            box.classList.remove('danger');
            document.getElementById('time-up-banner').style.display = 'none';
        }
    }

    function toggleTimer() {
        isPaused = !isPaused;
    }

    function triggerAction(actionName) {
        if (actionName === 'reveal_answer') {
            window.soundFX.playDingCorrect();
        }

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: actionName })
        }).then(() => fetchState());
    }

    function showToast(msg) {
        let toast = document.getElementById('arena-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'arena-toast';
            toast.style.cssText = 'position:fixed; top:20px; left:50%; transform:translateX(-50%); background:rgba(16,185,129,0.95); color:#000; padding:0.75rem 1.75rem; border-radius:12px; font-weight:800; font-size:1.05rem; box-shadow:0 10px 30px rgba(0,0,0,0.7); z-index:9999; display:none; animation:slideDown 0.25s ease-out;';
            document.body.appendChild(toast);
        }
        toast.innerText = msg;
        toast.style.display = 'block';
        clearTimeout(toast._timeout);
        toast._timeout = setTimeout(() => {
            toast.style.display = 'none';
        }, 1800);
    }

    function awardPoints(teamId, pts) {
        if (pts > 0) {
            window.soundFX.playDingCorrect();
        }

        const team = currentState?.teams?.find(t => t.id === teamId);
        const teamName = team ? team.name : 'Team';
        showToast(`${pts > 0 ? '✅ +' : '⚠️ '}${pts} pts awarded to ${teamName}!`);

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'award_points', team_id: teamId, points: pts })
        }).then(() => fetchState());
    }

    window.addEventListener('resize', () => setArenaMobileTab(activeMobileView));

    function advanceToNextRound() {
        if (!confirm('End current round and advance to the next? If this round has elimination rules, bottom teams will be eliminated.')) return;
        
        const currentRoundIdx = currentState.rounds.findIndex(r => r.id == currentState.show.current_round_id);
        const nextRound = currentState.rounds[currentRoundIdx + 1];
        if (!nextRound) {
            window.soundFX.playFanfare();
            alert('🏆 That was the final championship round! Congratulations to the Grand Champions!');
            return;
        }

        window.soundFX.playFanfare();

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'advance_round',
                next_round_id: nextRound.id,
                apply_eliminations: true
            })
        }).then(() => fetchState());
    }

    function changeRound(roundId) {
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'advance_round', next_round_id: roundId, apply_eliminations: false })
        }).then(() => fetchState());
    }

    function resetShowConfirm() {
        if (!confirm('Are you sure you want to refresh this game show? This will reset all team scores to 0, clear question history, and restart from Round 1.')) return;
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset_show' })
        }).then(() => fetchState());
    }

    function finishRulesAndPlay() {
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'finish_rules' })
        }).then(() => {
            fetchState();
            triggerAction('start_question');
        });
    }

    // Keyboard Shortcuts for Host!
    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;

        const activeRuleIdx = (currentState?.show?.active_rule_index !== undefined && currentState?.show?.active_rule_index !== null) ? parseInt(currentState.show.active_rule_index) : -1;
        if (activeRuleIdx >= 0) {
            if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') {
                e.preventDefault();
                const rulesCount = currentState?.rules?.length || 0;
                if (activeRuleIdx < rulesCount - 1) {
                    triggerAction('next_rule');
                } else {
                    finishRulesAndPlay();
                }
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                triggerAction('prev_rule');
            } else if (e.key === 'Escape') {
                e.preventDefault();
                triggerAction('close_rules');
            }
            return;
        }

        if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            triggerAction('reveal_answer');
        } else if (e.key === 'ArrowRight' || e.key === 'n') {
            triggerAction('next_question');
        } else if (e.key === 'ArrowLeft') {
            triggerAction('prev_question');
        } else if (e.key === 'p') {
            toggleTimer();
        }
    });

    fetchState();
    setInterval(fetchState, 2500);
</script>
{% endblock %}
