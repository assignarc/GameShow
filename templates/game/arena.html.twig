{% block javascripts %}
<script src="/js/sounds.js?v=7"></script>
<script src="/js/qrcode.min.js"></script>
<script>
    const SHOW_ID = {{ show.id }};
    let currentState = null;
    let timerInterval = null;
    let remainingSeconds = 25;
    let activeArenaTimerStamp = null;
    let arenaBuzzerPlayedForStamp = null;
    let isPaused = false;
    let soundEnabled = false;
    if (window.soundFX) {
        window.soundFX.enabled = false;
    }
    let arenaQrInit = false;
    let selectedAwardPts = 10;
    let activeMobileView = 'stage';
    let recentArenaScoreChanges = {};

    function setSidebarTab(tab) {
        const scoresBody = document.getElementById('arena-scoreboard-body');
        const soundsBody = document.getElementById('arena-sounds-body');
        const scoresBtn = document.getElementById('sidebar-tab-scores');
        const soundsBtn = document.getElementById('sidebar-tab-sounds');

        if (tab === 'sounds') {
            if (scoresBody) scoresBody.style.display = 'none';
            if (soundsBody) soundsBody.style.display = 'flex';
            if (scoresBtn) scoresBtn.classList.remove('active');
            if (soundsBtn) soundsBtn.classList.add('active');
        } else {
            if (scoresBody) scoresBody.style.display = 'flex';
            if (soundsBody) soundsBody.style.display = 'none';
            if (scoresBtn) scoresBtn.classList.add('active');
            if (soundsBtn) soundsBtn.classList.remove('active');
        }
    }

    function setArenaMobileTab(tab) {
        activeMobileView = tab;
        document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
        const activeBtn = document.getElementById(`tab-${tab}-btn`);
        if (activeBtn) activeBtn.classList.add('active');

        const stageEl = document.getElementById('arena-main-stage');
        const scoresEl = document.getElementById('arena-scoreboard');

        if (window.innerWidth <= 767) {
            if (tab === 'stage') {
                stageEl.style.display = 'flex';
                scoresEl.style.display = 'none';
            } else if (tab === 'sounds') {
                stageEl.style.display = 'none';
                scoresEl.style.display = 'flex';
                setSidebarTab('sounds');
            } else {
                stageEl.style.display = 'none';
                scoresEl.style.display = 'flex';
                setSidebarTab('scores');
            }
        } else {
            stageEl.style.display = 'flex';
            scoresEl.style.display = 'flex';
        }
    }

    function toggleArenaMenu() {
        const menu = document.getElementById('arena-dropdown-menu');
        const btn = document.getElementById('arena-menu-btn');
        if (!menu) return;
        const isOpen = menu.classList.toggle('open');
        if (btn) {
            btn.classList.toggle('active', isOpen);
            btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }
    }

    function closeArenaMenu() {
        const menu = document.getElementById('arena-dropdown-menu');
        const btn = document.getElementById('arena-menu-btn');
        if (menu) menu.classList.remove('open');
        if (btn) {
            btn.classList.remove('active');
            btn.setAttribute('aria-expanded', 'false');
        }
    }

    document.addEventListener('click', function(e) {
        const container = document.querySelector('.arena-menu-container');
        if (container && !container.contains(e.target)) {
            closeArenaMenu();
        }
    });

    function openSfxSoundboard() {
        if (window.soundFX) window.soundFX.init();
        const modal = document.getElementById('sfx-soundboard-modal');
        if (modal) modal.showModal();
    }

    const QUICK_SFX_POOLS = {
        correct: [
            { sfx: 'applause', label: '👏 Applause!' },
            { sfx: 'tussi_great_ho', label: '🙇 Jahanpanah Tussi Great Ho!' },
            { sfx: 'mogambo_khush_hua', label: '😈 Mogambo Khush Hua!' },
            { sfx: 'shabbas_beta', label: '👏 Shabbas Beta! Bahut Badia!' },
        ],
        wrong: [
            { sfx: 'wrong_buzz', label: '❌ BZZZT!' },
            { sfx: 'sad_trombone', label: '🎺 Wah-Wah-Waaah!' },
            { sfx: 'kahan_se_aate', label: '🤦 Kaun Hai Ye Log?' },
            { sfx: 'tu_samjha', label: '🤔 Tu Samjha? Nahi!' },
            { sfx: 'kehna_kya_chahte_ho', label: '🤨 Arey Kehna Kya Chahte Ho?' },
            { sfx: 'mast_joke_mara', label: '🤣 Mast Joke Mara Re!' },
            { sfx: 'tumse_na_ho_payega', label: '🫠 Beta, Tumse Na Ho Payega!' },
        ],
    };
    let lastQuickSfxByType = { correct: null, wrong: null };

    function playRandomQuickSfx(type) {
        const pool = QUICK_SFX_POOLS[type];
        if (!pool || pool.length === 0) return;
        let candidates = pool.filter(item => item.sfx !== lastQuickSfxByType[type]);
        if (candidates.length === 0) candidates = pool;
        const pick = candidates[Math.floor(Math.random() * candidates.length)];
        lastQuickSfxByType[type] = pick.sfx;
        playHostSfx(pick.sfx, pick.label);
    }

    function playHostSfx(sfxName, label) {
        if (window.soundFX) {
            window.soundFX.init();
            window.soundFX.playByName(sfxName);
        }
        showToast(label || `🎭 ${sfxName}`);
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'play_sfx', sfx: sfxName })
        });
    }

    function openArenaQrModal() {
        const modal = document.getElementById('arena-qr-modal');
        modal.showModal();
        if (!arenaQrInit && document.getElementById('arena-qrcode')) {
            new QRCode(document.getElementById('arena-qrcode'), {
                text: '{{ mobile_host_url|e('js') }}',
                width: 200,
                height: 200,
                colorDark: '#0a0807',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
            arenaQrInit = true;
        }
    }

    function selectAwardPoints(pts, btn) {
        selectedAwardPts = pts;
        document.querySelectorAll('.qa-point-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
    }

    function openQuickAward(preselectedTeamId = null) {
        if (!currentState || !currentState.teams) return;
        const modal = document.getElementById('quick-award-modal');
        const grid = document.getElementById('qa-teams-grid');
        grid.innerHTML = '';

        const round = currentState.current_round;
        const roundPts = (round && round.points_per_question !== undefined && round.points_per_question !== null) ? parseInt(round.points_per_question, 10) : 10;
        const stealPts = (round && round.steal_points !== undefined && round.steal_points !== null) ? parseInt(round.steal_points, 10) : 0;

        // Update default button values
        const roundBtn = document.getElementById('qa-pts-round');
        if (roundBtn) {
            roundBtn.innerText = `+${roundPts} Win`;
            roundBtn.dataset.pts = roundPts;
        }
        const stealBtn = document.getElementById('qa-pts-steal');
        if (stealBtn) {
            stealBtn.innerText = `+${stealPts} Steal`;
            stealBtn.dataset.pts = stealPts;
        }

        const q = currentState.current_question;
        const subtitle = document.getElementById('qa-subtitle');
        if (q && q.answer) {
            subtitle.innerText = `Q: "${q.answer}" • Tap winning team`;
        } else {
            subtitle.innerText = 'Tap winning team to award';
        }

        currentState.teams.forEach(t => {
            const isEliminated = (t.is_eliminated == 1);
            const card = document.createElement('div');
            card.className = 'qa-team-tile';
            if (isEliminated) {
                card.style.opacity = '0.4';
            }
            if (preselectedTeamId && t.id === preselectedTeamId) {
                card.style.borderColor = 'var(--accent)';
                card.style.background = 'rgba(245, 158, 11, 0.2)';
            }

            card.innerHTML = `
                <div style="display:flex; align-items:center; gap:0.5rem; min-width:0; overflow:hidden;">
                    <span style="font-size:1.6rem;">${t.avatar_emoji || '🍁'}</span>
                    <div style="min-width:0; overflow:hidden;">
                        <strong style="font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">${t.name}</strong>
                        <div style="font-size:0.75rem; color:var(--text-muted);">${t.score} pts</div>
                    </div>
                </div>
                <div style="font-size:1rem; font-weight:800; color:var(--accent);">+</div>
            `;

            card.addEventListener('click', () => {
                awardPoints(t.id, selectedAwardPts);
                card.style.background = 'rgba(16, 185, 129, 0.3)';
                card.style.borderColor = '#10b981';
                setTimeout(() => {
                    modal.close();
                }, 300);
            });

            grid.appendChild(card);
        });

        modal.showModal();
    }

    function toggleSound() {
        soundEnabled = !soundEnabled;
        if (window.soundFX) {
            window.soundFX.enabled = soundEnabled;
            if (soundEnabled) {
                window.soundFX.init();
                window.soundFX.playTick();
            }
        }
        const icon = document.getElementById('menu-sound-icon');
        const title = document.getElementById('menu-sound-title');
        if (icon) icon.innerText = soundEnabled ? '🔊' : '🔇';
        if (title) title.innerText = soundEnabled ? 'Host Audio: ON' : 'Host Audio: Muted';
        showToast(soundEnabled ? '🔊 Host Audio ON' : '🔇 Host Audio Muted');
    }

    function fetchState() {
        fetch(`/api/shows/${SHOW_ID}/state`)
            .then(res => res.json())
            .then(data => {
                currentState = data;
                renderUI();
            });
    }

    function renderUI() {
        if (!currentState) return;
        const show = currentState.show;
        const q = currentState.current_question;
        const round = currentState.current_round;
        const roundPts = (round && round.points_per_question !== undefined && round.points_per_question !== null) ? parseInt(round.points_per_question, 10) : 10;
        const stealPts = (round && round.steal_points !== undefined && round.steal_points !== null) ? parseInt(round.steal_points, 10) : 0;

        // Round indicator
        if (round) {
            const roundBadge = document.getElementById('round-badge-num');
            if (roundBadge) {
                roundBadge.innerText = `ROUND ${round.round_number || 1}`;
            }
            const cleanRoundName = (round.name || '').replace(/^Round\s*\d+\s*[:\-]\s*/i, '').trim();
            document.getElementById('round-indicator').innerText = cleanRoundName || round.name || 'Round';
        }

        // Host Clue Card (Always visible to host)
        const hostClueCard = document.getElementById('host-clue-card');
        const hostClueAns = document.getElementById('host-clue-answer');
        const hostTvStatus = document.getElementById('host-tv-status');

        if (q) {
            hostClueCard.style.display = 'block';
            hostClueAns.innerText = q.answer;
            if (show.answer_revealed == 1) {
                hostTvStatus.innerText = '📺 REVEALED ON TV ✅';
                hostTvStatus.className = 'host-tv-status revealed';
            } else {
                hostTvStatus.innerText = '📺 Hidden on TV';
                hostTvStatus.className = 'host-tv-status';
            }
        } else {
            hostClueCard.style.display = 'none';
        }

        // Rules display or Question display
        const rulesList = Array.isArray(currentState.rules) ? currentState.rules : [];
        const activeRuleIdx = (show.active_rule_index !== undefined && show.active_rule_index !== null) ? parseInt(show.active_rule_index) : -1;
        const rulesBar = document.getElementById('rules-ctrl-bar');
        const rulesCard = document.getElementById('arena-rules-card');
        const btnNextRule = document.getElementById('btn-next-rule');
        const btnPrevRule = document.getElementById('btn-prev-rule');
        const floatingDock = document.getElementById('floating-dock');
        const floatingRulesDock = document.getElementById('floating-rules-dock');

        if (activeRuleIdx >= 0 && rulesList.length > 0 && activeRuleIdx < rulesList.length) {
            const rule = rulesList[activeRuleIdx];
            rulesBar.style.display = 'flex';
            rulesCard.style.display = 'block';
            if (window.innerWidth <= 767) {
                floatingDock.style.display = 'none';
                floatingRulesDock.style.display = 'flex';
            }

            document.getElementById('img-wrap').style.display = 'none';
            document.getElementById('answer-banner').style.display = 'none';
            document.getElementById('time-up-banner').style.display = 'none';
            hostClueCard.style.display = 'none';

            document.getElementById('arena-rule-step-small').innerText = `TV DISPLAYING: RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
            document.getElementById('arena-rule-icon-small').innerText = rule.icon || '📜';
            document.getElementById('arena-rule-title-small').innerText = rule.title;

            document.getElementById('arena-rule-badge').innerText = `SHOW RULES BRIEFING • RULE ${activeRuleIdx + 1} OF ${rulesList.length}`;
            document.getElementById('arena-rule-icon').innerText = rule.icon || '📜';
            document.getElementById('arena-rule-title').innerText = rule.title;
            document.getElementById('arena-rule-desc').innerText = rule.description;

            if (btnPrevRule) btnPrevRule.disabled = (activeRuleIdx === 0);
            const dockNextRuleBtn = document.getElementById('dock-btn-next-rule');
            if (btnNextRule) {
                if (activeRuleIdx === rulesList.length - 1) {
                    btnNextRule.innerText = '🎯 Next: Sample Tryout Puzzle';
                    btnNextRule.disabled = false;
                    if (dockNextRuleBtn) dockNextRuleBtn.innerText = '🎯 Sample Q';
                } else {
                    btnNextRule.innerText = 'Next Rule ➡';
                    btnNextRule.disabled = false;
                    if (dockNextRuleBtn) dockNextRuleBtn.innerText = 'Next Rule ➡';
                }
            }

            document.getElementById('cat-badge').innerText = 'Rules Briefing';
            document.getElementById('cat-badge').style.background = 'var(--accent)';
        } else {
            rulesBar.style.display = 'none';
            rulesCard.style.display = 'none';
            if (window.innerWidth <= 767) {
                floatingDock.style.display = 'flex';
                floatingRulesDock.style.display = 'none';
            }
            document.getElementById('img-wrap').style.display = 'flex';

            const btnNextQ = document.getElementById('btn-next-q');
            const dockBtnNext = document.getElementById('dock-btn-next');

            if (q) {
                document.getElementById('no-question-splash').style.display = 'none';
                const img = document.getElementById('puzzle-image');
                img.src = q.media_path;
                img.style.display = 'block';
                document.getElementById('quick-sfx-correct').style.display = 'inline-flex';
                document.getElementById('quick-sfx-wrong').style.display = 'inline-flex';

                if (q.is_sample) {
                    if (btnNextQ) btnNextQ.innerText = '⏭️ Round 1 Info';
                    if (dockBtnNext) dockBtnNext.innerText = '⏭️ R1 Info';
                } else {
                    if (btnNextQ) btnNextQ.innerText = '▶️ Next';
                    if (dockBtnNext) dockBtnNext.innerText = '▶️ Next';
                }

                const badge = document.getElementById('cat-badge');
                const rProg = currentState.round_progress || {};
                const qProgress = q.is_sample ? '' : ((rProg.total > 0) ? ` (${rProg.used}/${rProg.total})` : '');
                badge.innerText = q.category_name + ' • ' + q.difficulty + qProgress;
                badge.style.background = q.category_color || 'var(--primary)';

                document.getElementById('answer-text').innerText = q.answer;
                if (show.answer_revealed == 1) {
                    document.getElementById('answer-banner').style.display = 'block';
                    document.getElementById('time-up-banner').style.display = 'none';
                } else {
                    document.getElementById('answer-banner').style.display = 'none';
                }
            } else {
                document.getElementById('no-question-splash').style.display = 'block';
                document.getElementById('puzzle-image').style.display = 'none';
                document.getElementById('quick-sfx-correct').style.display = 'none';
                document.getElementById('quick-sfx-wrong').style.display = 'none';
                document.getElementById('answer-banner').style.display = 'none';
                document.getElementById('time-up-banner').style.display = 'none';

                const rProg = currentState.round_progress || {};
                const showStatus = show.status || 'setup';
                const splashIcon = document.getElementById('arena-splash-icon');
                const splashBadge = document.getElementById('arena-splash-badge');
                const splashTitle = document.getElementById('arena-splash-title');
                const splashSub = document.getElementById('arena-splash-sub');
                const splashPreviewWrap = document.getElementById('arena-splash-preview-wrap');
                const splashStats = document.getElementById('arena-splash-stats');
                const splashMeta = document.getElementById('arena-splash-meta');
                const splashBtn = document.getElementById('arena-splash-action-btn');

                function buildDynamicRoundDescription(rObj) {
                    if (!rObj) return '';
                    if (rObj.settings_summary) return rObj.settings_summary;
                    const typeLabel = rObj.round_type === 'rapid_fire'
                        ? '⚡ Rapid Fire (All Remaining Starred Puzzles)'
                        : (rObj.round_type === 'head_to_head' ? 'Head-to-Head Flight Matchup' : 'All Teams Open Play');
                    const tSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                    const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                    const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                    const advStr = rObj.advancement_type === 'top_x'
                        ? `Top ${rObj.advance_top_x} Teams Advance`
                        : 'All Advance';
                    return `Type: ${typeLabel} • Timer: ${tSec}s • Points: +${pts} (Steal: +${steal}) • Advancement: ${advStr}`;
                }

                function renderArenaRoundStats(rObj) {
                    if (!rObj) return '';
                    const tSec = (rObj.timer_seconds !== undefined && rObj.timer_seconds !== null) ? parseInt(rObj.timer_seconds, 10) : 25;
                    const pts = (rObj.points_per_question !== undefined && rObj.points_per_question !== null) ? parseInt(rObj.points_per_question, 10) : 10;
                    const steal = (rObj.steal_points !== undefined && rObj.steal_points !== null) ? parseInt(rObj.steal_points, 10) : 0;
                    const totQ = rObj.total_questions || (Array.isArray(rObj.category_allocations) ? rObj.category_allocations.reduce((s, a) => s + (parseInt(a.count) || 0), 0) : 0);
                    const boxStyle = 'background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 0.45rem 0.35rem; text-align: center;';
                    return `
                        <div style="${boxStyle}"><div style="font-size:0.68rem; color:#94a3b8; font-weight:800;">⏱️ TIMER</div><div style="font-size:1.05rem; font-weight:900; color:#38bdf8;">${tSec}s</div></div>
                        <div style="${boxStyle}"><div style="font-size:0.68rem; color:#94a3b8; font-weight:800;">🏆 WIN</div><div style="font-size:1.05rem; font-weight:900; color:#10b981;">+${pts}</div></div>
                        <div style="${boxStyle}"><div style="font-size:0.68rem; color:#94a3b8; font-weight:800;">⚡ STEAL</div><div style="font-size:1.05rem; font-weight:900; color:#f59e0b;">+${steal}</div></div>
                        <div style="${boxStyle}"><div style="font-size:0.68rem; color:#94a3b8; font-weight:800;">🧩 PUZZLES</div><div style="font-size:1.05rem; font-weight:900; color:#fff;">${totQ || 'All'}</div></div>
                    `;
                }

                function renderArenaRoundMeta(rObj) {
                    if (!rObj) return '';
                    const dynDesc = buildDynamicRoundDescription(rObj);
                    const allocs = Array.isArray(rObj.category_allocations) ? rObj.category_allocations : [];
                    const cats = allocs.map(a => `${a.category_icon || '🧩'} ${a.category_name || 'Category'} (${a.count})`).join(' • ');
                    return `<div style="color:#f8fafc; font-weight:700; margin-bottom:0.2rem;">${dynDesc}</div>` +
                        (cats ? `<div style="font-size:0.78rem; color:#94a3b8;">${cats}</div>` : '');
                }

                const splashPrevBtn = document.getElementById('arena-splash-prev-btn');
                const splashSkipBtn = document.getElementById('arena-splash-skip-btn');
                if (splashPrevBtn) splashPrevBtn.style.display = 'none';
                if (splashSkipBtn) splashSkipBtn.style.display = 'none';

                if (round && rProg.is_completed) {
                    document.getElementById('cat-badge').innerText = `End of Round ${round.round_number || 1}`;
                    document.getElementById('cat-badge').style.background = 'var(--accent)';
                    if (splashPreviewWrap) splashPreviewWrap.style.display = 'none';
                    if (splashIcon) splashIcon.innerText = '🏁';
                    if (splashBadge) {
                        splashBadge.innerText = `📺 TV SCREEN IS SHOWING: END OF ROUND ${round.round_number || 1} (${rProg.used || rProg.total || 0} PUZZLES)`;
                        splashBadge.style.borderColor = 'var(--accent)';
                        splashBadge.style.color = 'var(--accent)';
                    }
                    if (splashTitle) splashTitle.innerText = `End of Round ${round.round_number || 1}!`;
                    const nextR = rProg.next_round;
                    if (nextR) {
                        if (splashSub) splashSub.innerHTML = `<strong style="color:var(--primary);">⏭️ Up Next: ${nextR.name}</strong>`;
                        if (splashStats) splashStats.innerHTML = renderArenaRoundStats(nextR);
                        if (splashMeta) splashMeta.innerHTML = renderArenaRoundMeta(nextR);
                        if (splashBtn) {
                            splashBtn.style.display = 'inline-flex';
                            splashBtn.innerText = `⏭️ Next: Show Round ${nextR.round_number} Briefing on TV`;
                        }
                        if (btnNextQ) btnNextQ.innerText = `⏭️ Round ${nextR.round_number} Info`;
                        if (dockBtnNext) dockBtnNext.innerText = `⏭️ R${nextR.round_number} Info`;
                    } else {
                        if (splashSub) splashSub.innerText = '🏆 Final Championship Round Complete! Congratulations to the winners!';
                        if (splashStats) splashStats.innerHTML = '';
                        if (splashMeta) splashMeta.innerHTML = '';
                        if (splashBtn) splashBtn.style.display = 'none';
                    }
                } else if (showStatus === 'setup') {
                    // Stage 1: TV Screen is displaying Welcome Splash Screen
                    document.getElementById('cat-badge').innerText = 'TV: Splash Screen';
                    document.getElementById('cat-badge').style.background = 'var(--accent)';
                    if (splashIcon) splashIcon.innerText = '📺';
                    if (splashBadge) {
                        splashBadge.innerText = '📺 TV SCREEN IS SHOWING: SPLASH SCREEN';
                        splashBadge.style.borderColor = 'var(--accent)';
                        splashBadge.style.color = 'var(--accent)';
                    }
                    if (splashTitle) splashTitle.innerText = 'Welcome Splash Screen is Live on TV';
                    if (splashSub) splashSub.innerText = 'TV screen is displaying the Khapre Party splash screen (teams hidden). Click Next to introduce the competing teams 1-by-1!';
                    if (splashPreviewWrap) splashPreviewWrap.style.display = 'block';
                    if (splashStats) splashStats.innerHTML = '';
                    if (splashMeta) splashMeta.innerHTML = '';
                    if (splashBtn) {
                        splashBtn.style.display = 'inline-flex';
                        splashBtn.innerText = '👥 Next: Introduce Team 1 on TV';
                    }
                    if (btnNextQ) btnNextQ.innerText = '👥 Intro Teams';
                    if (dockBtnNext) dockBtnNext.innerText = '👥 Teams';
                } else if (showStatus === 'teams_intro') {
                    // Stage 2: TV Screen is displaying Competing Teams 1-by-1 Spotlight
                    const allTeams = currentState.teams || [];
                    const rawTeamIdx = (show.active_team_index !== undefined && show.active_team_index !== null) ? parseInt(show.active_team_index, 10) : 0;
                    const safeTeamIdx = (rawTeamIdx >= 0 && rawTeamIdx < allTeams.length) ? rawTeamIdx : 0;
                    const currTeam = allTeams[safeTeamIdx];
                    const isLastTeam = (safeTeamIdx >= allTeams.length - 1);

                    document.getElementById('cat-badge').innerText = `TV: Team ${safeTeamIdx + 1}/${allTeams.length}`;
                    document.getElementById('cat-badge').style.background = 'var(--primary)';
                    if (splashPreviewWrap) splashPreviewWrap.style.display = 'none';
                    if (splashIcon) splashIcon.innerText = currTeam ? (currTeam.avatar_emoji || '🍁') : '👥';
                    if (splashBadge) {
                        splashBadge.innerText = `📺 TV SPOTLIGHT: TEAM ${safeTeamIdx + 1} OF ${allTeams.length} • ${safeTeamIdx + 1}/${allTeams.length} SEATED IN SIDEBAR`;
                        splashBadge.style.borderColor = 'var(--primary)';
                        splashBadge.style.color = 'var(--primary)';
                    }
                    if (splashTitle) {
                        splashTitle.innerText = currTeam ? `${currTeam.name}` : `Introducing Team ${safeTeamIdx + 1}`;
                    }
                    if (splashSub) {
                        const membersLine = (currTeam && currTeam.members) ? `💑 ${currTeam.members} — ` : '';
                        splashSub.innerText = `${membersLine}Now on stage & seated on the TV scoreboard! Click Next to introduce the next team.`;
                    }
                    if (splashStats) splashStats.innerHTML = '';
                    if (splashMeta) {
                        splashMeta.innerHTML = allTeams.map((t, idx) => {
                            const isSeated = idx <= safeTeamIdx;
                            const isCurrent = idx === safeTeamIdx;
                            const bg = isCurrent
                                ? 'rgba(249, 115, 22, 0.28)'
                                : (isSeated ? 'rgba(16, 185, 129, 0.16)' : 'rgba(255, 255, 255, 0.04)');
                            const border = isCurrent
                                ? '1.5px solid var(--accent)'
                                : (isSeated ? '1px solid rgba(16, 185, 129, 0.45)' : '1px dashed rgba(255, 255, 255, 0.15)');
                            const statusIcon = isCurrent ? '🎤🪑' : (isSeated ? '🪑' : '⏳');
                            return `<span style="display:inline-block; background:${bg}; border:${border}; border-radius:999px; padding:0.22rem 0.65rem; margin:0.15rem; color:${isCurrent || isSeated ? '#f8fafc' : '#64748b'}; font-weight:700; font-size:0.76rem;">${statusIcon} #${idx + 1} ${t.name}</span>`;
                        }).join('');
                    }
                    if (splashPrevBtn) {
                        splashPrevBtn.style.display = 'inline-flex';
                        splashPrevBtn.disabled = (safeTeamIdx === 0);
                    }
                    if (splashSkipBtn) {
                        splashSkipBtn.style.display = 'inline-flex';
                    }
                    if (splashBtn) {
                        splashBtn.style.display = 'inline-flex';
                        splashBtn.innerText = isLastTeam
                            ? `📜 Next: Unveil Rules on TV ➡`
                            : `👥 Next Team (${safeTeamIdx + 2}/${allTeams.length}) ➡`;
                    }
                    if (btnNextQ) {
                        btnNextQ.innerText = isLastTeam ? '📜 Unveil Rules' : `👥 Team ${safeTeamIdx + 2}/${allTeams.length} ➡`;
                    }
                    if (dockBtnNext) {
                        dockBtnNext.innerText = isLastTeam ? '📜 Rules' : `👥 T${safeTeamIdx + 2}/${allTeams.length}`;
                    }
                } else if (round) {
                    // Stage 4: Round Briefing & Rules on TV (Waiting for explicit Start Round)
                    const rNum = round.round_number || 1;
                    document.getElementById('cat-badge').innerText = `TV: Round ${rNum} Briefing`;
                    document.getElementById('cat-badge').style.background = 'var(--primary)';
                    if (splashPreviewWrap) splashPreviewWrap.style.display = 'none';
                    if (splashIcon) splashIcon.innerText = '🍁';
                    if (splashBadge) {
                        splashBadge.innerText = `📺 TV SCREEN IS SHOWING: ROUND ${rNum} BRIEFING & RULES`;
                        splashBadge.style.borderColor = 'var(--primary)';
                        splashBadge.style.color = 'var(--primary)';
                    }
                    if (splashTitle) splashTitle.innerText = round.name;
                    if (splashSub) splashSub.innerText = buildDynamicRoundDescription(round);
                    if (splashStats) splashStats.innerHTML = renderArenaRoundStats(round);
                    if (splashMeta) splashMeta.innerHTML = renderArenaRoundMeta(round);
                    if (splashBtn) {
                        splashBtn.style.display = 'inline-flex';
                        splashBtn.innerText = `🚀 Start Round ${rNum}`;
                    }
                    if (btnNextQ) btnNextQ.innerText = `🚀 Start Round ${rNum}`;
                    if (dockBtnNext) dockBtnNext.innerText = `🚀 Start R${rNum}`;
                }
            }
        }

        // Scoreboard & Mobile Counts
        const teamsContainer = document.getElementById('teams-list');
        teamsContainer.innerHTML = '';
        const teamCount = currentState.teams.length;
        document.getElementById('mobile-team-count').innerText = teamCount;

        const nowMs = Date.now();
        currentState.teams.forEach(t => {
            const recentChange = (recentArenaScoreChanges[t.id] && recentArenaScoreChanges[t.id].expiresAt > nowMs)
                ? recentArenaScoreChanges[t.id]
                : null;
            const pointsClass = recentChange
                ? (recentChange.delta > 0 ? ' points-gained' : ' points-lost')
                : '';
            const deltaBadgeHtml = recentChange
                ? `<span class="arena-score-delta-badge ${recentChange.delta > 0 ? 'plus' : 'minus'}">${recentChange.delta > 0 ? '+' + recentChange.delta : recentChange.delta}</span>`
                : '';

            const div = document.createElement('div');
            div.className = 'team-row ' + (t.is_eliminated == 1 ? 'eliminated' : '') + pointsClass;
            div.innerHTML = `
                <div style="display:flex; align-items:center; gap:0.6rem; min-width:0; flex:1; cursor:pointer;" onclick="openQuickAward(${t.id})" title="Click to award points">
                    <span style="font-size:1.5rem;">${t.avatar_emoji || '🍁'}</span>
                    <div style="min-width:0; overflow:hidden;">
                        <strong style="font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">${t.name}</strong>
                        <div style="font-size:0.75rem; color:var(--text-muted);">${t.score} pts${deltaBadgeHtml}${t.members ? ' • ' + t.members : ''}</div>
                    </div>
                </div>
                <div class="team-score-ctrl">
                    <button class="score-btn" style="background:rgba(16,185,129,0.2); color:#10b981; border-color:#10b981;" onclick="awardPoints(${t.id}, ${roundPts})" title="Award Round Points">+${roundPts}</button>
                    <button class="score-btn" style="background:rgba(245,158,11,0.2); color:var(--accent); border-color:var(--accent);" onclick="awardPoints(${t.id}, ${stealPts})" title="Steal Points">+${stealPts}</button>
                    <button class="score-btn" style="background:rgba(239,68,68,0.2); color:var(--danger); border-color:var(--danger);" onclick="awardPoints(${t.id}, -5)" title="Deduct Points">-5</button>
                </div>
            `;
            teamsContainer.appendChild(div);
        });

        // Round Selector
        const rSelect = document.getElementById('round-select');
        rSelect.innerHTML = '';
        currentState.rounds.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.id;
            opt.innerText = r.name;
            if (show.current_round_id == r.id) opt.selected = true;
            rSelect.appendChild(opt);
        });

        const rProgSummary = currentState.round_progress || {};
        if (rProgSummary.total > 0) {
            document.getElementById('q-counter').innerText = `Round Q: ${rProgSummary.used}/${rProgSummary.total} • Total: ${currentState.used_questions_count}`;
        } else {
            document.getElementById('q-counter').innerText = 'Asked: ' + currentState.used_questions_count;
        }

        const prevBtn = document.getElementById('btn-prev-q');
        const dockPrevBtn = document.getElementById('dock-btn-prev');
        const hasUsed = (currentState.used_questions_count && currentState.used_questions_count > 0);
        if (prevBtn) prevBtn.disabled = !hasUsed;
        if (dockPrevBtn) dockPrevBtn.disabled = !hasUsed;

        // Timer Sync (Hide timer on splash / non-question screens)
        const arenaTimerBar = document.getElementById('arena-timer-bar');
        const arenaTimerLabel = document.getElementById('arena-timer-label');
        const arenaTimerBox = document.getElementById('timer-box');
        if (q) {
            if (arenaTimerBar) arenaTimerBar.style.display = 'flex';
            if (arenaTimerLabel) arenaTimerLabel.style.display = '';
            if (arenaTimerBox) arenaTimerBox.style.display = '';
        } else {
            if (arenaTimerBar) arenaTimerBar.style.display = 'none';
            if (arenaTimerLabel) arenaTimerLabel.style.display = 'none';
            if (arenaTimerBox) arenaTimerBox.style.display = 'none';
        }

        if (show.question_started_at && show.answer_revealed == 0 && q) {
            startClientTimer(parseInt(show.question_started_at, 10), parseInt(show.timer_duration, 10) || 25);
        } else {
            clearInterval(timerInterval);
            timerInterval = null;
            activeArenaTimerStamp = null;
            document.getElementById('timer-box').innerText = show.timer_duration || 25;
            document.getElementById('timer-box').classList.remove('danger');
        }
    }

    function startClientTimer(startedAt, duration) {
        const elapsed = Math.floor(Date.now() / 1000) - startedAt;
        remainingSeconds = Math.max(0, (duration || 25) - elapsed);
        updateTimerDisplay();

        if (activeArenaTimerStamp === startedAt && timerInterval) {
            return;
        }

        activeArenaTimerStamp = startedAt;
        clearInterval(timerInterval);

        timerInterval = setInterval(() => {
            if (isPaused) return;
            const nowElapsed = Math.floor(Date.now() / 1000) - startedAt;
            const nextRem = Math.max(0, (duration || 25) - nowElapsed);

            if (nextRem !== remainingSeconds) {
                remainingSeconds = nextRem;
                updateTimerDisplay();

                if (remainingSeconds > 0 && remainingSeconds <= 5 && window.soundFX) {
                    window.soundFX.playWarningTick();
                }

                if (remainingSeconds === 0) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    document.getElementById('timer-box').classList.add('danger');
                    document.getElementById('time-up-banner').style.display = 'block';
                    if (arenaBuzzerPlayedForStamp !== startedAt && window.soundFX) {
                        arenaBuzzerPlayedForStamp = startedAt;
                        window.soundFX.playTimeUpBuzzer();
                    }
                }
            }
        }, 250);
    }

    function updateTimerDisplay() {
        const box = document.getElementById('timer-box');
        box.innerText = remainingSeconds;
        if (remainingSeconds <= 5) {
            box.classList.add('danger');
        } else {
            box.classList.remove('danger');
            document.getElementById('time-up-banner').style.display = 'none';
        }
    }

    function toggleTimer() {
        isPaused = !isPaused;
        const desktopPauseBtn = document.getElementById('btn-pause');
        const dockPauseBtn = document.getElementById('dock-btn-pause');
        if (desktopPauseBtn) {
            desktopPauseBtn.innerText = isPaused ? '▶️ Resume' : '⏸️ Pause';
        }
        if (dockPauseBtn) {
            dockPauseBtn.innerText = isPaused ? '▶️' : '⏸️';
        }
        showToast(isPaused ? '⏸️ Timer Paused' : '▶️ Timer Resumed');
    }

    function hostNextStep() {
        triggerAction('host_next');
    }

    function triggerAction(actionName) {
        if (window.soundFX) {
            window.soundFX.init();
        }
        if (actionName === 'reveal_answer' && window.soundFX) {
            window.soundFX.playDingCorrect();
        }

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: actionName })
        })
        .then(res => res.json())
        .then(data => {
            if (data && data.stage === 'teams_intro') {
                if (window.soundFX) window.soundFX.playTeamUnveil();
                const tIdx = (data.active_team_index !== undefined) ? parseInt(data.active_team_index, 10) : 0;
                const tObj = (currentState?.teams || [])[tIdx];
                showToast(tObj ? `🎤 Spotlight: #${tIdx + 1} ${tObj.name} on TV!` : `🎤 Introducing Team #${tIdx + 1} on TV!`);
            } else if (data && data.stage === 'rules_intro') {
                if (window.soundFX) window.soundFX.playRuleWhoosh();
                if (data.active_rule_index === 0) {
                    showToast('📜 Unveiling Tournament Rules on TV!');
                }
            } else if (data && data.stage === 'sample_puzzle') {
                if (window.soundFX) window.soundFX.playRoundStartHorn();
                showToast('🎯 Sample Tryout Puzzle ("FALL PARTY") Live on TV!');
            } else if (data && data.stage === 'round_intro') {
                if (window.soundFX) window.soundFX.playFanfare();
                showToast('🍁 Round Briefing & Rules Live on TV!');
            } else if (data && data.round_completed) {
                if (window.soundFX) window.soundFX.playFanfare();
                showToast(`🏁 End of Round ${data.round_number || ''}!`);
            } else if (data && data.round_intro) {
                if (window.soundFX) window.soundFX.playFanfare();
                showToast(`🚀 Up Next: ${data.round_name || 'Next Round'}`);
            } else if (data && data.question_id && !currentState?.current_question) {
                if (window.soundFX) window.soundFX.playRoundStartHorn();
                showToast('🚀 Round Started — Let\'s Play!');
            } else if (data && (data.question || data.question_id)) {
                if (window.soundFX) window.soundFX.playTick();
            }
            fetchState();
        });
    }

    function showToast(msg) {
        let toast = document.getElementById('arena-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'arena-toast';
            toast.style.cssText = 'position:fixed; top:20px; left:50%; transform:translateX(-50%); background:rgba(16,185,129,0.95); color:#000; padding:0.75rem 1.75rem; border-radius:12px; font-weight:800; font-size:1.05rem; box-shadow:0 10px 30px rgba(0,0,0,0.7); z-index:9999; display:none; animation:slideDown 0.25s ease-out;';
            document.body.appendChild(toast);
        }
        toast.innerText = msg;
        toast.style.display = 'block';
        clearTimeout(toast._timeout);
        toast._timeout = setTimeout(() => {
            toast.style.display = 'none';
        }, 1800);
    }

    function awardPoints(teamId, pts) {
        if (window.soundFX) {
            window.soundFX.init();
            if (pts > 0) {
                window.soundFX.playPointsAwarded();
            } else if (pts < 0) {
                window.soundFX.playPointsPenalty();
            }
        }

        recentArenaScoreChanges[teamId] = {
            delta: pts,
            expiresAt: Date.now() + 2000
        };

        const team = currentState?.teams?.find(t => t.id == teamId);
        const teamName = team ? team.name : 'Team';
        showToast(`${pts > 0 ? '🏆 +' : '⚠️ '}${pts} pts awarded to ${teamName}!`);

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'award_points', team_id: teamId, points: pts })
        }).then(() => fetchState());
    }

    window.addEventListener('resize', () => setArenaMobileTab(activeMobileView));

    function advanceToNextRound() {
        if (!confirm('End current round and advance to the next? If this round has elimination rules, bottom teams will be eliminated.')) return;
        
        const currentRoundIdx = currentState.rounds.findIndex(r => r.id == currentState.show.current_round_id);
        const nextRound = currentState.rounds[currentRoundIdx + 1];
        if (!nextRound) {
            window.soundFX.playFanfare();
            alert('🏆 That was the final championship round! Congratulations to the Grand Champions!');
            return;
        }

        window.soundFX.playFanfare();

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'advance_round',
                next_round_id: nextRound.id,
                apply_eliminations: true
            })
        }).then(() => fetchState());
    }

    function changeRound(roundId) {
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'advance_round', next_round_id: roundId, apply_eliminations: false })
        }).then(() => fetchState());
    }

    function resetShowConfirm() {
        if (!confirm('Reset Game Show? This resets all team scores to 0 and returns the show state to the Welcome Splash Screen / Round 1 (keeping your selected round questions & order intact).')) return;
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset_show' })
        }).then(() => {
            showToast('🔄 Game Show scores & state reset!');
            fetchState();
        });
    }

    function resetQuestionsConfirm() {
        if (!confirm('Reset Questions? This chooses a new random set of puzzles across all rounds without resetting round settings, team scores, or game show state.')) return;
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset_questions' })
        }).then(() => {
            showToast('🎲 Round questions randomized!');
            fetchState();
        });
    }

    function finishRulesAndPlay() {
        triggerAction('finish_rules');
    }

    // Keyboard Shortcuts for Host!
    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;

        const activeRuleIdx = (currentState?.show?.active_rule_index !== undefined && currentState?.show?.active_rule_index !== null) ? parseInt(currentState.show.active_rule_index) : -1;
        if (activeRuleIdx >= 0) {
            if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') {
                e.preventDefault();
                triggerAction('next_rule');
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                triggerAction('prev_rule');
            } else if (e.key === 'Escape') {
                e.preventDefault();
                triggerAction('close_rules');
            }
            return;
        }

        if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            if (currentState?.current_question) {
                triggerAction('reveal_answer');
            } else {
                hostNextStep();
            }
        } else if (e.key === 'ArrowRight' || e.key === 'n') {
            hostNextStep();
        } else if (e.key === 'ArrowLeft') {
            if (currentState?.show?.status === 'teams_intro' && !currentState?.current_question) {
                triggerAction('prev_team');
            } else {
                triggerAction('prev_question');
            }
        } else if (e.key === 'p') {
            toggleTimer();
        }
    });

    fetchState();
    setInterval(fetchState, 2500);
</script>
{% endblock %}
