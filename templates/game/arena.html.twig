{% extends 'base.html.twig' %}

{% block title %}Host Arena | {{ show.name }}{% endblock %}

{% block stylesheets %}
<style>
    .arena-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1.5rem;
        height: calc(100vh - 140px);
    }

    .main-stage {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    .stage-top-bar {
        padding: 1rem 1.5rem;
        background: rgba(0, 0, 0, 0.4);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .round-indicator {
        font-weight: 800;
        font-size: 1.1rem;
        color: var(--primary);
    }

    .timer-display {
        font-family: 'Bungee', monospace;
        font-size: 2.5rem;
        color: var(--accent);
        min-width: 90px;
        text-align: center;
        line-height: 1;
    }
    .timer-display.danger {
        color: var(--danger);
        animation: pulse 0.6s infinite alternate;
    }

    @keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    .puzzle-viewport {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
        background: radial-gradient(circle at center, #1e1814 0%, #0d0b09 100%);
    }

    .puzzle-img-wrap {
        max-width: 90%;
        max-height: 58vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .puzzle-img {
        max-width: 100%;
        max-height: 56vh;
        border-radius: 14px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
        object-fit: contain;
    }

    .answer-banner {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(16, 185, 129, 0.95);
        color: #000;
        padding: 0.9rem 2.5rem;
        border-radius: 14px;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.5);
        display: none;
        animation: slideUp 0.3s ease-out;
    }

    .time-up-banner {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(239, 68, 68, 0.95);
        color: #fff;
        padding: 0.5rem 2rem;
        border-radius: 10px;
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.6);
        display: none;
        animation: slideDown 0.3s ease-out;
    }

    @keyframes slideUp {
        from { transform: translate(-50%, 20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }
    @keyframes slideDown {
        from { transform: translate(-50%, -20px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }

    .stage-controls {
        padding: 1rem 1.5rem;
        background: rgba(0, 0, 0, 0.5);
        border-top: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    /* Sidebar Scoreboard */
    .scoreboard-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .panel-header {
        padding: 1rem 1.25rem;
        background: rgba(0, 0, 0, 0.4);
        border-bottom: 1px solid var(--border-color);
        font-weight: 800;
        font-size: 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .teams-list-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .team-row {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
    }
    .team-row.eliminated {
        opacity: 0.4;
        filter: grayscale(1);
    }

    .team-score-ctrl {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .score-btn {
        background: rgba(249, 115, 22, 0.2);
        color: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 6px;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
    }
    .score-btn:hover {
        background: var(--primary);
        color: #000;
    }
</style>
{% endblock %}

{% block body %}
<div class="arena-layout">
    <!-- MAIN STAGE -->
    <div class="main-stage">
        <div class="stage-top-bar">
            <div>
                <span class="badge" id="cat-badge" style="background: var(--primary); color: #000;">Loading...</span>
                <span class="round-indicator" id="round-indicator" style="margin-left: 0.5rem;">Round 1</span>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button type="button" class="btn btn-secondary btn-sm" id="btn-sound" onclick="toggleSound()">🔊 Sound ON</button>
                <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">TIME:</span>
                <div class="timer-display" id="timer-box">25</div>
            </div>
        </div>

        <div class="puzzle-viewport" id="viewport">
            <div class="time-up-banner" id="time-up-banner">⏰ TIME IS UP!</div>

            <div class="puzzle-img-wrap" id="img-wrap">
                <img src="" alt="Rebus Puzzle" class="puzzle-img" id="puzzle-image" style="display: none;">
                <div id="no-question-splash" style="text-align: center; color: var(--text-muted);">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">🍁</div>
                    <h2>Ready to Play!</h2>
                    <p style="margin-top: 0.5rem;">Click "Next Question" to start the round timer.</p>
                </div>
            </div>

            <div class="answer-banner" id="answer-banner">
                <span id="answer-text">ANSWER GOES HERE</span>
            </div>
        </div>

        <div class="stage-controls">
            <div style="display: flex; gap: 0.5rem;">
                <button type="button" class="btn btn-primary" id="btn-next-q" onclick="triggerAction('start_question')">
                    ▶️ Next Question
                </button>
                <button type="button" class="btn btn-success" id="btn-reveal" onclick="triggerAction('reveal_answer')">
                    💡 Reveal Answer
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleTimer()">
                    ⏸️ Pause / Resume
                </button>
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <select id="round-select" class="form-select-sm" onchange="changeRound(this.value)">
                    <!-- Loaded dynamically -->
                </select>
                <button type="button" class="btn btn-danger btn-sm" onclick="advanceToNextRound()">
                    ⏭️ End Round
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="resetShowConfirm()" title="Reset game show to Round 1 and zero scores" style="border-color: rgba(245, 158, 11, 0.4); color: #f59e0b;">
                    🔄 Reset Show
                </button>
            </div>
        </div>
    </div>

    <!-- SIDEBAR: LIVE SCOREBOARD & POINTS AWARD -->
    <div class="scoreboard-panel">
        <div class="panel-header">
            <span>🏆 Scoreboard</span>
            <span style="font-size: 0.8rem; color: var(--text-muted);" id="q-counter">Asked: 0</span>
        </div>

        <div class="teams-list-scroll" id="teams-list">
            <!-- Dynamically populated -->
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="/js/sounds.js"></script>
<script>
    const SHOW_ID = {{ show.id }};
    let currentState = null;
    let timerInterval = null;
    let remainingSeconds = 25;
    let isPaused = false;
    let soundEnabled = true;

    function toggleSound() {
        soundEnabled = !soundEnabled;
        window.soundFX.enabled = soundEnabled;
        document.getElementById('btn-sound').innerText = soundEnabled ? '🔊 Sound ON' : '🔇 Muted';
    }

    function fetchState() {
        fetch(`/api/shows/${SHOW_ID}/state`)
            .then(res => res.json())
            .then(data => {
                currentState = data;
                renderUI();
            });
    }

    function renderUI() {
        if (!currentState) return;
        const show = currentState.show;
        const q = currentState.current_question;
        const round = currentState.current_round;

        // Round indicator
        if (round) {
            document.getElementById('round-indicator').innerText = round.name;
        }

        // Question display
        if (q) {
            document.getElementById('no-question-splash').style.display = 'none';
            const img = document.getElementById('puzzle-image');
            img.src = q.media_path;
            img.style.display = 'block';

            const badge = document.getElementById('cat-badge');
            badge.innerText = q.category_name + ' • ' + q.difficulty;
            badge.style.background = q.category_color || 'var(--primary)';

            document.getElementById('answer-text').innerText = q.answer;
            if (show.answer_revealed == 1) {
                document.getElementById('answer-banner').style.display = 'block';
                document.getElementById('time-up-banner').style.display = 'none';
            } else {
                document.getElementById('answer-banner').style.display = 'none';
            }
        } else {
            document.getElementById('no-question-splash').style.display = 'block';
            document.getElementById('puzzle-image').style.display = 'none';
            document.getElementById('answer-banner').style.display = 'none';
            document.getElementById('time-up-banner').style.display = 'none';
            document.getElementById('cat-badge').innerText = 'Ready';
        }

        // Scoreboard
        const teamsContainer = document.getElementById('teams-list');
        teamsContainer.innerHTML = '';
        currentState.teams.forEach(t => {
            const div = document.createElement('div');
            div.className = 'team-row ' + (t.is_eliminated == 1 ? 'eliminated' : '');
            div.innerHTML = `
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <span>${t.avatar_emoji}</span>
                    <div>
                        <strong style="font-size:0.95rem;">${t.name}</strong>
                        <div style="font-size:0.75rem; color:var(--text-muted);">${t.score} pts</div>
                    </div>
                </div>
                <div class="team-score-ctrl">
                    <button class="score-btn" onclick="awardPoints(${t.id}, ${round ? round.points_per_question : 10})" title="Award Points">+${round ? round.points_per_question : 10}</button>
                    <button class="score-btn" style="background:rgba(239,68,68,0.2); color:var(--danger); border-color:var(--danger);" onclick="awardPoints(${t.id}, -5)" title="Deduct">-5</button>
                </div>
            `;
            teamsContainer.appendChild(div);
        });

        // Round Selector
        const rSelect = document.getElementById('round-select');
        rSelect.innerHTML = '';
        currentState.rounds.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.id;
            opt.innerText = r.name;
            if (show.current_round_id == r.id) opt.selected = true;
            rSelect.appendChild(opt);
        });

        document.getElementById('q-counter').innerText = 'Asked: ' + currentState.used_questions_count;

        // Timer Sync
        if (show.question_started_at && show.answer_revealed == 0) {
            const elapsed = Math.floor(Date.now() / 1000) - show.question_started_at;
            remainingSeconds = Math.max(0, (show.timer_duration || 25) - elapsed);
            startClientTimer();
        } else {
            clearInterval(timerInterval);
            document.getElementById('timer-box').innerText = show.timer_duration || 25;
            document.getElementById('timer-box').classList.remove('danger');
        }
    }

    function startClientTimer() {
        clearInterval(timerInterval);
        updateTimerDisplay();
        timerInterval = setInterval(() => {
            if (!isPaused && remainingSeconds > 0) {
                remainingSeconds--;
                updateTimerDisplay();

                if (remainingSeconds > 0 && remainingSeconds <= 5) {
                    window.soundFX.playWarningTick();
                }

                if (remainingSeconds === 0) {
                    clearInterval(timerInterval);
                    document.getElementById('timer-box').classList.add('danger');
                    document.getElementById('time-up-banner').style.display = 'block';
                    window.soundFX.playTimeUpBuzzer();
                }
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        const box = document.getElementById('timer-box');
        box.innerText = remainingSeconds;
        if (remainingSeconds <= 5) {
            box.classList.add('danger');
        } else {
            box.classList.remove('danger');
            document.getElementById('time-up-banner').style.display = 'none';
        }
    }

    function toggleTimer() {
        isPaused = !isPaused;
    }

    function triggerAction(actionName) {
        if (actionName === 'reveal_answer') {
            window.soundFX.playDingCorrect();
        }

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: actionName })
        }).then(() => fetchState());
    }

    function awardPoints(teamId, pts) {
        if (pts > 0) {
            window.soundFX.playDingCorrect();
        }

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'award_points', team_id: teamId, points: pts })
        }).then(() => fetchState());
    }

    function advanceToNextRound() {
        if (!confirm('End current round and advance to the next? If this round has elimination rules, bottom teams will be eliminated.')) return;
        
        const currentRoundIdx = currentState.rounds.findIndex(r => r.id == currentState.show.current_round_id);
        const nextRound = currentState.rounds[currentRoundIdx + 1];
        if (!nextRound) {
            window.soundFX.playFanfare();
            alert('🏆 That was the final championship round! Congratulations to the Grand Champions!');
            return;
        }

        window.soundFX.playFanfare();

        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'advance_round',
                next_round_id: nextRound.id,
                apply_eliminations: true
            })
        }).then(() => fetchState());
    }

    function changeRound(roundId) {
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'advance_round', next_round_id: roundId, apply_eliminations: false })
        }).then(() => fetchState());
    }

    function resetShowConfirm() {
        if (!confirm('Are you sure you want to refresh this game show? This will reset all team scores to 0, clear question history, and restart from Round 1.')) return;
        fetch(`/api/shows/${SHOW_ID}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset_show' })
        }).then(() => fetchState());
    }

    // Keyboard Shortcuts for Host!
    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
        if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            triggerAction('reveal_answer');
        } else if (e.key === 'ArrowRight' || e.key === 'n') {
            triggerAction('start_question');
        } else if (e.key === 'p') {
            toggleTimer();
        }
    });

    fetchState();
    setInterval(fetchState, 2500);
</script>
{% endblock %}
